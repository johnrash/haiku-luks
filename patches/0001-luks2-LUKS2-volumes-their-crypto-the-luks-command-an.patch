+/*!	Base64, the anti-forensic split and the keyslot KDFs. */
+
+
+#include "luks2_internal.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+
+static const char kBase64Alphabet[]
+	= "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+
+static int
+base64_value(char c)
+{
+	if (c >= 'A' && c <= 'Z')
+		return c - 'A';
+	if (c >= 'a' && c <= 'z')
+		return c - 'a' + 26;
+	if (c >= '0' && c <= '9')
+		return c - '0' + 52;
+	if (c == '+')
+		return 62;
+	if (c == '/')
+		return 63;
+	return -1;
+}
+
+
+ssize_t
+luks2_base64_decode(const char* text, uint8_t* output, size_t outputSize)
+{
+	size_t length = 0;
+	uint32_t accumulator = 0;
+	int bits = 0;
+	bool padding = false;
+
+	for (const char* c = text; *c != '\0'; c++) {
+		if (*c == '=') {
+			padding = true;
+			continue;
+		}
+		int value = base64_value(*c);
+		if (value < 0 || padding)
+			return -1;
+		accumulator = (accumulator << 6) | (uint32_t)value;
+		bits += 6;
+		if (bits >= 8) {
+			bits -= 8;
+			if (length >= outputSize)
+				return -1;
+			output[length++] = (uint8_t)(accumulator >> bits);
+		}
+	}
+
+	// leftover bits must be zero (canonical encoding)
+	if (bits >= 6 || (accumulator & ((1u << bits) - 1)) != 0)
+		return -1;
+	return (ssize_t)length;
+}
+
+
+void
+luks2_base64_encode(const uint8_t* data, size_t length, char* output)
+{
+	size_t i = 0;
+	for (; i + 3 <= length; i += 3) {
+		uint32_t value = ((uint32_t)data[i] << 16) | ((uint32_t)data[i + 1] << 8)
+			| data[i + 2];
+		*output++ = kBase64Alphabet[(value >> 18) & 0x3f];
+		*output++ = kBase64Alphabet[(value >> 12) & 0x3f];
+		*output++ = kBase64Alphabet[(value >> 6) & 0x3f];
+		*output++ = kBase64Alphabet[value & 0x3f];
+	}
+	if (length - i == 1) {
+		uint32_t value = (uint32_t)data[i] << 16;
+		*output++ = kBase64Alphabet[(value >> 18) & 0x3f];
+		*output++ = kBase64Alphabet[(value >> 12) & 0x3f];
+		*output++ = '=';
+		*output++ = '=';
+	} else if (length - i == 2) {
+		uint32_t value = ((uint32_t)data[i] << 16) | ((uint32_t)data[i + 1] << 8);
+		*output++ = kBase64Alphabet[(value >> 18) & 0x3f];
+		*output++ = kBase64Alphabet[(value >> 12) & 0x3f];
+		*output++ = kBase64Alphabet[(value >> 6) & 0x3f];
+		*output++ = '=';
+	}
+	*output = '\0';
+}
+
+
+// #pragma mark - anti-forensic split
+
+
+/*!	The diffusion of the "luks1" AF: each digest-sized block i of the buffer
+	is replaced by hash(be32(i) || block); a short last block by the start
+	of its hash. */
+static void
+af_diffuse(uint8_t* buffer, size_t size, int hash)
+{
+	size_t digestSize = luks2_hash_digest_size(hash);
+	uint8_t digest[LUKS2_MAX_DIGEST_SIZE];
+	uint32_t index = 0;
+
+	for (size_t offset = 0; offset < size; offset += digestSize, index++) {
+		size_t blockSize = size - offset < digestSize ? size - offset
+			: digestSize;
+		uint8_t indexBytes[4];
+		luks2_store32be(indexBytes, index);
+
+		luks2_hash context;
+		luks2_hash_init(&context, hash);
+		luks2_hash_update(&context, indexBytes, 4);
+		luks2_hash_update(&context, buffer + offset, blockSize);
+		luks2_hash_final(&context, digest);
+		memcpy(buffer + offset, digest, blockSize);
+	}
+	luks2_wipe(digest, sizeof(digest));
+}
+
+
+void
+luks2_af_merge(const uint8_t* material, size_t keySize, uint32_t stripes,
+	int hash, uint8_t* key)
+{
+	uint8_t d[LUKS2_MAX_KEY_SIZE];
+	memset(d, 0, keySize);
+
+	for (uint32_t i = 0; i + 1 < stripes; i++) {
+		for (size_t j = 0; j < keySize; j++)
+			d[j] ^= material[i * keySize + j];
+		af_diffuse(d, keySize, hash);
+	}
+	for (size_t j = 0; j < keySize; j++)
+		key[j] = d[j] ^ material[(size_t)(stripes - 1) * keySize + j];
+	luks2_wipe(d, sizeof(d));
+}
+
+
+// #pragma mark - KDF
+
+
+int
+luks2_derive_keyslot_key(const luks2_kdf* kdf, const void* passphrase,
+	size_t passphraseLength, uint8_t* output, size_t outputLength)
+{
+	switch (kdf->type) {
+		case LUKS2_KDF_PBKDF2:
+			if (luks2_pbkdf2(kdf->hash, passphrase, passphraseLength,
+					kdf->salt, kdf->salt_length, kdf->iterations, output,
+					outputLength) != 0) {
+				return LUKS2_ERROR_UNSUPPORTED;
+			}
+			return LUKS2_OK;
+
+		case LUKS2_KDF_ARGON2I:
+		case LUKS2_KDF_ARGON2ID:
+		{
+			int result = luks2_argon2(kdf->type == LUKS2_KDF_ARGON2I
+					? LUKS2_ARGON2I : LUKS2_ARGON2ID, kdf->time, kdf->memory,
+				kdf->cpus, passphrase, passphraseLength, kdf->salt,
+				kdf->salt_length, NULL, 0, NULL, 0, output, outputLength);
+			if (result == LUKS2_ARGON2_NO_MEMORY)
+				return LUKS2_ERROR_KDF_MEMORY;
+			if (result != LUKS2_ARGON2_OK)
+				return LUKS2_ERROR_UNSUPPORTED;
+			return LUKS2_OK;
+		}
+	}
+	return LUKS2_ERROR_UNSUPPORTED;
+}
+
+
+extern "C" const char*
+luks2_error_string(int error)
+{
+	switch (error) {
+		case LUKS2_OK:
+			return "no error";
+		case LUKS2_ERROR_IO:
+			return "I/O error";
+		case LUKS2_ERROR_NOT_LUKS2:
+			return "not a LUKS2 volume";
+		case LUKS2_ERROR_CORRUPT:
+			return "damaged LUKS2 header or metadata";
+		case LUKS2_ERROR_UNSUPPORTED:
+			return "uses a LUKS2 feature this implementation doesn't support";
+		case LUKS2_ERROR_NO_MEMORY:
+			return "out of memory";
+		case LUKS2_ERROR_BAD_PASSPHRASE:
+			return "no keyslot could be opened with this passphrase";
+		case LUKS2_ERROR_BAD_KEY:
+			return "the volume key doesn't match the header";
+		case LUKS2_ERROR_NO_KEYSLOT:
+			return "no free keyslot, or no room in the keyslot area";
+		case LUKS2_ERROR_BAD_ARGUMENT:
+			return "invalid argument";
+		case LUKS2_ERROR_KDF_MEMORY:
+			return "not enough memory for the keyslot's key derivation";
+		case LUKS2_ERROR_RANDOM:
+			return "no random numbers";
+		case LUKS2_ERROR_READ_ONLY:
+			return "the device is read-only";
+	}
+	return "unknown error";
+}
