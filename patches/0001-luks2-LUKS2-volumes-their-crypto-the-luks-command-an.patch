+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	JSON (RFC 8259) for the LUKS2 metadata. See luks2_json.h. */
+
+
+#include <luks2/luks2_json.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+
+namespace {
+
+
+struct Parser {
+	const char*	text;
+	size_t		length;
+	size_t		position;
+
+	bool AtEnd() const { return position >= length; }
+	char Peek() const { return AtEnd() ? '\0' : text[position]; }
+
+	void SkipWhitespace()
+	{
+		while (!AtEnd()) {
+			char c = text[position];
+			if (c != ' ' && c != '\t' && c != '\n' && c != '\r')
+				break;
+			position++;
+		}
+	}
+
+	bool Expect(const char* word)
+	{
+		size_t wordLength = strlen(word);
+		if (length - position < wordLength
+			|| memcmp(text + position, word, wordLength) != 0)
+			return false;
+		position += wordLength;
+		return true;
+	}
+};
+
+
+char*
+duplicate(const char* text, size_t length)
+{
+	char* copy = (char*)malloc(length + 1);
+	if (copy == NULL)
+		return NULL;
+	memcpy(copy, text, length);
+	copy[length] = '\0';
+	return copy;
+}
+
+
+luks2_json*
+new_node(luks2_json_type type)
+{
+	luks2_json* node = (luks2_json*)calloc(1, sizeof(luks2_json));
+	if (node != NULL)
+		node->type = type;
+	return node;
+}
+
+
+void
+add_child(luks2_json* parent, luks2_json* child)
+{
+	child->next = NULL;
+	if (parent->last != NULL)
+		parent->last->next = child;
+	else
+		parent->first = child;
+	parent->last = child;
+}
+
+
+int
+hex_value(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+
+bool
+parse_hex4(Parser& parser, uint32_t* _value)
+{
+	if (parser.length - parser.position < 4)
+		return false;
+	uint32_t value = 0;
+	for (int i = 0; i < 4; i++) {
+		int digit = hex_value(parser.text[parser.position + i]);
+		if (digit < 0)
+			return false;
+		value = (value << 4) | (uint32_t)digit;
+	}
+	parser.position += 4;
+	*_value = value;
+	return true;
+}
+
+
+size_t
+encode_utf8(uint32_t c, char* out)
+{
+	if (c < 0x80) {
+		out[0] = (char)c;
+		return 1;
+	}
+	if (c < 0x800) {
+		out[0] = (char)(0xc0 | (c >> 6));
+		out[1] = (char)(0x80 | (c & 0x3f));
+		return 2;
+	}
+	if (c < 0x10000) {
+		out[0] = (char)(0xe0 | (c >> 12));
+		out[1] = (char)(0x80 | ((c >> 6) & 0x3f));
+		out[2] = (char)(0x80 | (c & 0x3f));
+		return 3;
+	}
+	out[0] = (char)(0xf0 | (c >> 18));
+	out[1] = (char)(0x80 | ((c >> 12) & 0x3f));
+	out[2] = (char)(0x80 | ((c >> 6) & 0x3f));
+	out[3] = (char)(0x80 | (c & 0x3f));
+	return 4;
+}
+
+
+//! Parses a string starting at the opening quote. Returns a malloc()ed copy.
+char*
+parse_string(Parser& parser)
+{
+	if (parser.Peek() != '"')
+		return NULL;
+	parser.position++;
+
+	// the decoded string is never longer than its encoding
+	size_t start = parser.position;
+	size_t end = start;
+	while (end < parser.length && parser.text[end] != '"') {
+		if (parser.text[end] == '\\')
+			end++;
+		end++;
+	}
+	if (end >= parser.length)
+		return NULL;
+
+	char* result = (char*)malloc(end - start + 1);
+	if (result == NULL)
+		return NULL;
+
+	size_t length = 0;
+	while (parser.position < end) {
+		char c = parser.text[parser.position++];
+		if ((unsigned char)c < 0x20) {
+			free(result);
+			return NULL;
+		}
+		if (c != '\\') {
+			result[length++] = c;
+			continue;
+		}
+
+		c = parser.text[parser.position++];
+		switch (c) {
+			case '"':
+			case '\\':
+			case '/':
+				result[length++] = c;
+				break;
+			case 'b':
+				result[length++] = '\b';
+				break;
+			case 'f':
+				result[length++] = '\f';
+				break;
+			case 'n':
+				result[length++] = '\n';
+				break;
+			case 'r':
+				result[length++] = '\r';
+				break;
+			case 't':
+				result[length++] = '\t';
+				break;
+			case 'u':
+			{
+				uint32_t code;
+				if (!parse_hex4(parser, &code)) {
+					free(result);
+					return NULL;
+				}
+				if (code >= 0xd800 && code < 0xdc00) {
+					// a surrogate pair
+					uint32_t low;
+					if (!parser.Expect("\\u") || !parse_hex4(parser, &low)
+						|| low < 0xdc00 || low >= 0xe000) {
+						free(result);
+						return NULL;
+					}
+					code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
+				} else if (code >= 0xdc00 && code < 0xe000) {
+					free(result);
+					return NULL;
+				}
+				if (code == 0) {
+					// no NULs inside C strings
+					free(result);
+					return NULL;
+				}
+				// \uXXXX is 6 bytes, its UTF-8 at most 3; a pair is 12 and 4
+				length += encode_utf8(code, result + length);
+				break;
+			}
+			default:
+				free(result);
+				return NULL;
+		}
+	}
+	if (parser.position > end) {
+		// an escape ran past the closing quote
+		free(result);
+		return NULL;
+	}
+	parser.position = end + 1;
+	result[length] = '\0';
+	return result;
+}
+
+
+bool
+parse_number(Parser& parser, luks2_json* node)
+{
+	size_t start = parser.position;
+	if (parser.Peek() == '-')
+		parser.position++;
+	if (parser.Peek() == '0')
+		parser.position++;
+	else if (parser.Peek() >= '1' && parser.Peek() <= '9') {
+		while (parser.Peek() >= '0' && parser.Peek() <= '9')
+			parser.position++;
+	} else
+		return false;
+	if (parser.Peek() == '.') {
+		parser.position++;
+		if (!(parser.Peek() >= '0' && parser.Peek() <= '9'))
+			return false;
+		while (parser.Peek() >= '0' && parser.Peek() <= '9')
+			parser.position++;
+	}
+	if (parser.Peek() == 'e' || parser.Peek() == 'E') {
+		parser.position++;
+		if (parser.Peek() == '+' || parser.Peek() == '-')
+			parser.position++;
+		if (!(parser.Peek() >= '0' && parser.Peek() <= '9'))
+			return false;
+		while (parser.Peek() >= '0' && parser.Peek() <= '9')
+			parser.position++;
+	}
+	node->text = duplicate(parser.text + start, parser.position - start);
+	return node->text != NULL;
+}
+
+
+luks2_json* parse_value(Parser& parser, int depth);
+
+
+bool
+parse_members(Parser& parser, luks2_json* node, int depth, bool object)
+{
+	char close = object ? '}' : ']';
+	parser.position++;
+	parser.SkipWhitespace();
+	if (parser.Peek() == close) {
+		parser.position++;
+		return true;
+	}
+
+	while (true) {
+		char* key = NULL;
+		if (object) {
+			parser.SkipWhitespace();
+			key = parse_string(parser);
+			if (key == NULL)
+				return false;
+			parser.SkipWhitespace();
+			if (parser.Peek() != ':') {
+				free(key);
+				return false;
+			}
+			parser.position++;
+		}
+
+		luks2_json* child = parse_value(parser, depth + 1);
+		if (child == NULL) {
+			free(key);
+			return false;
+		}
+		child->key = key;
+		add_child(node, child);
+
+		parser.SkipWhitespace();
+		char c = parser.Peek();
+		parser.position++;
+		if (c == close)
+			return true;
+		if (c != ',')
+			return false;
+	}
+}
+
+
+luks2_json*
+parse_value(Parser& parser, int depth)
+{
+	if (depth > LUKS2_JSON_MAX_DEPTH)
+		return NULL;
+
+	parser.SkipWhitespace();
+	char c = parser.Peek();
+	luks2_json* node = NULL;
+
+	switch (c) {
+		case '{':
+		case '[':
+			node = new_node(c == '{' ? LUKS2_JSON_OBJECT : LUKS2_JSON_ARRAY);
+			if (node != NULL && !parse_members(parser, node, depth, c == '{')) {
+				luks2_json_free(node);
+				return NULL;
+			}
+			return node;
+
+		case '"':
+			node = new_node(LUKS2_JSON_STRING);
+			if (node != NULL && (node->text = parse_string(parser)) == NULL) {
+				luks2_json_free(node);
+				return NULL;
+			}
+			return node;
+
+		case 't':
+			if (!parser.Expect("true"))
+				return NULL;
+			return new_node(LUKS2_JSON_TRUE);
+		case 'f':
+			if (!parser.Expect("false"))
+				return NULL;
+			return new_node(LUKS2_JSON_FALSE);
+		case 'n':
+			if (!parser.Expect("null"))
+				return NULL;
+			return new_node(LUKS2_JSON_NULL);
+
+		default:
+			node = new_node(LUKS2_JSON_NUMBER);
+			if (node != NULL && !parse_number(parser, node)) {
+				luks2_json_free(node);
+				return NULL;
+			}
+			return node;
+	}
+}
+
+
+struct Writer {
+	char*	buffer;
+	size_t	size;
+	size_t	length;
+	bool	overflow;
+
+	void Add(const char* text, size_t textLength)
+	{
+		if (overflow || size - length <= textLength) {
+			overflow = true;
+			return;
+		}
+		memcpy(buffer + length, text, textLength);
+		length += textLength;
+	}
+
+	void Add(const char* text) { Add(text, strlen(text)); }
+	void Add(char c) { Add(&c, 1); }
+};
+
+
+void
+write_string(Writer& writer, const char* text)
+{
+	static const char kHex[] = "0123456789abcdef";
+	writer.Add('"');
+	for (const char* c = text; *c != '\0'; c++) {
+		switch (*c) {
+			case '"':
+				writer.Add("\\\"");
+				break;
+			case '\\':
+				writer.Add("\\\\");
+				break;
+			case '\n':
+				writer.Add("\\n");
+				break;
+			case '\r':
+				writer.Add("\\r");
+				break;
+			case '\t':
+				writer.Add("\\t");
+				break;
+			default:
+				if ((unsigned char)*c < 0x20) {
+					char escape[7] = { '\\', 'u', '0', '0',
+						kHex[(*c >> 4) & 0xf], kHex[*c & 0xf], 0 };
+					writer.Add(escape);
+				} else
+					writer.Add(*c);
+				break;
+		}
+	}
+	writer.Add('"');
+}
+
+
+void
+write_value(Writer& writer, const luks2_json* node)
+{
+	switch (node->type) {
+		case LUKS2_JSON_NULL:
+			writer.Add("null");
+			break;
+		case LUKS2_JSON_FALSE:
+			writer.Add("false");
+			break;
+		case LUKS2_JSON_TRUE:
+			writer.Add("true");
+			break;
+		case LUKS2_JSON_NUMBER:
+			writer.Add(node->text);
+			break;
+		case LUKS2_JSON_STRING:
+			write_string(writer, node->text);
+			break;
+		case LUKS2_JSON_ARRAY:
+		case LUKS2_JSON_OBJECT:
+		{
+			bool object = node->type == LUKS2_JSON_OBJECT;
+			writer.Add(object ? '{' : '[');
+			for (const luks2_json* child = node->first; child != NULL;
+					child = child->next) {
+				if (child != node->first)
+					writer.Add(',');
+				if (object) {
+					write_string(writer, child->key != NULL ? child->key : "");
+					writer.Add(':');
+				}
+				write_value(writer, child);
+			}
+			writer.Add(object ? '}' : ']');
+			break;
+		}
+	}
+}
+
+
+}	// namespace
+
+
+luks2_json*
+luks2_json_parse(const char* text, size_t length)
+{
+	Parser parser = { text, length, 0 };
+	luks2_json* root = parse_value(parser, 0);
+	if (root == NULL)
+		return NULL;
+
+	// only whitespace (and the NUL padding of the LUKS2 JSON area) may follow
+	parser.SkipWhitespace();
+	if (!parser.AtEnd() && parser.Peek() != '\0') {
+		luks2_json_free(root);
+		return NULL;
+	}
+	return root;
+}
+
+
+void
+luks2_json_free(luks2_json* node)
+{
+	while (node != NULL) {
+		luks2_json* child = node->first;
+		while (child != NULL) {
+			luks2_json* next = child->next;
+			child->next = NULL;
+			luks2_json_free(child);
+			child = next;
+		}
+		free(node->key);
+		free(node->text);
+		free(node);
+		node = NULL;
+	}
+}
+
+
+ssize_t
+luks2_json_serialize(const luks2_json* node, char* buffer, size_t size)
+{
+	if (size == 0)
+		return -1;
+	Writer writer = { buffer, size, 0, false };
+	write_value(writer, node);
+	if (writer.overflow)
+		return -1;
+	buffer[writer.length] = '\0';
+	return (ssize_t)writer.length;
+}
+
+
+luks2_json*
+luks2_json_get(const luks2_json* object, const char* key)
+{
+	if (object == NULL || object->type != LUKS2_JSON_OBJECT)
+		return NULL;
+	for (luks2_json* child = object->first; child != NULL;
+			child = child->next) {
+		if (child->key != NULL && strcmp(child->key, key) == 0)
+			return child;
+	}
+	return NULL;
+}
+
+
+luks2_json*
+luks2_json_get_typed(const luks2_json* object, const char* key,
+	luks2_json_type type)
+{
+	luks2_json* node = luks2_json_get(object, key);
+	if (node == NULL || node->type != type)
+		return NULL;
+	return node;
+}
+
+
+const char*
+luks2_json_get_string(const luks2_json* object, const char* key)
+{
+	luks2_json* node = luks2_json_get_typed(object, key, LUKS2_JSON_STRING);
+	return node != NULL ? node->text : NULL;
+}
+
+
+bool
+luks2_json_to_uint64(const luks2_json* node, uint64_t* _value)
+{
+	if (node == NULL || (node->type != LUKS2_JSON_NUMBER
+			&& node->type != LUKS2_JSON_STRING)) {
+		return false;
+	}
+
+	const char* text = node->text;
+	if (text[0] == '\0')
+		return false;
+	uint64_t value = 0;
+	for (const char* c = text; *c != '\0'; c++) {
+		if (*c < '0' || *c > '9')
+			return false;
+		uint64_t digit = (uint64_t)(*c - '0');
+		if (value > (UINT64_MAX - digit) / 10)
+			return false;
+		value = value * 10 + digit;
+	}
+	*_value = value;
+	return true;
+}
+
+
+bool
+luks2_json_get_uint64(const luks2_json* object, const char* key,
+	uint64_t* _value)
+{
+	return luks2_json_to_uint64(luks2_json_get(object, key), _value);
+}
+
+
+size_t
+luks2_json_count(const luks2_json* node)
+{
+	size_t count = 0;
+	if (node != NULL) {
+		for (luks2_json* child = node->first; child != NULL;
+				child = child->next) {
+			count++;
+		}
+	}
+	return count;
+}
+
+
+luks2_json*
+luks2_json_new(luks2_json_type type, const char* text)
+{
+	luks2_json* node = new_node(type);
+	if (node == NULL)
+		return NULL;
+	if (type == LUKS2_JSON_STRING || type == LUKS2_JSON_NUMBER) {
+		node->text = duplicate(text, strlen(text));
+		if (node->text == NULL) {
+			free(node);
+			return NULL;
+		}
+	}
+	return node;
+}
+
+
+luks2_json*
+luks2_json_new_uint64(uint64_t value, bool asString)
+{
+	char text[24];
+	char* end = text + sizeof(text) - 1;
+	*end = '\0';
+	char* start = end;
+	do {
+		*--start = (char)('0' + value % 10);
+		value /= 10;
+	} while (value > 0);
+	return luks2_json_new(asString ? LUKS2_JSON_STRING : LUKS2_JSON_NUMBER,
+		start);
+}
+
+
+bool
+luks2_json_set(luks2_json* object, const char* key, luks2_json* value)
+{
+	if (value == NULL)
+		return false;
+	if (object == NULL || object->type != LUKS2_JSON_OBJECT) {
+		luks2_json_free(value);
+		return false;
+	}
+
+	free(value->key);
+	value->key = duplicate(key, strlen(key));
+	if (value->key == NULL) {
+		luks2_json_free(value);
+		return false;
+	}
+
+	// replace in place, keeping the order of the members
+	luks2_json* previous = NULL;
+	for (luks2_json* child = object->first; child != NULL;
+			previous = child, child = child->next) {
+		if (child->key == NULL || strcmp(child->key, key) != 0)
+			continue;
+		value->next = child->next;
+		if (previous != NULL)
+			previous->next = value;
+		else
+			object->first = value;
+		if (object->last == child)
+			object->last = value;
+		child->next = NULL;
+		luks2_json_free(child);
+		return true;
+	}
+
+	add_child(object, value);
+	return true;
+}
+
+
+bool
+luks2_json_append(luks2_json* array, luks2_json* value)
+{
+	if (value == NULL)
+		return false;
+	if (array == NULL || array->type != LUKS2_JSON_ARRAY) {
+		luks2_json_free(value);
+		return false;
+	}
+	add_child(array, value);
+	return true;
+}
+
+
+static bool
+remove_child(luks2_json* parent, luks2_json* previous, luks2_json* child)
+{
+	if (previous != NULL)
+		previous->next = child->next;
+	else
+		parent->first = child->next;
+	if (parent->last == child)
+		parent->last = previous;
+	child->next = NULL;
+	luks2_json_free(child);
+	return true;
+}
+
+
+bool
+luks2_json_remove(luks2_json* object, const char* key)
+{
+	if (object == NULL || object->type != LUKS2_JSON_OBJECT)
+		return false;
+	luks2_json* previous = NULL;
+	for (luks2_json* child = object->first; child != NULL;
+			previous = child, child = child->next) {
+		if (child->key != NULL && strcmp(child->key, key) == 0)
+			return remove_child(object, previous, child);
+	}
+	return false;
+}
+
+
+bool
+luks2_json_remove_string(luks2_json* array, const char* text)
+{
+	if (array == NULL || array->type != LUKS2_JSON_ARRAY)
+		return false;
+	luks2_json* previous = NULL;
+	for (luks2_json* child = array->first; child != NULL;
+			previous = child, child = child->next) {
+		if (child->type == LUKS2_JSON_STRING && strcmp(child->text, text) == 0)
+			return remove_child(array, previous, child);
+	}
+	return false;
+}
+
+
+luks2_json*
+luks2_json_clone(const luks2_json* node)
+{
+	luks2_json* copy = new_node(node->type);
+	if (copy == NULL)
+		return NULL;
+	if (node->text != NULL
+		&& (copy->text = duplicate(node->text, strlen(node->text))) == NULL) {
+		free(copy);
+		return NULL;
+	}
+	if (node->key != NULL
+		&& (copy->key = duplicate(node->key, strlen(node->key))) == NULL) {
+		luks2_json_free(copy);
+		return NULL;
+	}
+	for (const luks2_json* child = node->first; child != NULL;
+			child = child->next) {
+		luks2_json* childCopy = luks2_json_clone(child);
+		if (childCopy == NULL) {
+			luks2_json_free(copy);
+			return NULL;
+		}
+		add_child(copy, childCopy);
+	}
+	return copy;
+}
diff --git a/src/libs/luks2/luks2_internal.h b/src/libs/luks2/luks2_internal.h
new file mode 100644
index 0000000000..48b81fdd76
--- /dev/null
+++ b/src/libs/luks2/luks2_internal.h
@@ -0,0 +1,64 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LUKS2_INTERNAL_H
+#define _LUKS2_INTERNAL_H
+
+
+#include <luks2/luks2.h>
+
+#include "crypto/luks2_crypto_internal.h"
+
+
+// binary header layout (all integers big-endian)
+#define LUKS2_OFFSET_MAGIC			0
+#define LUKS2_OFFSET_VERSION		6
+#define LUKS2_OFFSET_HEADER_SIZE	8
+#define LUKS2_OFFSET_SEQUENCE_ID	16
+#define LUKS2_OFFSET_LABEL			24
+#define LUKS2_OFFSET_CHECKSUM_ALG	72
+#define LUKS2_OFFSET_SALT			104
+#define LUKS2_OFFSET_UUID			168
+#define LUKS2_OFFSET_SUBSYSTEM		208
+#define LUKS2_OFFSET_HEADER_OFFSET	256
+#define LUKS2_OFFSET_CHECKSUM		448
+#define LUKS2_CHECKSUM_ALG_SIZE		32
+#define LUKS2_CHECKSUM_SIZE			64
+
+extern const uint8_t kLUKS2PrimaryMagic[LUKS2_MAGIC_SIZE];
+extern const uint8_t kLUKS2SecondaryMagic[LUKS2_MAGIC_SIZE];
+extern const uint64_t kLUKS2HeaderSizes[];
+extern const size_t kLUKS2HeaderSizeCount;
+
+#define LUKS2_CIPHER_AES_XTS_PLAIN64	"aes-xts-plain64"
+
+
+// base64 (RFC 4648, standard alphabet, padding optional on input)
+ssize_t luks2_base64_decode(const char* text, uint8_t* output,
+	size_t outputSize);
+/*!	Writes a NUL-terminated string; \a outputSize must be at least
+	4 * ((length + 2) / 3) + 1. */
+void luks2_base64_encode(const uint8_t* data, size_t length, char* output);
+
+// the "luks1" anti-forensic split
+void luks2_af_merge(const uint8_t* material, size_t keySize,
+	uint32_t stripes, int hash, uint8_t* key);
+int luks2_af_split(const uint8_t* key, size_t keySize, uint32_t stripes,
+	int hash, uint8_t* material);
+
+// derives the key that encrypts a keyslot area
+int luks2_derive_keyslot_key(const luks2_kdf* kdf, const void* passphrase,
+	size_t passphraseLength, uint8_t* output, size_t outputLength);
+
+// parses volume->json into the structures of volume
+int luks2_parse_metadata(luks2_volume* volume, uint64_t deviceSize);
+
+static inline uint64_t
+luks2_round_up(uint64_t value, uint64_t alignment)
+{
+	return (value + alignment - 1) / alignment * alignment;
+}
+
+
+#endif	// _LUKS2_INTERNAL_H
diff --git a/src/libs/luks2/luks2_read.cpp b/src/libs/luks2/luks2_read.cpp
new file mode 100644
index 0000000000..b56cfe1c2a
--- /dev/null
+++ b/src/libs/luks2/luks2_read.cpp
@@ -0,0 +1,835 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Reading LUKS2 headers and metadata, unlocking keyslots, checking volume
+	keys. Written from the LUKS2 on-disk format specification.
+*/
+
+
+#include "luks2_internal.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+
+const uint8_t kLUKS2PrimaryMagic[LUKS2_MAGIC_SIZE]
+	= { 'L', 'U', 'K', 'S', 0xba, 0xbe };
+const uint8_t kLUKS2SecondaryMagic[LUKS2_MAGIC_SIZE]
+	= { 'S', 'K', 'U', 'L', 0xba, 0xbe };
+const uint64_t kLUKS2HeaderSizes[] = {
+	0x4000, 0x8000, 0x10000, 0x20000, 0x40000, 0x80000, 0x100000, 0x200000,
+	0x400000
+};
+const size_t kLUKS2HeaderSizeCount
+	= sizeof(kLUKS2HeaderSizes) / sizeof(kLUKS2HeaderSizes[0]);
+
+
+namespace {
+
+
+struct HeaderCopy {
+	bool		valid;
+	uint64_t	offset;
+	uint64_t	size;
+	uint64_t	sequenceID;
+	int			hash;
+	uint8_t*	data;		// size bytes: binary header and JSON area
+};
+
+
+bool
+valid_header_size(uint64_t size)
+{
+	for (size_t i = 0; i < kLUKS2HeaderSizeCount; i++) {
+		if (kLUKS2HeaderSizes[i] == size)
+			return true;
+	}
+	return false;
+}
+
+
+bool
+read_fully(const luks2_device_io* io, uint64_t offset, void* buffer,
+	size_t size)
+{
+	if (offset > io->size || io->size - offset < size)
+		return false;
+	return io->read(io->cookie, offset, buffer, size) == (ssize_t)size;
+}
+
+
+//! Copies a fixed-size, possibly unterminated header string.
+void
+copy_header_string(char* target, const uint8_t* source, size_t size)
+{
+	memcpy(target, source, size);
+	target[size - 1] = '\0';
+}
+
+
+/*!	Reads and checks the header copy at \a offset. On success \a copy
+	owns a buffer with the whole header area. */
+void
+read_header_copy(const luks2_device_io* io, uint64_t offset, bool primary,
+	HeaderCopy& copy)
+{
+	copy.valid = false;
+	copy.data = NULL;
+
+	uint8_t binary[LUKS2_BINARY_HEADER_SIZE];
+	if (!read_fully(io, offset, binary, sizeof(binary)))
+		return;
+
+	if (memcmp(binary + LUKS2_OFFSET_MAGIC,
+			primary ? kLUKS2PrimaryMagic : kLUKS2SecondaryMagic,
+			LUKS2_MAGIC_SIZE) != 0
+		|| binary[LUKS2_OFFSET_VERSION] != 0
+		|| binary[LUKS2_OFFSET_VERSION + 1] != 2) {
+		return;
+	}
+
+	uint64_t size = luks2_load64be(binary + LUKS2_OFFSET_HEADER_SIZE);
+	if (!valid_header_size(size)
+		|| luks2_load64be(binary + LUKS2_OFFSET_HEADER_OFFSET) != offset) {
+		return;
+	}
+
+	char algorithm[LUKS2_CHECKSUM_ALG_SIZE];
+	copy_header_string(algorithm, binary + LUKS2_OFFSET_CHECKSUM_ALG,
+		sizeof(algorithm));
+	int hash = luks2_hash_from_name(algorithm);
+	if (hash == 0)
+		return;
+
+	uint8_t* data = (uint8_t*)malloc(size);
+	if (data == NULL)
+		return;
+	memcpy(data, binary, sizeof(binary));
+	if (!read_fully(io, offset + sizeof(binary), data + sizeof(binary),
+			size - sizeof(binary))) {
+		free(data);
+		return;
+	}
+
+	// the checksum covers the whole area with the checksum field zeroed
+	uint8_t stored[LUKS2_CHECKSUM_SIZE];
+	memcpy(stored, data + LUKS2_OFFSET_CHECKSUM, sizeof(stored));
+	memset(data + LUKS2_OFFSET_CHECKSUM, 0, LUKS2_CHECKSUM_SIZE);
+	uint8_t computed[LUKS2_MAX_DIGEST_SIZE];
+	luks2_hash context;
+	luks2_hash_init(&context, hash);
+	luks2_hash_update(&context, data, size);
+	luks2_hash_final(&context, computed);
+	memcpy(data + LUKS2_OFFSET_CHECKSUM, stored, sizeof(stored));
+
+	if (memcmp(computed, stored, luks2_hash_digest_size(hash)) != 0) {
+		free(data);
+		return;
+	}
+
+	copy.valid = true;
+	copy.offset = offset;
+	copy.size = size;
+	copy.sequenceID = luks2_load64be(binary + LUKS2_OFFSET_SEQUENCE_ID);
+	copy.hash = hash;
+	copy.data = data;
+}
+
+
+bool
+parse_index(const char* key, int max, int* _index)
+{
+	// decimal, no sign, no leading zeros
+	if (key == NULL || key[0] == '\0' || (key[0] == '0' && key[1] != '\0'))
+		return false;
+	int value = 0;
+	for (const char* c = key; *c != '\0'; c++) {
+		if (*c < '0' || *c > '9')
+			return false;
+		value = value * 10 + (*c - '0');
+		if (value >= max)
+			return false;
+	}
+	*_index = value;
+	return true;
+}
+
+
+bool
+get_uint32(const luks2_json* object, const char* key, uint32_t* _value)
+{
+	uint64_t value;
+	if (!luks2_json_get_uint64(object, key, &value) || value > UINT32_MAX)
+		return false;
+	*_value = (uint32_t)value;
+	return true;
+}
+
+
+bool
+get_salt(const luks2_json* object, const char* key, uint8_t* salt,
+	size_t* _length)
+{
+	const char* text = luks2_json_get_string(object, key);
+	if (text == NULL)
+		return false;
+	ssize_t length = luks2_base64_decode(text, salt, LUKS2_SALT_SIZE);
+	if (length < 0)
+		return false;
+	*_length = (size_t)length;
+	return true;
+}
+
+
+/*!	Turns an array of index strings into a bit mask. */
+bool
+get_index_mask(const luks2_json* object, const char* key, int max,
+	uint32_t* _mask)
+{
+	luks2_json* array = luks2_json_get_typed(object, key, LUKS2_JSON_ARRAY);
+	if (array == NULL)
+		return false;
+	uint32_t mask = 0;
+	for (luks2_json* item = array->first; item != NULL; item = item->next) {
+		int index;
+		if (item->type != LUKS2_JSON_STRING
+			|| !parse_index(item->text, max, &index)) {
+			return false;
+		}
+		mask |= 1u << index;
+	}
+	*_mask = mask;
+	return true;
+}
+
+
+int
+parse_kdf(const luks2_json* kdfObject, luks2_kdf& kdf, bool& supported)
+{
+	const char* type = luks2_json_get_string(kdfObject, "type");
+	if (type == NULL)
+		return LUKS2_ERROR_CORRUPT;
+
+	if (strcmp(type, "pbkdf2") == 0) {
+		kdf.type = LUKS2_KDF_PBKDF2;
+		kdf.hash = luks2_hash_from_name(
+			luks2_json_get_string(kdfObject, "hash"));
+		if (!get_uint32(kdfObject, "iterations", &kdf.iterations)
+			|| !get_salt(kdfObject, "salt", kdf.salt, &kdf.salt_length)) {
+			return LUKS2_ERROR_CORRUPT;
+		}
+		if (kdf.hash == 0 || kdf.iterations == 0)
+			supported = false;
+		return LUKS2_OK;
+	}
+
+	if (strcmp(type, "argon2i") == 0 || strcmp(type, "argon2id") == 0) {
+		kdf.type = strcmp(type, "argon2id") == 0
+			? LUKS2_KDF_ARGON2ID : LUKS2_KDF_ARGON2I;
+		if (!get_uint32(kdfObject, "time", &kdf.time)
+			|| !get_uint32(kdfObject, "memory", &kdf.memory)
+			|| !get_uint32(kdfObject, "cpus", &kdf.cpus)
+			|| !get_salt(kdfObject, "salt", kdf.salt, &kdf.salt_length)) {
+			return LUKS2_ERROR_CORRUPT;
+		}
+		if (kdf.time == 0 || kdf.cpus == 0 || kdf.memory < 8 * kdf.cpus
+			|| kdf.salt_length < 8) {
+			supported = false;
+		}
+		return LUKS2_OK;
+	}
+
+	supported = false;
+	return LUKS2_OK;
+}
+
+
+int
+parse_keyslot(luks2_volume* volume, const luks2_json* object,
+	luks2_keyslot& keyslot)
+{
+	memset(&keyslot, 0, sizeof(keyslot));
+	keyslot.used = true;
+	keyslot.supported = true;
+	keyslot.priority = 1;
+	keyslot.digest = -1;
+
+	const char* type = luks2_json_get_string(object, "type");
+	if (type == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	if (strcmp(type, "luks2") != 0) {
+		// e.g. "reencrypt": not ours to open
+		keyslot.supported = false;
+		return LUKS2_OK;
+	}
+
+	uint64_t priority;
+	if (luks2_json_get(object, "priority") != NULL) {
+		if (!luks2_json_get_uint64(object, "priority", &priority)
+			|| priority > 2) {
+			return LUKS2_ERROR_CORRUPT;
+		}
+		keyslot.priority = (int)priority;
+	}
+
+	if (!get_uint32(object, "key_size", &keyslot.key_size))
+		return LUKS2_ERROR_CORRUPT;
+	if (keyslot.key_size == 0 || keyslot.key_size > LUKS2_MAX_KEY_SIZE)
+		keyslot.supported = false;
+
+	// the area
+	const luks2_json* area = luks2_json_get_typed(object, "area",
+		LUKS2_JSON_OBJECT);
+	const char* areaType = luks2_json_get_string(area, "type");
+	if (area == NULL || areaType == NULL
+		|| !luks2_json_get_uint64(area, "offset", &keyslot.area_offset)
+		|| !luks2_json_get_uint64(area, "size", &keyslot.area_size)) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+	const char* areaCipher = luks2_json_get_string(area, "encryption");
+	if (strcmp(areaType, "raw") != 0 || areaCipher == NULL
+		|| strcmp(areaCipher, LUKS2_CIPHER_AES_XTS_PLAIN64) != 0
+		|| !get_uint32(area, "key_size", &keyslot.area_key_size)
+		|| (keyslot.area_key_size != 32 && keyslot.area_key_size != 64)) {
+		keyslot.supported = false;
+	}
+
+	// the area must lie inside the keyslots area behind both headers
+	uint64_t areaStart = 2 * volume->header_size;
+	uint64_t areaEnd = areaStart + volume->keyslots_size;
+	if (keyslot.area_offset < areaStart || keyslot.area_offset > areaEnd
+		|| keyslot.area_size > areaEnd - keyslot.area_offset
+		|| keyslot.area_offset % LUKS2_KEYSLOT_SECTOR_SIZE != 0) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+
+	// the KDF
+	const luks2_json* kdf = luks2_json_get_typed(object, "kdf",
+		LUKS2_JSON_OBJECT);
+	if (kdf == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	int result = parse_kdf(kdf, keyslot.kdf, keyslot.supported);
+	if (result != LUKS2_OK)
+		return result;
+
+	// the anti-forensic split
+	const luks2_json* af = luks2_json_get_typed(object, "af",
+		LUKS2_JSON_OBJECT);
+	const char* afType = luks2_json_get_string(af, "type");
+	if (af == NULL || afType == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	if (strcmp(afType, "luks1") != 0) {
+		keyslot.supported = false;
+		return LUKS2_OK;
+	}
+	if (!get_uint32(af, "stripes", &keyslot.stripes))
+		return LUKS2_ERROR_CORRUPT;
+	keyslot.af_hash = luks2_hash_from_name(luks2_json_get_string(af, "hash"));
+	if (keyslot.af_hash == 0 || keyslot.stripes == 0)
+		keyslot.supported = false;
+	else if (luks2_round_up((uint64_t)keyslot.stripes * keyslot.key_size,
+			LUKS2_KEYSLOT_SECTOR_SIZE) > keyslot.area_size) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+
+	return LUKS2_OK;
+}
+
+
+int
+parse_digest(const luks2_json* object, luks2_digest& digest)
+{
+	memset(&digest, 0, sizeof(digest));
+	const char* type = luks2_json_get_string(object, "type");
+	if (type == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	if (!get_index_mask(object, "keyslots", LUKS2_MAX_KEYSLOTS,
+			&digest.keyslots)
+		|| !get_index_mask(object, "segments", 32, &digest.segments)) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+	if (strcmp(type, "pbkdf2") != 0) {
+		// an unknown digest type: its keyslots stay unusable
+		return LUKS2_OK;
+	}
+
+	digest.hash = luks2_hash_from_name(luks2_json_get_string(object, "hash"));
+	if (!get_uint32(object, "iterations", &digest.iterations)
+		|| !get_salt(object, "salt", digest.salt, &digest.salt_length)) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+
+	const char* text = luks2_json_get_string(object, "digest");
+	if (text == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	ssize_t length = luks2_base64_decode(text, digest.digest,
+		sizeof(digest.digest));
+	if (length <= 0)
+		return LUKS2_ERROR_CORRUPT;
+	digest.digest_length = (size_t)length;
+
+	digest.used = digest.hash != 0 && digest.iterations > 0;
+	return LUKS2_OK;
+}
+
+
+int
+parse_segment(const luks2_json* object, uint64_t deviceSize,
+	luks2_segment& segment)
+{
+	memset(&segment, 0, sizeof(segment));
+	const char* type = luks2_json_get_string(object, "type");
+	if (type == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	if (strcmp(type, "crypt") != 0)
+		return LUKS2_ERROR_UNSUPPORTED;
+
+	if (!luks2_json_get_uint64(object, "offset", &segment.offset)
+		|| !luks2_json_get_uint64(object, "iv_tweak", &segment.iv_tweak)
+		|| !get_uint32(object, "sector_size", &segment.sector_size)) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+
+	const char* cipher = luks2_json_get_string(object, "encryption");
+	if (cipher == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	if (strcmp(cipher, LUKS2_CIPHER_AES_XTS_PLAIN64) != 0
+		|| luks2_json_get(object, "integrity") != NULL) {
+		return LUKS2_ERROR_UNSUPPORTED;
+	}
+	const luks2_json* flags = luks2_json_get(object, "flags");
+	if (flags != NULL && (flags->type != LUKS2_JSON_ARRAY
+			|| luks2_json_count(flags) > 0)) {
+		// flags mark segments in the middle of a reencryption
+		return LUKS2_ERROR_UNSUPPORTED;
+	}
+
+	uint32_t sectorSize = segment.sector_size;
+	if (sectorSize < 512 || sectorSize > 4096
+		|| (sectorSize & (sectorSize - 1)) != 0
+		|| segment.offset % sectorSize != 0 || segment.offset > deviceSize) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+
+	const luks2_json* size = luks2_json_get(object, "size");
+	if (size != NULL && size->type == LUKS2_JSON_STRING
+		&& strcmp(size->text, "dynamic") == 0) {
+		segment.dynamic = true;
+		segment.size = (deviceSize - segment.offset) / sectorSize * sectorSize;
+	} else {
+		if (!luks2_json_to_uint64(size, &segment.size)
+			|| segment.size % sectorSize != 0)
+			return LUKS2_ERROR_CORRUPT;
+		if (segment.size > deviceSize - segment.offset) {
+			// the device got smaller than the volume
+			return LUKS2_ERROR_CORRUPT;
+		}
+	}
+	return LUKS2_OK;
+}
+
+
+}	// namespace
+
+
+int
+luks2_parse_metadata(luks2_volume* volume, uint64_t deviceSize)
+{
+	const luks2_json* root = volume->json;
+	if (root == NULL || root->type != LUKS2_JSON_OBJECT)
+		return LUKS2_ERROR_CORRUPT;
+
+	const luks2_json* keyslots = luks2_json_get_typed(root, "keyslots",
+		LUKS2_JSON_OBJECT);
+	const luks2_json* segments = luks2_json_get_typed(root, "segments",
+		LUKS2_JSON_OBJECT);
+	const luks2_json* digests = luks2_json_get_typed(root, "digests",
+		LUKS2_JSON_OBJECT);
+	const luks2_json* config = luks2_json_get_typed(root, "config",
+		LUKS2_JSON_OBJECT);
+	if (keyslots == NULL || segments == NULL || digests == NULL
+		|| config == NULL) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+
+	// config
+	if (!luks2_json_get_uint64(config, "json_size", &volume->json_size)
+		|| !luks2_json_get_uint64(config, "keyslots_size",
+			&volume->keyslots_size)
+		|| volume->json_size != volume->header_size - LUKS2_BINARY_HEADER_SIZE
+		|| volume->keyslots_size % 4096 != 0) {
+		return LUKS2_ERROR_CORRUPT;
+	}
+	volume->allow_discards = false;
+	const luks2_json* flags = luks2_json_get_typed(config, "flags",
+		LUKS2_JSON_ARRAY);
+	for (const luks2_json* flag = flags != NULL ? flags->first : NULL;
+			flag != NULL; flag = flag->next) {
+		if (flag->type == LUKS2_JSON_STRING
+			&& strcmp(flag->text, "allow-discards") == 0) {
+			volume->allow_discards = true;
+		}
+	}
+	const luks2_json* requirements = luks2_json_get_typed(config,
+		"requirements", LUKS2_JSON_OBJECT);
+	if (requirements != NULL) {
+		const luks2_json* mandatory = luks2_json_get(requirements,
+			"mandatory");
+		if (mandatory != NULL && (mandatory->type != LUKS2_JSON_ARRAY
+				|| luks2_json_count(mandatory) > 0)) {
+			// e.g. an interrupted online reencryption
+			return LUKS2_ERROR_UNSUPPORTED;
+		}
+	}
+
+	// segments: exactly one, "0"
+	if (luks2_json_count(segments) != 1
+		|| luks2_json_get(segments, "0") == NULL) {
+		return luks2_json_count(segments) == 0
+			? LUKS2_ERROR_CORRUPT : LUKS2_ERROR_UNSUPPORTED;
+	}
+	int result = parse_segment(luks2_json_get(segments, "0"), deviceSize,
+		volume->segment);
+	if (result != LUKS2_OK)
+		return result;
+	if (volume->segment.offset < 2 * volume->header_size)
+		return LUKS2_ERROR_UNSUPPORTED;
+			// a detached header
+
+	// keyslots
+	memset(volume->keyslots, 0, sizeof(volume->keyslots));
+	for (const luks2_json* item = keyslots->first; item != NULL;
+			item = item->next) {
+		int index;
+		if (!parse_index(item->key, LUKS2_MAX_KEYSLOTS, &index)
+			|| item->type != LUKS2_JSON_OBJECT
+			|| volume->keyslots[index].used) {
+			return LUKS2_ERROR_CORRUPT;
+		}
+		result = parse_keyslot(volume, item, volume->keyslots[index]);
+		if (result != LUKS2_OK)
+			return result;
+	}
+
+	// digests
+	memset(volume->digests, 0, sizeof(volume->digests));
+	volume->segment_digest = -1;
+	uint32_t seenDigests = 0;
+	for (const luks2_json* item = digests->first; item != NULL;
+			item = item->next) {
+		int index;
+		if (!parse_index(item->key, LUKS2_MAX_DIGESTS, &index)
+			|| item->type != LUKS2_JSON_OBJECT
+			|| (seenDigests & (1u << index)) != 0) {
+			return LUKS2_ERROR_CORRUPT;
+		}
+		seenDigests |= 1u << index;
+		result = parse_digest(item, volume->digests[index]);
+		if (result != LUKS2_OK)
+			return result;
+
+		luks2_digest& digest = volume->digests[index];
+		for (int slot = 0; slot < LUKS2_MAX_KEYSLOTS; slot++) {
+			if ((digest.keyslots & (1u << slot)) == 0)
+				continue;
+			if (!volume->keyslots[slot].used)
+				return LUKS2_ERROR_CORRUPT;
+			if (digest.used)
+				volume->keyslots[slot].digest = index;
+		}
+		if ((digest.segments & ~1u) != 0)
+			return LUKS2_ERROR_CORRUPT;
+		if ((digest.segments & 1u) != 0) {
+			if (volume->segment_digest >= 0)
+				return LUKS2_ERROR_UNSUPPORTED;
+			volume->segment_digest = digest.used ? index : -1;
+			if (!digest.used)
+				return LUKS2_ERROR_UNSUPPORTED;
+		}
+	}
+	if (volume->segment_digest < 0)
+		return LUKS2_ERROR_CORRUPT;
+
+	// the volume key size: that of the keyslots of the segment's digest
+	volume->segment.key_size = 0;
+	for (int slot = 0; slot < LUKS2_MAX_KEYSLOTS; slot++) {
+		luks2_keyslot& keyslot = volume->keyslots[slot];
+		if (!keyslot.used || keyslot.digest != volume->segment_digest)
+			continue;
+		if (volume->segment.key_size == 0)
+			volume->segment.key_size = keyslot.key_size;
+		else if (volume->segment.key_size != keyslot.key_size)
+			return LUKS2_ERROR_CORRUPT;
+	}
+	// a volume without keyslots is valid; take the key size from nothing
+	if (volume->segment.key_size != 0 && volume->segment.key_size != 32
+		&& volume->segment.key_size != 64) {
+		return LUKS2_ERROR_UNSUPPORTED;
+	}
+
+	return LUKS2_OK;
+}
+
+
+extern "C" bool
+luks2_has_signature(const void* firstSector, size_t length)
+{
+	const uint8_t* bytes = (const uint8_t*)firstSector;
+	return length >= 8
+		&& memcmp(bytes, kLUKS2PrimaryMagic, LUKS2_MAGIC_SIZE) == 0
+		&& bytes[LUKS2_OFFSET_VERSION] == 0
+		&& bytes[LUKS2_OFFSET_VERSION + 1] == 2;
+}
+
+
+extern "C" int
+luks2_read_header(const luks2_device_io* io, luks2_volume** _volume)
+{
+	HeaderCopy primary;
+	HeaderCopy secondary;
+	read_header_copy(io, 0, true, primary);
+
+	secondary.valid = false;
+	secondary.data = NULL;
+	if (primary.valid)
+		read_header_copy(io, primary.size, false, secondary);
+	else {
+		// the secondary is at one of the defined header sizes
+		for (size_t i = 0; i < kLUKS2HeaderSizeCount && !secondary.valid; i++)
+			read_header_copy(io, kLUKS2HeaderSizes[i], false, secondary);
+	}
+
+	if (!primary.valid && !secondary.valid) {
+		// a LUKS2 magic with no valid copy is a damaged LUKS2 header; LUKS1
+		// and others aren't LUKS2
+		uint8_t first[8];
+		if (read_fully(io, 0, first, sizeof(first))
+			&& luks2_has_signature(first, sizeof(first))) {
+			return LUKS2_ERROR_CORRUPT;
+		}
+		return LUKS2_ERROR_NOT_LUKS2;
+	}
+
+	// the newer valid copy wins; the primary when they're the same
+	HeaderCopy* chosen = &primary;
+	if (!primary.valid
+		|| (secondary.valid && secondary.sequenceID > primary.sequenceID)) {
+		chosen = &secondary;
+	}
+
+	luks2_volume* volume = (luks2_volume*)calloc(1, sizeof(luks2_volume));
+	if (volume == NULL) {
+		free(primary.data);
+		free(secondary.data);
+		return LUKS2_ERROR_NO_MEMORY;
+	}
+
+	const uint8_t* data = chosen->data;
+	copy_header_string(volume->uuid, data + LUKS2_OFFSET_UUID,
+		LUKS2_UUID_SIZE);
+	copy_header_string(volume->label, data + LUKS2_OFFSET_LABEL,
+		LUKS2_LABEL_SIZE);
+	copy_header_string(volume->subsystem, data + LUKS2_OFFSET_SUBSYSTEM,
+		LUKS2_LABEL_SIZE);
+	volume->header_size = chosen->size;
+	volume->sequence_id = chosen->sequenceID;
+	volume->header_hash = chosen->hash;
+	volume->primary_valid = primary.valid;
+	volume->secondary_valid = secondary.valid;
+
+	// the JSON text ends at the first NUL of the JSON area
+	const char* json = (const char*)data + LUKS2_BINARY_HEADER_SIZE;
+	size_t jsonAreaSize = chosen->size - LUKS2_BINARY_HEADER_SIZE;
+	size_t jsonLength = strnlen(json, jsonAreaSize);
+	int result = LUKS2_OK;
+	if (jsonLength == jsonAreaSize)
+		result = LUKS2_ERROR_CORRUPT;
+	else {
+		volume->json = luks2_json_parse(json, jsonLength);
+		result = volume->json != NULL
+			? luks2_parse_metadata(volume, io->size) : LUKS2_ERROR_CORRUPT;
+	}
+
+	free(primary.data);
+	free(secondary.data);
+
+	if (result != LUKS2_OK) {
+		luks2_free_volume(volume);
+		return result;
+	}
+	*_volume = volume;
+	return LUKS2_OK;
+}
+
+
+extern "C" void
+luks2_free_volume(luks2_volume* volume)
+{
+	if (volume == NULL)
+		return;
+	luks2_json_free(volume->json);
+	luks2_wipe(volume, sizeof(*volume));
+	free(volume);
+}
+
+
+extern "C" int
+luks2_check_key(const luks2_volume* volume, const uint8_t* key,
+	size_t keySize)
+{
+	if (volume->segment_digest < 0)
+		return LUKS2_ERROR_CORRUPT;
+	if (keySize != volume->segment.key_size || keySize == 0)
+		return LUKS2_ERROR_BAD_KEY;
+
+	const luks2_digest& digest = volume->digests[volume->segment_digest];
+	uint8_t computed[LUKS2_MAX_DIGEST_SIZE];
+	if (luks2_pbkdf2(digest.hash, key, keySize, digest.salt,
+			digest.salt_length, digest.iterations, computed,
+			digest.digest_length) != 0) {
+		return LUKS2_ERROR_UNSUPPORTED;
+	}
+	bool equal = luks2_equal(computed, digest.digest, digest.digest_length);
+	luks2_wipe(computed, sizeof(computed));
+	return equal ? LUKS2_OK : LUKS2_ERROR_BAD_KEY;
+}
+
+
+bool
+luks2_keyslot_memory_fits(const luks2_keyslot* keyslot, uint64_t availableKiB)
+{
+	if (keyslot->kdf.type == LUKS2_KDF_PBKDF2)
+		return true;
+	return keyslot->kdf.memory <= availableKiB;
+}
+
+
+/*!	Opens one keyslot: derive the area key, decrypt the area, merge the
+	stripes, check the result against the digest. */
+static int
+try_keyslot(const luks2_volume* volume, const luks2_device_io* io, int slot,
+	const void* passphrase, size_t passphraseLength, uint8_t* key)
+{
+	const luks2_keyslot& keyslot = volume->keyslots[slot];
+	if (!keyslot.used || !keyslot.supported
+		|| keyslot.digest != volume->segment_digest) {
+		return LUKS2_ERROR_BAD_PASSPHRASE;
+	}
+
+	size_t materialSize = (size_t)keyslot.stripes * keyslot.key_size;
+	size_t areaBytes = (size_t)luks2_round_up(materialSize,
+		LUKS2_KEYSLOT_SECTOR_SIZE);
+	uint8_t* material = (uint8_t*)malloc(areaBytes);
+	if (material == NULL)
+		return LUKS2_ERROR_NO_MEMORY;
+
+	int result = LUKS2_OK;
+	if (!read_fully(io, keyslot.area_offset, material, areaBytes))
+		result = LUKS2_ERROR_IO;
+
+	uint8_t areaKey[LUKS2_MAX_KEY_SIZE];
+	if (result == LUKS2_OK) {
+		result = luks2_derive_keyslot_key(&keyslot.kdf, passphrase,
+			passphraseLength, areaKey, keyslot.area_key_size);
+	}
+
+	luks2_xts* xts = NULL;
+	if (result == LUKS2_OK) {
+		xts = (luks2_xts*)malloc(sizeof(luks2_xts));
+		if (xts == NULL)
+			result = LUKS2_ERROR_NO_MEMORY;
+	}
+	if (result == LUKS2_OK
+		&& luks2_xts_set_key(xts, areaKey, keyslot.area_key_size) != 0) {
+		result = LUKS2_ERROR_UNSUPPORTED;
+	}
+	if (result == LUKS2_OK) {
+		for (size_t sector = 0; sector < areaBytes / LUKS2_KEYSLOT_SECTOR_SIZE;
+				sector++) {
+			luks2_xts_decrypt(xts, sector,
+				material + sector * LUKS2_KEYSLOT_SECTOR_SIZE,
+				LUKS2_KEYSLOT_SECTOR_SIZE);
+		}
+		luks2_af_merge(material, keyslot.key_size, keyslot.stripes,
+			keyslot.af_hash, key);
+		result = luks2_check_key(volume, key, keyslot.key_size);
+		if (result == LUKS2_ERROR_BAD_KEY)
+			result = LUKS2_ERROR_BAD_PASSPHRASE;
+	}
+
+	if (xts != NULL) {
+		luks2_xts_clear(xts);
+		free(xts);
+	}
+	luks2_wipe(areaKey, sizeof(areaKey));
+	luks2_wipe(material, areaBytes);
+	free(material);
+	if (result != LUKS2_OK)
+		luks2_wipe(key, LUKS2_MAX_KEY_SIZE);
+	return result;
+}
+
+
+extern "C" int
+luks2_unlock(const luks2_volume* volume, const luks2_device_io* io,
+	const void* passphrase, size_t passphraseLength, int keyslot,
+	uint8_t* key, size_t* _keySize, int* _keyslot)
+{
+	if (keyslot >= LUKS2_MAX_KEYSLOTS)
+		return LUKS2_ERROR_BAD_ARGUMENT;
+
+	int result = LUKS2_ERROR_BAD_PASSPHRASE;
+	bool memoryProblem = false;
+
+	if (keyslot >= 0) {
+		if (!volume->keyslots[keyslot].used)
+			return LUKS2_ERROR_BAD_ARGUMENT;
+		result = try_keyslot(volume, io, keyslot, passphrase,
+			passphraseLength, key);
+		if (result == LUKS2_OK) {
+			*_keySize = volume->keyslots[keyslot].key_size;
+			if (_keyslot != NULL)
+				*_keyslot = keyslot;
+		}
+		return result;
+	}
+
+	for (int priority = 2; priority >= 1; priority--) {
+		for (int slot = 0; slot < LUKS2_MAX_KEYSLOTS; slot++) {
+			if (!volume->keyslots[slot].used
+				|| volume->keyslots[slot].priority != priority) {
+				continue;
+			}
+			result = try_keyslot(volume, io, slot, passphrase,
+				passphraseLength, key);
+			if (result == LUKS2_OK) {
+				*_keySize = volume->keyslots[slot].key_size;
+				if (_keyslot != NULL)
+					*_keyslot = slot;
+				return LUKS2_OK;
+			}
+			if (result == LUKS2_ERROR_KDF_MEMORY)
+				memoryProblem = true;
+			else if (result == LUKS2_ERROR_IO
+				|| result == LUKS2_ERROR_NO_MEMORY) {
+				return result;
+			}
+		}
+	}
+	return memoryProblem ? LUKS2_ERROR_KDF_MEMORY : LUKS2_ERROR_BAD_PASSPHRASE;
+}
+
+
+extern "C" int
+luks2_setup_cipher(const luks2_volume* volume, const uint8_t* key,
+	size_t keySize, luks2_xts* xts)
+{
+	if (keySize != volume->segment.key_size)
+		return LUKS2_ERROR_BAD_KEY;
+	if (luks2_xts_set_key(xts, key, keySize) != 0)
+		return LUKS2_ERROR_UNSUPPORTED;
+	return LUKS2_OK;
+}
