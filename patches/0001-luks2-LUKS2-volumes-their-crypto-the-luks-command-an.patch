diff --git a/src/bin/luks/luks.cpp b/src/bin/luks/luks.cpp
new file mode 100644
index 0000000000..6c7e3dbf7c
--- /dev/null
+++ b/src/bin/luks/luks.cpp
@@ -0,0 +1,1150 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	luks: creates, opens and manages LUKS2 encrypted volumes.
+
+	The same source builds for Haiku and for the build host (Linux), where
+	it makes encrypted images and serves the host tests; "open", "close"
+	and "list" need Haiku's luks driver.
+*/
+
+
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <getopt.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <termios.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <luks2/luks2.h>
+
+#ifdef __HAIKU__
+#	include <Drivers.h>
+#	include <OS.h>
+#	include <luks2/luks2_driver.h>
+#else
+#	include <sys/random.h>
+#	ifdef __linux__
+#		include <linux/fs.h>
+#	endif
+#endif
+
+
+static const char* kProgramName = "luks";
+
+static const size_t kMaxPassphraseLength = 512;
+static const size_t kMaxKeyFileSize = 8 * 1024 * 1024;
+
+
+struct Options {
+	const char*	keyFile;
+	const char*	newKeyFile;
+	const char*	label;
+	int			keySlot;
+	uint32_t	sectorSize;
+	uint32_t	keyBits;
+	int			kdfType;
+	uint32_t	iterTime;
+	uint32_t	memory;
+	uint32_t	parallel;
+	uint32_t	time;
+	uint32_t	iterations;
+	uint32_t	digestIterations;
+	bool		readOnly;
+	bool		force;
+	bool		yes;
+};
+
+
+static Options sOptions;
+
+
+// #pragma mark - random numbers
+
+
+int
+luks2_random(void* buffer, size_t size)
+{
+#ifdef __HAIKU__
+	int fd = open("/dev/urandom", O_RDONLY);
+	if (fd < 0)
+		return -1;
+	uint8_t* bytes = (uint8_t*)buffer;
+	while (size > 0) {
+		ssize_t bytesRead = read(fd, bytes, size);
+		if (bytesRead <= 0) {
+			close(fd);
+			return -1;
+		}
+		bytes += bytesRead;
+		size -= bytesRead;
+	}
+	close(fd);
+	return 0;
+#else
+	uint8_t* bytes = (uint8_t*)buffer;
+	while (size > 0) {
+		ssize_t bytesRead = getrandom(bytes, size, 0);
+		if (bytesRead < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		bytes += bytesRead;
+		size -= bytesRead;
+	}
+	return 0;
+#endif
+}
+
+
+// #pragma mark - devices
+
+
+struct Device {
+	int				fd;
+	luks2_device_io	io;
+};
+
+
+static ssize_t
+device_read(void* cookie, uint64_t offset, void* buffer, size_t size)
+{
+	return pread(*(int*)cookie, buffer, size, (off_t)offset);
+}
+
+
+static ssize_t
+device_write(void* cookie, uint64_t offset, const void* buffer, size_t size)
+{
+	return pwrite(*(int*)cookie, buffer, size, (off_t)offset);
+}
+
+
+static uint64_t
+device_size(int fd)
+{
+	struct stat st;
+	if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode))
+		return (uint64_t)st.st_size;
+
+#ifdef __HAIKU__
+	device_geometry geometry;
+	if (ioctl(fd, B_GET_GEOMETRY, &geometry, sizeof(geometry)) == 0) {
+		return (uint64_t)geometry.bytes_per_sector * geometry.sectors_per_track
+			* geometry.cylinder_count * geometry.head_count;
+	}
+#elif defined(__linux__)
+	uint64_t size;
+	if (ioctl(fd, BLKGETSIZE64, &size) == 0)
+		return size;
+#endif
+	off_t end = lseek(fd, 0, SEEK_END);
+	return end > 0 ? (uint64_t)end : 0;
+}
+
+
+static bool
+open_device(const char* path, bool writable, Device& device)
+{
+	device.fd = open(path, writable ? O_RDWR : O_RDONLY);
+	if (device.fd < 0) {
+		fprintf(stderr, "%s: can't open %s: %s\n", kProgramName, path,
+			strerror(errno));
+		return false;
+	}
+	device.io.cookie = &device.fd;
+	device.io.read = device_read;
+	device.io.write = writable ? device_write : NULL;
+	device.io.size = device_size(device.fd);
+	return true;
+}
+
+
+static luks2_volume*
+open_volume(const char* path, bool writable, Device& device)
+{
+	if (!open_device(path, writable, device))
+		return NULL;
+	luks2_volume* volume;
+	int result = luks2_read_header(&device.io, &volume);
+	if (result != LUKS2_OK) {
+		fprintf(stderr, "%s: %s: %s\n", kProgramName, path,
+			luks2_error_string(result));
+		close(device.fd);
+		return NULL;
+	}
+	return volume;
+}
+
+
+// #pragma mark - passphrases
+
+
+struct Passphrase {
+	char*	data;
+	size_t	length;
+
+	Passphrase() : data(NULL), length(0) {}
+	~Passphrase() { Clear(); }
+
+	void Clear()
+	{
+		if (data != NULL) {
+			luks2_wipe(data, length + 1);
+			free(data);
+		}
+		data = NULL;
+		length = 0;
+	}
+};
+
+
+static bool
+read_key_file(const char* path, Passphrase& passphrase)
+{
+	int fd = strcmp(path, "-") == 0 ? dup(STDIN_FILENO) : open(path, O_RDONLY);
+	if (fd < 0) {
+		fprintf(stderr, "%s: can't open key file %s: %s\n", kProgramName, path,
+			strerror(errno));
+		return false;
+	}
+
+	passphrase.Clear();
+	passphrase.data = (char*)malloc(kMaxKeyFileSize + 1);
+	if (passphrase.data == NULL) {
+		close(fd);
+		return false;
+	}
+	while (passphrase.length < kMaxKeyFileSize) {
+		ssize_t bytesRead = read(fd, passphrase.data + passphrase.length,
+			kMaxKeyFileSize - passphrase.length);
+		if (bytesRead < 0 && errno == EINTR)
+			continue;
+		if (bytesRead <= 0)
+			break;
+		passphrase.length += bytesRead;
+	}
+	close(fd);
+	passphrase.data[passphrase.length] = '\0';
+	if (passphrase.length == 0) {
+		fprintf(stderr, "%s: the key file %s is empty\n", kProgramName, path);
+		return false;
+	}
+	return true;
+}
+
+
+/*!	Reads one line from the terminal without echo, or from standard input
+	when it isn't a terminal. */
+static bool
+read_passphrase_line(const char* prompt, Passphrase& passphrase)
+{
+	passphrase.Clear();
+	passphrase.data = (char*)malloc(kMaxPassphraseLength + 2);
+	if (passphrase.data == NULL)
+		return false;
+
+	int fd = STDIN_FILENO;
+	bool terminal = isatty(fd);
+	struct termios saved;
+	if (terminal) {
+		fprintf(stderr, "%s", prompt);
+		fflush(stderr);
+		tcgetattr(fd, &saved);
+		struct termios silent = saved;
+		silent.c_lflag &= ~(ECHO | ECHONL);
+		silent.c_lflag |= ICANON;
+		tcsetattr(fd, TCSAFLUSH, &silent);
+	}
+
+	size_t length = 0;
+	bool ok = false;
+	while (length <= kMaxPassphraseLength) {
+		char c;
+		ssize_t bytesRead = read(fd, &c, 1);
+		if (bytesRead < 0 && errno == EINTR)
+			continue;
+		if (bytesRead <= 0) {
+			ok = length > 0;
+			break;
+		}
+		if (c == '\n') {
+			ok = true;
+			break;
+		}
+		passphrase.data[length++] = c;
+	}
+
+	if (terminal) {
+		tcsetattr(fd, TCSAFLUSH, &saved);
+		fprintf(stderr, "\n");
+	}
+	if (length > kMaxPassphraseLength) {
+		fprintf(stderr, "%s: the passphrase is longer than %zu bytes\n",
+			kProgramName, kMaxPassphraseLength);
+		ok = false;
+	}
+	passphrase.data[length] = '\0';
+	passphrase.length = length;
+	return ok;
+}
+
+
+static bool
+get_passphrase(const char* keyFile, const char* prompt, bool confirm,
+	Passphrase& passphrase)
+{
+	if (keyFile != NULL)
+		return read_key_file(keyFile, passphrase);
+
+	if (!read_passphrase_line(prompt, passphrase))
+		return false;
+	if (passphrase.length == 0) {
+		fprintf(stderr, "%s: empty passphrase\n", kProgramName);
+		return false;
+	}
+	if (confirm && isatty(STDIN_FILENO)) {
+		Passphrase again;
+		if (!read_passphrase_line("Verify passphrase: ", again))
+			return false;
+		if (again.length != passphrase.length
+			|| memcmp(again.data, passphrase.data, passphrase.length) != 0) {
+			fprintf(stderr, "%s: the passphrases don't match\n",
+				kProgramName);
+			return false;
+		}
+	}
+	return true;
+}
+
+
+// #pragma mark - KDF parameters
+
+
+static double
+now()
+{
+	struct timespec time;
+	clock_gettime(CLOCK_MONOTONIC, &time);
+	return time.tv_sec + time.tv_nsec / 1e9;
+}
+
+
+static uint64_t
+physical_memory_kib()
+{
+#ifdef __HAIKU__
+	system_info info;
+	if (get_system_info(&info) == B_OK)
+		return (uint64_t)info.max_pages * B_PAGE_SIZE / 1024;
+	return 512 * 1024;
+#else
+	long pages = sysconf(_SC_PHYS_PAGES);
+	long pageSize = sysconf(_SC_PAGESIZE);
+	if (pages > 0 && pageSize > 0)
+		return (uint64_t)pages * pageSize / 1024;
+	return 512 * 1024;
+#endif
+}
+
+
+/*!	Fills in the KDF parameters from the options, measuring this machine
+	for whatever wasn't given. Argon2 is measured single-threaded, as the
+	boot loader computes it. */
+static bool
+choose_kdf(luks2_kdf& kdf)
+{
+	memset(&kdf, 0, sizeof(kdf));
+	kdf.type = sOptions.kdfType;
+	double target = sOptions.iterTime / 1000.0;
+	const char* salt = "benchmark salt..";
+
+	if (kdf.type == LUKS2_KDF_PBKDF2) {
+		kdf.hash = LUKS2_HASH_SHA256;
+		kdf.iterations = sOptions.iterations;
+		if (kdf.iterations == 0) {
+			uint8_t out[64];
+			uint32_t count = 1000;
+			double elapsed;
+			while (true) {
+				double start = now();
+				luks2_pbkdf2(LUKS2_HASH_SHA256, "passphrase", 10, salt, 16,
+					count, out, 64);
+				elapsed = now() - start;
+				if (elapsed > 0.1 || count > (1u << 30))
+					break;
+				count *= 4;
+			}
+			// 64 bytes of output are two PBKDF2 blocks
+			double rate = count * 2 / elapsed;
+			kdf.iterations = (uint32_t)(rate * target / 2);
+			if (kdf.iterations < 1000)
+				kdf.iterations = 1000;
+		}
+		return true;
+	}
+
+	kdf.cpus = sOptions.parallel != 0 ? sOptions.parallel : 4;
+	kdf.memory = sOptions.memory;
+	if (kdf.memory == 0) {
+		uint64_t memory = physical_memory_kib() / 4;
+		if (memory > 1024 * 1024)
+			memory = 1024 * 1024;
+		kdf.memory = (uint32_t)memory;
+	}
+	if (kdf.memory < 8 * kdf.cpus)
+		kdf.memory = 8 * kdf.cpus;
+	kdf.time = sOptions.time;
+
+	if (kdf.time == 0) {
+		// one pass over a sample, then scale
+		uint32_t sample = kdf.memory < 64 * 1024 ? kdf.memory : 64 * 1024;
+		uint8_t out[64];
+		double start = now();
+		luks2_argon2(kdf.type == LUKS2_KDF_ARGON2I ? LUKS2_ARGON2I
+				: LUKS2_ARGON2ID, 1, sample, kdf.cpus, "passphrase", 10, salt,
+			16, NULL, 0, NULL, 0, out, 64);
+		double perKiB = (now() - start) / sample;
+		double passTime = perKiB * kdf.memory;
+		kdf.time = (uint32_t)(target / passTime);
+		if (kdf.time < 4) {
+			// at least four passes, as cryptsetup; less memory instead
+			kdf.time = 4;
+			uint64_t memory = (uint64_t)(target / 4 / perKiB);
+			if (memory < kdf.memory)
+				kdf.memory = memory < 32 * 1024 ? 32 * 1024 : (uint32_t)memory;
+		}
+	}
+	return true;
+}
+
+
+static uint32_t
+choose_digest_iterations()
+{
+	if (sOptions.digestIterations != 0)
+		return sOptions.digestIterations;
+	// like the keyslots, measured: about 1/8 s on this machine
+	uint8_t out[32];
+	double start = now();
+	luks2_pbkdf2(LUKS2_HASH_SHA256, "key", 3, "salt", 4, 100000, out, 32);
+	double rate = 100000 / (now() - start);
+	uint32_t iterations = (uint32_t)(rate / 8);
+	return iterations < 1000 ? 1000 : iterations;
+}
+
+
+static void
+print_kdf(const luks2_kdf& kdf)
+{
+	if (kdf.type == LUKS2_KDF_PBKDF2) {
+		printf("pbkdf2 (%s), %u iterations", luks2_hash_name(kdf.hash),
+			kdf.iterations);
+	} else {
+		printf("%s, time %u, memory %u KiB, %u lanes",
+			kdf.type == LUKS2_KDF_ARGON2I ? "argon2i" : "argon2id", kdf.time,
+			kdf.memory, kdf.cpus);
+	}
+}
+
+
+// #pragma mark - commands
+
+
+static bool
+confirm(const char* question)
+{
+	if (sOptions.yes)
+		return true;
+	if (!isatty(STDIN_FILENO)) {
+		fprintf(stderr, "%s: %s Use --yes to confirm.\n", kProgramName,
+			question);
+		return false;
+	}
+	fprintf(stderr, "%s Type YES to continue: ", question);
+	char answer[16];
+	if (fgets(answer, sizeof(answer), stdin) == NULL)
+		return false;
+	return strcmp(answer, "YES\n") == 0;
+}
+
+
+static int
+command_format(const char* path)
+{
+	char question[PATH_MAX + 100];
+	snprintf(question, sizeof(question),
+		"This overwrites the start of %s; its data will be lost.", path);
+	if (!confirm(question))
+		return 1;
+
+	Device device;
+	if (!open_device(path, true, device))
+		return 1;
+
+	Passphrase passphrase;
+	if (!get_passphrase(sOptions.keyFile, "Passphrase for the new volume: ",
+			true, passphrase)) {
+		return 1;
+	}
+
+	luks2_format_parameters parameters;
+	memset(&parameters, 0, sizeof(parameters));
+	parameters.label = sOptions.label;
+	parameters.sector_size = sOptions.sectorSize;
+	parameters.key_size = sOptions.keyBits / 8;
+	parameters.digest_iterations = choose_digest_iterations();
+	if (!choose_kdf(parameters.kdf))
+		return 1;
+
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize;
+	int result = luks2_format(&device.io, &parameters, passphrase.data,
+		passphrase.length, key, &keySize);
+	luks2_wipe(key, sizeof(key));
+	if (result != LUKS2_OK) {
+		fprintf(stderr, "%s: formatting %s failed: %s\n", kProgramName, path,
+			luks2_error_string(result));
+		return 1;
+	}
+	fsync(device.fd);
+	close(device.fd);
+
+	printf("%s: LUKS2, aes-xts-plain64 (%u bits), sector size %u, keyslot 0: ",
+		path, parameters.key_size * 8,
+		parameters.sector_size != 0 ? parameters.sector_size : 512);
+	print_kdf(parameters.kdf);
+	printf("\n");
+	return 0;
+}
+
+
+static void
+print_size(uint64_t bytes)
+{
+	const char* units[] = { "bytes", "KiB", "MiB", "GiB", "TiB" };
+	double size = bytes;
+	int unit = 0;
+	while (size >= 1024 && unit < 4) {
+		size /= 1024;
+		unit++;
+	}
+	printf(unit == 0 ? "%.0f %s" : "%.1f %s", size, units[unit]);
+}
+
+
+static int
+command_dump(const char* path)
+{
+	Device device;
+	luks2_volume* volume = open_volume(path, false, device);
+	if (volume == NULL)
+		return 1;
+
+	printf("LUKS2 volume %s\n", path);
+	printf("  UUID:          %s\n", volume->uuid);
+	printf("  label:         %s\n", volume->label[0] ? volume->label
+		: "(none)");
+	printf("  header:        %llu bytes, sequence %llu, %s%s\n",
+		(unsigned long long)volume->header_size,
+		(unsigned long long)volume->sequence_id,
+		volume->primary_valid ? "primary ok" : "PRIMARY DAMAGED",
+		volume->secondary_valid ? ", secondary ok" : ", SECONDARY DAMAGED");
+	printf("  data:          offset %llu, ",
+		(unsigned long long)volume->segment.offset);
+	print_size(volume->segment.size);
+	printf("%s, sector size %u, aes-xts-plain64 %u bits%s\n",
+		volume->segment.dynamic ? " (to the end)" : "",
+		volume->segment.sector_size, volume->segment.key_size * 8,
+		volume->allow_discards ? ", discards allowed" : "");
+	for (int i = 0; i < LUKS2_MAX_KEYSLOTS; i++) {
+		const luks2_keyslot& keyslot = volume->keyslots[i];
+		if (!keyslot.used)
+			continue;
+		printf("  keyslot %2d:    ", i);
+		if (!keyslot.supported) {
+			printf("not supported by this implementation\n");
+			continue;
+		}
+		print_kdf(keyslot.kdf);
+		printf(", %u stripes, priority %d\n", keyslot.stripes,
+			keyslot.priority);
+	}
+	luks2_free_volume(volume);
+	close(device.fd);
+	return 0;
+}
+
+
+static int
+unlock_volume(luks2_volume* volume, Device& device, uint8_t* key,
+	size_t* _keySize, int* _keyslot)
+{
+	Passphrase passphrase;
+	if (!get_passphrase(sOptions.keyFile, "Passphrase: ", false, passphrase))
+		return LUKS2_ERROR_BAD_PASSPHRASE;
+	int result = luks2_unlock(volume, &device.io, passphrase.data,
+		passphrase.length, sOptions.keySlot, key, _keySize, _keyslot);
+	if (result != LUKS2_OK) {
+		fprintf(stderr, "%s: %s\n", kProgramName, luks2_error_string(result));
+	}
+	return result;
+}
+
+
+static int
+command_test(const char* path)
+{
+	Device device;
+	luks2_volume* volume = open_volume(path, false, device);
+	if (volume == NULL)
+		return 1;
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize;
+	int keyslot;
+	int result = unlock_volume(volume, device, key, &keySize, &keyslot);
+	luks2_wipe(key, sizeof(key));
+	luks2_free_volume(volume);
+	close(device.fd);
+	if (result != LUKS2_OK)
+		return 2;
+	printf("keyslot %d opens %s\n", keyslot, path);
+	return 0;
+}
+
+
+static int
+command_add_key(const char* path)
+{
+	Device device;
+	luks2_volume* volume = open_volume(path, true, device);
+	if (volume == NULL)
+		return 1;
+
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize;
+	int oldSlot;
+	int result = unlock_volume(volume, device, key, &keySize, &oldSlot);
+	if (result != LUKS2_OK) {
+		luks2_free_volume(volume);
+		return 2;
+	}
+
+	Passphrase newPassphrase;
+	luks2_kdf kdf;
+	int slot = -1;
+	if (!get_passphrase(sOptions.newKeyFile, "New passphrase: ", true,
+			newPassphrase) || !choose_kdf(kdf)) {
+		result = LUKS2_ERROR_BAD_PASSPHRASE;
+	} else {
+		// sOptions.keySlot was the slot to open; the new one is the first free
+		result = luks2_add_keyslot(volume, &device.io, key, keySize,
+			newPassphrase.data, newPassphrase.length, &kdf, -1, &slot);
+	}
+	luks2_wipe(key, sizeof(key));
+	luks2_free_volume(volume);
+	fsync(device.fd);
+	close(device.fd);
+	if (result != LUKS2_OK) {
+		fprintf(stderr, "%s: adding a keyslot failed: %s\n", kProgramName,
+			luks2_error_string(result));
+		return 1;
+	}
+	printf("keyslot %d added: ", slot);
+	print_kdf(kdf);
+	printf("\n");
+	return 0;
+}
+
+
+static int
+command_remove_key(const char* path, int slotToRemove)
+{
+	Device device;
+	luks2_volume* volume = open_volume(path, true, device);
+	if (volume == NULL)
+		return 1;
+
+	// The passphrase proves the right to change the volume; without a slot
+	// argument, the keyslot it opens is the one removed.
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize;
+	int openedSlot;
+	int result = unlock_volume(volume, device, key, &keySize, &openedSlot);
+	luks2_wipe(key, sizeof(key));
+	if (result != LUKS2_OK) {
+		luks2_free_volume(volume);
+		return 2;
+	}
+	if (slotToRemove < 0)
+		slotToRemove = openedSlot;
+
+	int remaining = 0;
+	for (int i = 0; i < LUKS2_MAX_KEYSLOTS; i++) {
+		if (volume->keyslots[i].used && i != slotToRemove)
+			remaining++;
+	}
+	if (remaining == 0 && !sOptions.force) {
+		fprintf(stderr, "%s: keyslot %d is the last one; without it the "
+			"volume can't be opened any more. Use --force to remove it "
+			"anyway.\n", kProgramName, slotToRemove);
+		luks2_free_volume(volume);
+		return 1;
+	}
+
+	result = luks2_remove_keyslot(volume, &device.io, slotToRemove);
+	luks2_free_volume(volume);
+	fsync(device.fd);
+	close(device.fd);
+	if (result != LUKS2_OK) {
+		fprintf(stderr, "%s: removing keyslot %d failed: %s\n", kProgramName,
+			slotToRemove, luks2_error_string(result));
+		return 1;
+	}
+	printf("keyslot %d removed\n", slotToRemove);
+	return 0;
+}
+
+
+/*!	"read": decrypts the data segment into a file; "write": encrypts a file
+	into the data segment (to make encrypted images on the build host). */
+static int
+command_copy(const char* path, const char* file, bool write)
+{
+	Device device;
+	luks2_volume* volume = open_volume(path, write, device);
+	if (volume == NULL)
+		return 1;
+
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize;
+	int result = unlock_volume(volume, device, key, &keySize, NULL);
+	luks2_xts xts;
+	if (result == LUKS2_OK)
+		result = luks2_setup_cipher(volume, key, keySize, &xts);
+	luks2_wipe(key, sizeof(key));
+	if (result != LUKS2_OK) {
+		luks2_free_volume(volume);
+		return 2;
+	}
+
+	int fileFD = write ? open(file, O_RDONLY)
+		: open(file, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (fileFD < 0) {
+		fprintf(stderr, "%s: can't open %s: %s\n", kProgramName, file,
+			strerror(errno));
+		luks2_xts_clear(&xts);
+		luks2_free_volume(volume);
+		return 1;
+	}
+
+	uint64_t total = volume->segment.size;
+	if (write) {
+		struct stat st;
+		if (fstat(fileFD, &st) == 0 && (uint64_t)st.st_size < total)
+			total = st.st_size;
+		if (total % volume->segment.sector_size != 0) {
+			fprintf(stderr, "%s: %s isn't a whole number of %u-byte "
+				"sectors\n", kProgramName, file, volume->segment.sector_size);
+			total = 0;
+			result = LUKS2_ERROR_BAD_ARGUMENT;
+		}
+	}
+
+	const size_t bufferSize = 1024 * 1024;
+	uint8_t* buffer = (uint8_t*)malloc(bufferSize);
+	uint32_t sectorSize = volume->segment.sector_size;
+	for (uint64_t offset = 0; buffer != NULL && offset < total
+			&& result == LUKS2_OK;) {
+		size_t length = total - offset < bufferSize
+			? (size_t)(total - offset) : bufferSize;
+		if (write) {
+			if (pread(fileFD, buffer, length, offset) != (ssize_t)length) {
+				result = LUKS2_ERROR_IO;
+				break;
+			}
+			for (size_t i = 0; i < length; i += sectorSize) {
+				luks2_xts_encrypt(&xts, luks2_sector_iv(volume, offset + i),
+					buffer + i, sectorSize);
+			}
+			if (pwrite(device.fd, buffer, length,
+					volume->segment.offset + offset) != (ssize_t)length)
+				result = LUKS2_ERROR_IO;
+		} else {
+			if (pread(device.fd, buffer, length,
+					volume->segment.offset + offset) != (ssize_t)length) {
+				result = LUKS2_ERROR_IO;
+				break;
+			}
+			for (size_t i = 0; i < length; i += sectorSize) {
+				luks2_xts_decrypt(&xts, luks2_sector_iv(volume, offset + i),
+					buffer + i, sectorSize);
+			}
+			if (pwrite(fileFD, buffer, length, offset) != (ssize_t)length)
+				result = LUKS2_ERROR_IO;
+		}
+		offset += length;
+	}
+	if (buffer != NULL) {
+		luks2_wipe(buffer, bufferSize);
+		free(buffer);
+	} else
+		result = LUKS2_ERROR_NO_MEMORY;
+
+	luks2_xts_clear(&xts);
+	luks2_free_volume(volume);
+	if (write)
+		fsync(device.fd);
+	else
+		fsync(fileFD);
+	close(fileFD);
+	close(device.fd);
+	if (result != LUKS2_OK) {
+		fprintf(stderr, "%s: %s\n", kProgramName, luks2_error_string(result));
+		return 1;
+	}
+	return 0;
+}
+
+
+#ifdef __HAIKU__
+
+
+static int
+open_control_device()
+{
+	int fd = open("/dev/" LUKS2_CONTROL_DEVICE_NAME, O_RDONLY);
+	if (fd < 0) {
+		fprintf(stderr, "%s: can't open the luks driver's control device: "
+			"%s\n", kProgramName, strerror(errno));
+	}
+	return fd;
+}
+
+
+static int
+command_open(const char* path)
+{
+	Device device;
+	luks2_volume* volume = open_volume(path, false, device);
+	if (volume == NULL)
+		return 1;
+
+	luks2_open_request request;
+	memset(&request, 0, sizeof(request));
+	size_t keySize;
+	int result = unlock_volume(volume, device, request.key, &keySize, NULL);
+	luks2_free_volume(volume);
+	close(device.fd);
+	if (result != LUKS2_OK) {
+		luks2_wipe(&request, sizeof(request));
+		return 2;
+	}
+
+	request.version = LUKS2_DRIVER_INTERFACE_VERSION;
+	request.flags = sOptions.readOnly ? LUKS2_OPEN_READ_ONLY : 0;
+	request.key_size = keySize;
+	if (realpath(path, request.path) == NULL)
+		strlcpy(request.path, path, sizeof(request.path));
+
+	int control = open_control_device();
+	if (control < 0) {
+		luks2_wipe(&request, sizeof(request));
+		return 1;
+	}
+	status_t status = ioctl(control, LUKS2_IOCTL_OPEN, &request,
+		sizeof(request));
+	if (status != 0)
+		status = errno;
+	close(control);
+	luks2_wipe(request.key, sizeof(request.key));
+	if (status != B_OK) {
+		fprintf(stderr, "%s: opening %s failed: %s\n", kProgramName, path,
+			strerror(status));
+		return 1;
+	}
+	printf("%s\n", request.device);
+	return 0;
+}
+
+
+static int32
+device_id_from_argument(const char* argument)
+{
+	// a number, or a path like /dev/disk/virtual/luks/<id>/raw
+	const char* start = argument;
+	const char* base = strstr(argument, "luks/");
+	if (base != NULL)
+		start = base + 5;
+	char* end;
+	long id = strtol(start, &end, 10);
+	if (end == start || id < 0 || id >= LUKS2_MAX_DEVICES)
+		return -1;
+	return (int32)id;
+}
+
+
+static int
+command_close(const char* argument)
+{
+	int32 id = device_id_from_argument(argument);
+	if (id < 0) {
+		fprintf(stderr, "%s: \"%s\" isn't a luks device\n", kProgramName,
+			argument);
+		return 1;
+	}
+	int control = open_control_device();
+	if (control < 0)
+		return 1;
+	luks2_close_request request = { LUKS2_DRIVER_INTERFACE_VERSION, id };
+	status_t status = ioctl(control, LUKS2_IOCTL_CLOSE, &request,
+		sizeof(request));
+	if (status != 0)
+		status = errno;
+	close(control);
+	if (status != B_OK) {
+		fprintf(stderr, "%s: closing device %d failed: %s\n", kProgramName,
+			(int)id, strerror(status));
+		return 1;
+	}
+	return 0;
+}
+
+
+static int
+command_list()
+{
+	int control = open_control_device();
+	if (control < 0)
+		return 1;
+	luks2_device_info info;
+	int32 id = 0;
+	int count = 0;
+	while (true) {
+		memset(&info, 0, sizeof(info));
+		info.version = LUKS2_DRIVER_INTERFACE_VERSION;
+		info.id = id;
+		if (ioctl(control, LUKS2_IOCTL_GET_INFO, &info, sizeof(info)) != 0)
+			break;
+		printf("%s\n  from %s\n  UUID %s%s%s, ", info.device, info.path,
+			info.uuid, info.label[0] ? ", label " : "", info.label);
+		print_size(info.size);
+		printf(", sector size %u, AES-%u-XTS (%s)%s, %d open\n",
+			info.sector_size, info.key_bits / 2, info.implementation,
+			(info.flags & LUKS2_OPEN_READ_ONLY) != 0 ? ", read-only" : "",
+			(int)info.open_count);
+		id = info.id + 1;
+		count++;
+	}
+	close(control);
+	if (count == 0)
+		printf("No open LUKS2 volumes.\n");
+	return 0;
+}
+
+
+#endif	// __HAIKU__
+
+
+static void
+usage(int exitCode)
+{
+	fprintf(exitCode == 0 ? stdout : stderr,
+		"Usage: %s <command> [options] <arguments>\n"
+		"\n"
+		"Commands:\n"
+		"  format <device>           create a LUKS2 volume (destroys data)\n"
+		"  dump <device>             show the header and keyslots\n"
+		"  test <device>             check a passphrase\n"
+		"  addkey <device>           add a passphrase\n"
+		"  removekey <device> [slot] remove the passphrase's keyslot, or the\n"
+		"                            given one (asks for any passphrase)\n"
+#ifdef __HAIKU__
+		"  open <device>             unlock; prints the decrypted device\n"
+		"  close <id|device>         lock an open volume again\n"
+		"  list                      show the open volumes\n"
+#endif
+		"  read <device> <file>      decrypt the data area into a file\n"
+		"  write <device> <file>     encrypt a file into the data area\n"
+		"\n"
+		"Options:\n"
+		"  -k, --key-file <file>     passphrase from a file (\"-\": stdin)\n"
+		"      --new-key-file <file> new passphrase for addkey\n"
+		"  -S, --key-slot <n>        keyslot to try\n"
+		"  -L, --label <label>       label for format\n"
+		"      --sector-size <n>     512 (default) to 4096\n"
+		"      --key-size <bits>     512 (AES-256-XTS, default) or 256\n"
+		"      --pbkdf <kdf>         argon2id (default), argon2i or pbkdf2\n"
+		"      --iter-time <ms>      KDF time to aim for (default 2000)\n"
+		"      --memory <KiB>        Argon2 memory\n"
+		"      --parallel <n>        Argon2 lanes (default 4)\n"
+		"      --time <n>            Argon2 passes\n"
+		"      --iterations <n>      PBKDF2 iterations\n"
+		"  -r, --read-only           open read-only\n"
+		"      --force               allow removing the last keyslot\n"
+		"  -y, --yes                 don't ask before formatting\n"
+		"\n"
+		"The crypto code is unreviewed: keep backups of encrypted data.\n",
+		kProgramName);
+	exit(exitCode);
+}
+
+
+int
+main(int argc, char** argv)
+{
+	enum {
+		kOptionNewKeyFile = 256, kOptionSectorSize, kOptionKeySize,
+		kOptionPBKDF, kOptionIterTime, kOptionMemory, kOptionParallel,
+		kOptionTime, kOptionIterations, kOptionForce, kOptionDigestIterations
+	};
+	static const struct option kOptions[] = {
+		{ "key-file", required_argument, NULL, 'k' },
+		{ "new-key-file", required_argument, NULL, kOptionNewKeyFile },
+		{ "key-slot", required_argument, NULL, 'S' },
+		{ "label", required_argument, NULL, 'L' },
+		{ "sector-size", required_argument, NULL, kOptionSectorSize },
+		{ "key-size", required_argument, NULL, kOptionKeySize },
+		{ "pbkdf", required_argument, NULL, kOptionPBKDF },
+		{ "iter-time", required_argument, NULL, kOptionIterTime },
+		{ "memory", required_argument, NULL, kOptionMemory },
+		{ "parallel", required_argument, NULL, kOptionParallel },
+		{ "time", required_argument, NULL, kOptionTime },
+		{ "iterations", required_argument, NULL, kOptionIterations },
+		{ "digest-iterations", required_argument, NULL,
+			kOptionDigestIterations },
+		{ "read-only", no_argument, NULL, 'r' },
+		{ "force", no_argument, NULL, kOptionForce },
+		{ "yes", no_argument, NULL, 'y' },
+		{ "help", no_argument, NULL, 'h' },
+		{ NULL, 0, NULL, 0 }
+	};
+
+	sOptions.keySlot = -1;
+	sOptions.sectorSize = 512;
+	sOptions.keyBits = 512;
+	sOptions.kdfType = LUKS2_KDF_ARGON2ID;
+	sOptions.iterTime = 2000;
+
+	int option;
+	while ((option = getopt_long(argc, argv, "k:S:L:ryh", kOptions, NULL))
+			!= -1) {
+		switch (option) {
+			case 'k':
+				sOptions.keyFile = optarg;
+				break;
+			case kOptionNewKeyFile:
+				sOptions.newKeyFile = optarg;
+				break;
+			case 'S':
+				sOptions.keySlot = atoi(optarg);
+				if (sOptions.keySlot < 0
+					|| sOptions.keySlot >= LUKS2_MAX_KEYSLOTS)
+					usage(1);
+				break;
+			case 'L':
+				sOptions.label = optarg;
+				break;
+			case kOptionSectorSize:
+				sOptions.sectorSize = strtoul(optarg, NULL, 0);
+				break;
+			case kOptionKeySize:
+				sOptions.keyBits = strtoul(optarg, NULL, 0);
+				if (sOptions.keyBits != 256 && sOptions.keyBits != 512)
+					usage(1);
+				break;
+			case kOptionPBKDF:
+				if (strcmp(optarg, "argon2id") == 0)
+					sOptions.kdfType = LUKS2_KDF_ARGON2ID;
+				else if (strcmp(optarg, "argon2i") == 0)
+					sOptions.kdfType = LUKS2_KDF_ARGON2I;
+				else if (strcmp(optarg, "pbkdf2") == 0)
+					sOptions.kdfType = LUKS2_KDF_PBKDF2;
+				else
+					usage(1);
+				break;
+			case kOptionIterTime:
+				sOptions.iterTime = strtoul(optarg, NULL, 0);
+				break;
+			case kOptionMemory:
+				sOptions.memory = strtoul(optarg, NULL, 0);
+				break;
+			case kOptionParallel:
+				sOptions.parallel = strtoul(optarg, NULL, 0);
+				break;
+			case kOptionTime:
+				sOptions.time = strtoul(optarg, NULL, 0);
+				break;
+			case kOptionIterations:
+				sOptions.iterations = strtoul(optarg, NULL, 0);
+				break;
+			case kOptionDigestIterations:
+				sOptions.digestIterations = strtoul(optarg, NULL, 0);
+				break;
+			case 'r':
+				sOptions.readOnly = true;
+				break;
+			case kOptionForce:
+				sOptions.force = true;
+				break;
+			case 'y':
+				sOptions.yes = true;
+				break;
+			case 'h':
+				usage(0);
+				break;
+			default:
+				usage(1);
+				break;
+		}
+	}
+
+	if (optind >= argc)
+		usage(1);
+	const char* command = argv[optind++];
+	int arguments = argc - optind;
+	char** argument = argv + optind;
+
+	if (strcmp(command, "format") == 0 && arguments == 1)
+		return command_format(argument[0]);
+	if (strcmp(command, "dump") == 0 && arguments == 1)
+		return command_dump(argument[0]);
+	if (strcmp(command, "test") == 0 && arguments == 1)
+		return command_test(argument[0]);
+	if (strcmp(command, "addkey") == 0 && arguments == 1)
+		return command_add_key(argument[0]);
+	if (strcmp(command, "removekey") == 0
+		&& (arguments == 1 || arguments == 2)) {
+		int slot = -1;
+		if (arguments == 2) {
+			slot = atoi(argument[1]);
+			if (slot < 0 || slot >= LUKS2_MAX_KEYSLOTS)
+				usage(1);
+		}
+		return command_remove_key(argument[0], slot);
+	}
+	if (strcmp(command, "read") == 0 && arguments == 2)
+		return command_copy(argument[0], argument[1], false);
+	if (strcmp(command, "write") == 0 && arguments == 2)
+		return command_copy(argument[0], argument[1], true);
+#ifdef __HAIKU__
+	if (strcmp(command, "open") == 0 && arguments == 1)
+		return command_open(argument[0]);
+	if (strcmp(command, "close") == 0 && arguments == 1)
+		return command_close(argument[0]);
+	if (strcmp(command, "list") == 0 && arguments == 0)
+		return command_list();
+#endif
+	usage(1);
+	return 1;
+}
diff --git a/src/libs/luks2/arch/x86/aes_ni.cpp b/src/libs/luks2/arch/x86/aes_ni.cpp
new file mode 100644
index 0000000000..c41458a151
--- /dev/null
+++ b/src/libs/luks2/arch/x86/aes_ni.cpp
@@ -0,0 +1,210 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	AES-NI for x86_64: the optional accelerator behind luks2_aes. The key
+	expansion is the portable constant-time one; this only runs the rounds.
+	Only the functions marked AESNI_TARGET use SSE/AES instructions, so the
+	file needs no special compiler flags, and they take and return only
+	pointers, so callers without SSE enabled are safe.
+*/
+
+
+#include "../../crypto/luks2_crypto_internal.h"
+
+#include <string.h>
+
+
+#ifdef LUKS2_HAVE_AES_ACCELERATOR
+
+
+typedef long long aes_vector __attribute__((vector_size(16)));
+
+#define AESNI_TARGET __attribute__((target("aes,sse2")))
+
+
+static void
+cpuid(uint32_t leaf, uint32_t* eax, uint32_t* ebx, uint32_t* ecx,
+	uint32_t* edx)
+{
+	__asm__ __volatile__("cpuid"
+		: "=a"(*eax), "=b"(*ebx), "=c"(*ecx), "=d"(*edx)
+		: "a"(leaf), "c"(0));
+}
+
+
+extern "C" int
+luks2_aes_accel_probe(void)
+{
+	static int sProbed = -1;
+	if (sProbed >= 0)
+		return sProbed;
+
+	uint32_t eax, ebx, ecx, edx;
+	cpuid(0, &eax, &ebx, &ecx, &edx);
+	int result = LUKS2_AES_PORTABLE;
+	if (eax >= 1) {
+		cpuid(1, &eax, &ebx, &ecx, &edx);
+		bool hasAES = (ecx & (1u << 25)) != 0;
+		bool hasSSE2 = (edx & (1u << 26)) != 0;
+		if (hasAES && hasSSE2)
+			result = LUKS2_AES_X86_AESNI;
+	}
+	sProbed = result;
+	return result;
+}
+
+
+AESNI_TARGET static void
+make_decryption_keys(uint8_t* decryption, const uint8_t* encryption,
+	unsigned rounds)
+{
+	aes_vector key;
+	memcpy(decryption, encryption + rounds * 16, 16);
+	for (unsigned i = 1; i < rounds; i++) {
+		memcpy(&key, encryption + (rounds - i) * 16, 16);
+		key = __builtin_ia32_aesimc128(key);
+		memcpy(decryption + i * 16, &key, 16);
+	}
+	memcpy(decryption + rounds * 16, encryption, 16);
+	key = (aes_vector){0, 0};
+}
+
+
+extern "C" void
+luks2_aes_accel_set_key(luks2_aes* aes, const uint32_t* roundKeys,
+	unsigned rounds)
+{
+	for (unsigned i = 0; i < (rounds + 1) * 4; i++)
+		luks2_store32le(aes->round_keys[0] + i * 4, roundKeys[i]);
+	make_decryption_keys(aes->round_keys[1], aes->round_keys[0], rounds);
+}
+
+
+AESNI_TARGET static void
+encrypt_blocks(const uint8_t* keys, unsigned rounds, const uint8_t* in,
+	uint8_t* out, size_t blocks)
+{
+	aes_vector k[15];
+	for (unsigned i = 0; i <= rounds; i++)
+		memcpy(&k[i], keys + i * 16, 16);
+
+	while (blocks >= 4) {
+		aes_vector b0, b1, b2, b3;
+		memcpy(&b0, in, 16);
+		memcpy(&b1, in + 16, 16);
+		memcpy(&b2, in + 32, 16);
+		memcpy(&b3, in + 48, 16);
+		b0 ^= k[0];
+		b1 ^= k[0];
+		b2 ^= k[0];
+		b3 ^= k[0];
+		for (unsigned r = 1; r < rounds; r++) {
+			b0 = __builtin_ia32_aesenc128(b0, k[r]);
+			b1 = __builtin_ia32_aesenc128(b1, k[r]);
+			b2 = __builtin_ia32_aesenc128(b2, k[r]);
+			b3 = __builtin_ia32_aesenc128(b3, k[r]);
+		}
+		b0 = __builtin_ia32_aesenclast128(b0, k[rounds]);
+		b1 = __builtin_ia32_aesenclast128(b1, k[rounds]);
+		b2 = __builtin_ia32_aesenclast128(b2, k[rounds]);
+		b3 = __builtin_ia32_aesenclast128(b3, k[rounds]);
+		memcpy(out, &b0, 16);
+		memcpy(out + 16, &b1, 16);
+		memcpy(out + 32, &b2, 16);
+		memcpy(out + 48, &b3, 16);
+		in += 64;
+		out += 64;
+		blocks -= 4;
+	}
+
+	while (blocks > 0) {
+		aes_vector b;
+		memcpy(&b, in, 16);
+		b ^= k[0];
+		for (unsigned r = 1; r < rounds; r++)
+			b = __builtin_ia32_aesenc128(b, k[r]);
+		b = __builtin_ia32_aesenclast128(b, k[rounds]);
+		memcpy(out, &b, 16);
+		in += 16;
+		out += 16;
+		blocks--;
+	}
+
+	luks2_wipe(k, sizeof(k));
+}
+
+
+AESNI_TARGET static void
+decrypt_blocks(const uint8_t* keys, unsigned rounds, const uint8_t* in,
+	uint8_t* out, size_t blocks)
+{
+	aes_vector k[15];
+	for (unsigned i = 0; i <= rounds; i++)
+		memcpy(&k[i], keys + i * 16, 16);
+
+	while (blocks >= 4) {
+		aes_vector b0, b1, b2, b3;
+		memcpy(&b0, in, 16);
+		memcpy(&b1, in + 16, 16);
+		memcpy(&b2, in + 32, 16);
+		memcpy(&b3, in + 48, 16);
+		b0 ^= k[0];
+		b1 ^= k[0];
+		b2 ^= k[0];
+		b3 ^= k[0];
+		for (unsigned r = 1; r < rounds; r++) {
+			b0 = __builtin_ia32_aesdec128(b0, k[r]);
+			b1 = __builtin_ia32_aesdec128(b1, k[r]);
+			b2 = __builtin_ia32_aesdec128(b2, k[r]);
+			b3 = __builtin_ia32_aesdec128(b3, k[r]);
+		}
+		b0 = __builtin_ia32_aesdeclast128(b0, k[rounds]);
+		b1 = __builtin_ia32_aesdeclast128(b1, k[rounds]);
+		b2 = __builtin_ia32_aesdeclast128(b2, k[rounds]);
+		b3 = __builtin_ia32_aesdeclast128(b3, k[rounds]);
+		memcpy(out, &b0, 16);
+		memcpy(out + 16, &b1, 16);
+		memcpy(out + 32, &b2, 16);
+		memcpy(out + 48, &b3, 16);
+		in += 64;
+		out += 64;
+		blocks -= 4;
+	}
+
+	while (blocks > 0) {
+		aes_vector b;
+		memcpy(&b, in, 16);
+		b ^= k[0];
+		for (unsigned r = 1; r < rounds; r++)
+			b = __builtin_ia32_aesdec128(b, k[r]);
+		b = __builtin_ia32_aesdeclast128(b, k[rounds]);
+		memcpy(out, &b, 16);
+		in += 16;
+		out += 16;
+		blocks--;
+	}
+
+	luks2_wipe(k, sizeof(k));
+}
+
+
+extern "C" void
+luks2_aes_accel_encrypt(const luks2_aes* aes, const uint8_t* in, uint8_t* out,
+	size_t blocks)
+{
+	encrypt_blocks(aes->round_keys[0], aes->rounds, in, out, blocks);
+}
+
+
+extern "C" void
+luks2_aes_accel_decrypt(const luks2_aes* aes, const uint8_t* in, uint8_t* out,
+	size_t blocks)
+{
+	decrypt_blocks(aes->round_keys[1], aes->rounds, in, out, blocks);
+}
+
+
+#endif	// LUKS2_HAVE_AES_ACCELERATOR
diff --git a/src/libs/luks2/crypto/aes_ct.c b/src/libs/luks2/crypto/aes_ct.c
