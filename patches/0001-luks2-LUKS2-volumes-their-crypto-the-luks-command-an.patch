+
+
+/*!	Creating LUKS2 volumes and adding or removing keyslots, for the tools.
+	Not built into the kernel driver or the boot loader, which never write
+	headers. Needs luks2_random() from the program that links it.
+*/
+
+
+#include "luks2_internal.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+namespace {
+
+
+bool
+write_fully(const luks2_device_io* io, uint64_t offset, const void* buffer,
+	size_t size)
+{
+	if (offset > io->size || io->size - offset < size)
+		return false;
+	return io->write(io->cookie, offset, buffer, size) == (ssize_t)size;
+}
+
+
+luks2_json*
+new_string(const char* text)
+{
+	return luks2_json_new(LUKS2_JSON_STRING, text);
+}
+
+
+luks2_json*
+new_object()
+{
+	return luks2_json_new(LUKS2_JSON_OBJECT, NULL);
+}
+
+
+luks2_json*
+new_base64(const uint8_t* data, size_t length)
+{
+	char text[4 * ((LUKS2_SALT_SIZE + 2) / 3) + 1];
+	if (length > LUKS2_SALT_SIZE)
+		return NULL;
+	luks2_base64_encode(data, length, text);
+	return new_string(text);
+}
+
+
+void
+index_string(int index, char* buffer)
+{
+	snprintf(buffer, 4, "%d", index);
+}
+
+
+/*!	Writes both header copies from volume->json with the next sequence ID
+	and a fresh salt for each copy. */
+int
+write_headers(luks2_volume* volume, const luks2_device_io* io)
+{
+	size_t size = (size_t)volume->header_size;
+	uint8_t* area = (uint8_t*)calloc(1, size);
+	if (area == NULL)
+		return LUKS2_ERROR_NO_MEMORY;
+
+	ssize_t jsonLength = luks2_json_serialize(volume->json,
+		(char*)area + LUKS2_BINARY_HEADER_SIZE,
+		size - LUKS2_BINARY_HEADER_SIZE);
+	if (jsonLength < 0) {
+		free(area);
+		return LUKS2_ERROR_NO_KEYSLOT;
+			// the metadata doesn't fit into the JSON area
+	}
+
+	uint64_t sequenceID = volume->sequence_id + 1;
+	int result = LUKS2_OK;
+	for (int copy = 0; copy < 2 && result == LUKS2_OK; copy++) {
+		uint64_t offset = copy == 0 ? 0 : volume->header_size;
+		memset(area, 0, LUKS2_BINARY_HEADER_SIZE);
+		memcpy(area + LUKS2_OFFSET_MAGIC,
+			copy == 0 ? kLUKS2PrimaryMagic : kLUKS2SecondaryMagic,
+			LUKS2_MAGIC_SIZE);
+		area[LUKS2_OFFSET_VERSION + 1] = 2;
+		luks2_store64be(area + LUKS2_OFFSET_HEADER_SIZE, volume->header_size);
+		luks2_store64be(area + LUKS2_OFFSET_SEQUENCE_ID, sequenceID);
+		memcpy(area + LUKS2_OFFSET_LABEL, volume->label,
+			strnlen(volume->label, LUKS2_LABEL_SIZE - 1));
+		strcpy((char*)area + LUKS2_OFFSET_CHECKSUM_ALG, "sha256");
+		if (luks2_random(area + LUKS2_OFFSET_SALT, LUKS2_SALT_SIZE) != 0) {
+			result = LUKS2_ERROR_RANDOM;
+			break;
+		}
+		memcpy(area + LUKS2_OFFSET_UUID, volume->uuid,
+			strnlen(volume->uuid, LUKS2_UUID_SIZE - 1));
+		memcpy(area + LUKS2_OFFSET_SUBSYSTEM, volume->subsystem,
+			strnlen(volume->subsystem, LUKS2_LABEL_SIZE - 1));
+		luks2_store64be(area + LUKS2_OFFSET_HEADER_OFFSET, offset);
+
+		luks2_sha256 hash;
+		luks2_sha256_init(&hash);
+		luks2_sha256_update(&hash, area, size);
+		luks2_sha256_final(&hash, area + LUKS2_OFFSET_CHECKSUM);
+
+		if (!write_fully(io, offset, area, size))
+			result = LUKS2_ERROR_IO;
+	}
+
+	free(area);
+	if (result == LUKS2_OK) {
+		volume->sequence_id = sequenceID;
+		volume->header_hash = LUKS2_HASH_SHA256;
+		volume->primary_valid = true;
+		volume->secondary_valid = true;
+	}
+	return result;
+}
+
+
+/*!	Finds room for a keyslot area of \a size bytes in the keyslots area. */
+bool
+find_area(const luks2_volume* volume, uint64_t size, uint64_t* _offset)
+{
+	uint64_t start = 2 * volume->header_size;
+	uint64_t end = start + volume->keyslots_size;
+
+	for (uint64_t candidate = start; candidate + size <= end;) {
+		bool overlaps = false;
+		for (int i = 0; i < LUKS2_MAX_KEYSLOTS; i++) {
+			const luks2_keyslot& keyslot = volume->keyslots[i];
+			if (!keyslot.used)
+				continue;
+			if (candidate < keyslot.area_offset + keyslot.area_size
+				&& keyslot.area_offset < candidate + size) {
+				candidate = luks2_round_up(
+					keyslot.area_offset + keyslot.area_size, 4096);
+				overlaps = true;
+				break;
+			}
+		}
+		if (!overlaps) {
+			*_offset = candidate;
+			return true;
+		}
+	}
+	return false;
+}
+
+
+luks2_json*
+make_kdf_json(const luks2_kdf& kdf)
+{
+	luks2_json* object = new_object();
+	if (object == NULL)
+		return NULL;
+	bool ok;
+	if (kdf.type == LUKS2_KDF_PBKDF2) {
+		ok = luks2_json_set(object, "type", new_string("pbkdf2"))
+			&& luks2_json_set(object, "hash",
+				new_string(luks2_hash_name(kdf.hash)))
+			&& luks2_json_set(object, "iterations",
+				luks2_json_new_uint64(kdf.iterations, false));
+	} else {
+		ok = luks2_json_set(object, "type", new_string(
+				kdf.type == LUKS2_KDF_ARGON2I ? "argon2i" : "argon2id"))
+			&& luks2_json_set(object, "time",
+				luks2_json_new_uint64(kdf.time, false))
+			&& luks2_json_set(object, "memory",
+				luks2_json_new_uint64(kdf.memory, false))
+			&& luks2_json_set(object, "cpus",
+				luks2_json_new_uint64(kdf.cpus, false));
+	}
+	ok = ok && luks2_json_set(object, "salt",
+		new_base64(kdf.salt, kdf.salt_length));
+	if (!ok) {
+		luks2_json_free(object);
+		return NULL;
+	}
+	return object;
+}
+
+
+bool
+valid_kdf(const luks2_kdf* kdf)
+{
+	switch (kdf->type) {
+		case LUKS2_KDF_PBKDF2:
+			return luks2_hash_name(kdf->hash) != NULL && kdf->iterations >= 1000;
+		case LUKS2_KDF_ARGON2I:
+		case LUKS2_KDF_ARGON2ID:
+			return kdf->time >= 1 && kdf->cpus >= 1 && kdf->cpus <= 64
+				&& kdf->memory >= 8 * kdf->cpus;
+	}
+	return false;
+}
+
+
+/*!	Encrypts \a key into a new keyslot area and adds the keyslot to the
+	JSON metadata (not to the digest). */
+int
+create_keyslot(luks2_volume* volume, const luks2_device_io* io,
+	const uint8_t* key, size_t keySize, const void* passphrase,
+	size_t passphraseLength, const luks2_kdf* kdfParameters, int slot,
+	uint32_t stripes)
+{
+	luks2_kdf kdf = *kdfParameters;
+	kdf.salt_length = 32;
+	if (luks2_random(kdf.salt, kdf.salt_length) != 0)
+		return LUKS2_ERROR_RANDOM;
+
+	uint32_t areaKeySize = (uint32_t)keySize;
+	size_t materialSize = (size_t)stripes * keySize;
+	size_t encryptedSize = (size_t)luks2_round_up(materialSize,
+		LUKS2_KEYSLOT_SECTOR_SIZE);
+	uint64_t areaSize = luks2_round_up(materialSize, 4096);
+	uint64_t areaOffset;
+	if (!find_area(volume, areaSize, &areaOffset))
+		return LUKS2_ERROR_NO_KEYSLOT;
+
+	uint8_t* material = (uint8_t*)calloc(1, encryptedSize);
+	luks2_xts* xts = (luks2_xts*)malloc(sizeof(luks2_xts));
+	uint8_t areaKey[LUKS2_MAX_KEY_SIZE];
+	int result = LUKS2_OK;
+	if (material == NULL || xts == NULL)
+		result = LUKS2_ERROR_NO_MEMORY;
+
+	if (result == LUKS2_OK) {
+		result = luks2_af_split(key, keySize, stripes, LUKS2_HASH_SHA256,
+			material);
+	}
+	if (result == LUKS2_OK) {
+		result = luks2_derive_keyslot_key(&kdf, passphrase, passphraseLength,
+			areaKey, areaKeySize);
+	}
+	if (result == LUKS2_OK && luks2_xts_set_key(xts, areaKey, areaKeySize) != 0)
+		result = LUKS2_ERROR_BAD_ARGUMENT;
+	if (result == LUKS2_OK) {
+		for (size_t sector = 0;
+				sector < encryptedSize / LUKS2_KEYSLOT_SECTOR_SIZE; sector++) {
+			luks2_xts_encrypt(xts, sector,
+				material + sector * LUKS2_KEYSLOT_SECTOR_SIZE,
+				LUKS2_KEYSLOT_SECTOR_SIZE);
+		}
+		if (!write_fully(io, areaOffset, material, encryptedSize))
+			result = LUKS2_ERROR_IO;
+	}
+
+	if (xts != NULL) {
+		luks2_xts_clear(xts);
+		free(xts);
+	}
+	luks2_wipe(areaKey, sizeof(areaKey));
+	if (material != NULL) {
+		luks2_wipe(material, encryptedSize);
+		free(material);
+	}
+	if (result != LUKS2_OK)
+		return result;
+
+	// the metadata
+	luks2_json* keyslot = new_object();
+	luks2_json* af = new_object();
+	luks2_json* area = new_object();
+	luks2_json* kdfJSON = make_kdf_json(kdf);
+	bool ok = keyslot != NULL && af != NULL && area != NULL && kdfJSON != NULL
+		&& luks2_json_set(af, "type", new_string("luks1"))
+		&& luks2_json_set(af, "stripes", luks2_json_new_uint64(stripes, false))
+		&& luks2_json_set(af, "hash", new_string("sha256"))
+		&& luks2_json_set(area, "type", new_string("raw"))
+		&& luks2_json_set(area, "offset", luks2_json_new_uint64(areaOffset, true))
+		&& luks2_json_set(area, "size", luks2_json_new_uint64(areaSize, true))
+		&& luks2_json_set(area, "encryption",
+			new_string(LUKS2_CIPHER_AES_XTS_PLAIN64))
+		&& luks2_json_set(area, "key_size",
+			luks2_json_new_uint64(areaKeySize, false))
+		&& luks2_json_set(keyslot, "type", new_string("luks2"))
+		&& luks2_json_set(keyslot, "key_size",
+			luks2_json_new_uint64(keySize, false));
+	if (ok) {
+		ok = luks2_json_set(keyslot, "af", af);
+		af = NULL;
+		ok = luks2_json_set(keyslot, "area", area) && ok;
+		area = NULL;
+		ok = luks2_json_set(keyslot, "kdf", kdfJSON) && ok;
+		kdfJSON = NULL;
+	}
+	luks2_json_free(af);
+	luks2_json_free(area);
+	luks2_json_free(kdfJSON);
+
+	char name[4];
+	index_string(slot, name);
+	if (ok) {
+		ok = luks2_json_set(luks2_json_get(volume->json, "keyslots"), name,
+			keyslot);
+	} else
+		luks2_json_free(keyslot);
+	return ok ? LUKS2_OK : LUKS2_ERROR_NO_MEMORY;
+}
+
+
+void
+generate_uuid(char* uuid)
+{
+	uint8_t bytes[16];
+	if (luks2_random(bytes, sizeof(bytes)) != 0)
+		memset(bytes, 0, sizeof(bytes));
+	bytes[6] = (bytes[6] & 0x0f) | 0x40;
+	bytes[8] = (bytes[8] & 0x3f) | 0x80;
+	snprintf(uuid, LUKS2_UUID_SIZE,
+		"%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-"
+		"%02x%02x%02x%02x%02x%02x", bytes[0], bytes[1], bytes[2], bytes[3],
+		bytes[4], bytes[5], bytes[6], bytes[7], bytes[8], bytes[9], bytes[10],
+		bytes[11], bytes[12], bytes[13], bytes[14], bytes[15]);
+}
+
+
+/*!	Parses volume->json again after a change, keeping the header fields. */
+int
+refresh_volume(luks2_volume* volume, const luks2_device_io* io)
+{
+	return luks2_parse_metadata(volume, io->size);
+}
+
+
+}	// namespace
+
+
+int
+luks2_af_split(const uint8_t* key, size_t keySize, uint32_t stripes, int hash,
+	uint8_t* material)
+{
+	if (luks2_random(material, (size_t)(stripes - 1) * keySize) != 0)
+		return LUKS2_ERROR_RANDOM;
+
+	// the same chain as luks2_af_merge(), solved for the last stripe
+	uint8_t key2[LUKS2_MAX_KEY_SIZE];
+	uint8_t* last = material + (size_t)(stripes - 1) * keySize;
+	memset(last, 0, keySize);
+	luks2_af_merge(material, keySize, stripes, hash, key2);
+		// with a zero last stripe this is the chain value d
+	for (size_t j = 0; j < keySize; j++)
+		last[j] = key2[j] ^ key[j];
+	luks2_wipe(key2, sizeof(key2));
+	return LUKS2_OK;
+}
+
+
+extern "C" int
+luks2_format(const luks2_device_io* io,
+	const luks2_format_parameters* parameters, const void* passphrase,
+	size_t passphraseLength, uint8_t* keyOut, size_t* _keySize)
+{
+	if (io->write == NULL)
+		return LUKS2_ERROR_READ_ONLY;
+
+	uint32_t sectorSize = parameters->sector_size != 0
+		? parameters->sector_size : 512;
+	uint32_t keySize = parameters->key_size != 0 ? parameters->key_size : 64;
+	uint64_t headerSize = parameters->header_size != 0
+		? parameters->header_size : LUKS2_DEFAULT_HEADER_SIZE;
+	uint64_t dataOffset = parameters->data_offset != 0
+		? parameters->data_offset : LUKS2_DEFAULT_DATA_OFFSET;
+	uint32_t stripes = parameters->stripes != 0
+		? parameters->stripes : LUKS2_DEFAULT_STRIPES;
+
+	bool validHeaderSize = false;
+	for (size_t i = 0; i < kLUKS2HeaderSizeCount; i++)
+		validHeaderSize |= kLUKS2HeaderSizes[i] == headerSize;
+	if (sectorSize < 512 || sectorSize > 4096
+		|| (sectorSize & (sectorSize - 1)) != 0
+		|| (keySize != 32 && keySize != 64) || !validHeaderSize
+		|| dataOffset % 4096 != 0 || dataOffset % sectorSize != 0
+		|| dataOffset < 2 * headerSize + luks2_round_up(
+			(uint64_t)stripes * keySize, 4096)
+		|| dataOffset + sectorSize > io->size
+		|| !valid_kdf(&parameters->kdf)
+		|| (parameters->label != NULL
+			&& strlen(parameters->label) >= LUKS2_LABEL_SIZE)
+		|| (parameters->uuid != NULL
+			&& strlen(parameters->uuid) >= LUKS2_UUID_SIZE)) {
+		return LUKS2_ERROR_BAD_ARGUMENT;
+	}
+
+	luks2_volume* volume = (luks2_volume*)calloc(1, sizeof(luks2_volume));
+	if (volume == NULL)
+		return LUKS2_ERROR_NO_MEMORY;
+	volume->header_size = headerSize;
+	volume->keyslots_size = dataOffset - 2 * headerSize;
+	volume->json_size = headerSize - LUKS2_BINARY_HEADER_SIZE;
+	if (parameters->label != NULL)
+		strcpy(volume->label, parameters->label);
+	if (parameters->uuid != NULL)
+		strcpy(volume->uuid, parameters->uuid);
+	else
+		generate_uuid(volume->uuid);
+
+	// the volume key and its digest
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	uint8_t digestSalt[32];
+	uint8_t digest[LUKS2_SHA256_DIGEST_SIZE];
+	uint32_t digestIterations = parameters->digest_iterations != 0
+		? parameters->digest_iterations : LUKS2_DEFAULT_DIGEST_ITERATIONS;
+	if (digestIterations < 1000)
+		digestIterations = 1000;
+	int result = LUKS2_OK;
+	if (luks2_random(key, keySize) != 0
+		|| luks2_random(digestSalt, sizeof(digestSalt)) != 0) {
+		result = LUKS2_ERROR_RANDOM;
+	}
+	if (result == LUKS2_OK) {
+		luks2_pbkdf2(LUKS2_HASH_SHA256, key, keySize, digestSalt,
+			sizeof(digestSalt), digestIterations, digest, sizeof(digest));
+	}
+
+	// the metadata, cryptsetup's layout
+	luks2_json* root = new_object();
+	luks2_json* segments = new_object();
+	luks2_json* segment = new_object();
+	luks2_json* digests = new_object();
+	luks2_json* digestObject = new_object();
+	luks2_json* digestKeyslots = luks2_json_new(LUKS2_JSON_ARRAY, NULL);
+	luks2_json* digestSegments = luks2_json_new(LUKS2_JSON_ARRAY, NULL);
+	luks2_json* config = new_object();
+	bool ok = result == LUKS2_OK && root != NULL && segments != NULL
+		&& segment != NULL && digests != NULL && digestObject != NULL
+		&& digestKeyslots != NULL && digestSegments != NULL && config != NULL;
+
+	ok = ok && luks2_json_set(segment, "type", new_string("crypt"))
+		&& luks2_json_set(segment, "offset",
+			luks2_json_new_uint64(dataOffset, true))
+		&& luks2_json_set(segment, "size", new_string("dynamic"))
+		&& luks2_json_set(segment, "iv_tweak", new_string("0"))
+		&& luks2_json_set(segment, "encryption",
+			new_string(LUKS2_CIPHER_AES_XTS_PLAIN64))
+		&& luks2_json_set(segment, "sector_size",
+			luks2_json_new_uint64(sectorSize, false))
+		&& luks2_json_append(digestKeyslots, new_string("0"))
+		&& luks2_json_append(digestSegments, new_string("0"))
+		&& luks2_json_set(digestObject, "type", new_string("pbkdf2"))
+		&& luks2_json_set(config, "json_size",
+			luks2_json_new_uint64(volume->json_size, true))
+		&& luks2_json_set(config, "keyslots_size",
+			luks2_json_new_uint64(volume->keyslots_size, true));
+	if (ok) {
+		// from here on the children belong to their parents
+		ok = luks2_json_set(digestObject, "keyslots", digestKeyslots);
+		digestKeyslots = NULL;
+		ok = luks2_json_set(digestObject, "segments", digestSegments) && ok;
+		digestSegments = NULL;
+		ok = ok && luks2_json_set(digestObject, "hash", new_string("sha256"))
+			&& luks2_json_set(digestObject, "iterations",
+				luks2_json_new_uint64(digestIterations, false))
+			&& luks2_json_set(digestObject, "salt",
+				new_base64(digestSalt, sizeof(digestSalt)))
+			&& luks2_json_set(digestObject, "digest",
+				new_base64(digest, sizeof(digest)));
+		ok = luks2_json_set(segments, "0", segment) && ok;
+		segment = NULL;
+		ok = luks2_json_set(digests, "0", digestObject) && ok;
+		digestObject = NULL;
+		ok = luks2_json_set(root, "keyslots", new_object()) && ok;
+		ok = luks2_json_set(root, "tokens", new_object()) && ok;
+		ok = luks2_json_set(root, "segments", segments) && ok;
+		segments = NULL;
+		ok = luks2_json_set(root, "digests", digests) && ok;
+		digests = NULL;
+		ok = luks2_json_set(root, "config", config) && ok;
+		config = NULL;
+	}
+	luks2_json_free(segments);
+	luks2_json_free(segment);
+	luks2_json_free(digests);
+	luks2_json_free(digestObject);
+	luks2_json_free(digestKeyslots);
+	luks2_json_free(digestSegments);
+	luks2_json_free(config);
+	volume->json = root;
+	if (result == LUKS2_OK && !ok)
+		result = LUKS2_ERROR_NO_MEMORY;
+
+	// wipe the metadata area (old headers, keyslots, other signatures)
+	if (result == LUKS2_OK) {
+		size_t chunkSize = 1024 * 1024;
+		uint8_t* zeros = (uint8_t*)calloc(1, chunkSize);
+		if (zeros == NULL)
+			result = LUKS2_ERROR_NO_MEMORY;
+		for (uint64_t offset = 0; result == LUKS2_OK && offset < dataOffset;
+				offset += chunkSize) {
+			size_t length = dataOffset - offset < chunkSize
+				? (size_t)(dataOffset - offset) : chunkSize;
+			if (!write_fully(io, offset, zeros, length))
+				result = LUKS2_ERROR_IO;
+		}
+		free(zeros);
+	}
+
+	if (result == LUKS2_OK) {
+		result = create_keyslot(volume, io, key, keySize, passphrase,
+			passphraseLength, &parameters->kdf, 0, stripes);
+	}
+	if (result == LUKS2_OK)
+		result = write_headers(volume, io);
+
+	if (result == LUKS2_OK && keyOut != NULL) {
+		memcpy(keyOut, key, keySize);
+		if (_keySize != NULL)
+			*_keySize = keySize;
+	}
+	luks2_wipe(key, sizeof(key));
+	luks2_free_volume(volume);
+	return result;
+}
+
+
+extern "C" int
+luks2_add_keyslot(luks2_volume* volume, const luks2_device_io* io,
+	const uint8_t* key, size_t keySize, const void* passphrase,
+	size_t passphraseLength, const luks2_kdf* kdf, int slot, int* _slot)
+{
+	if (io->write == NULL)
+		return LUKS2_ERROR_READ_ONLY;
+	if (!valid_kdf(kdf) || slot >= LUKS2_MAX_KEYSLOTS)
+		return LUKS2_ERROR_BAD_ARGUMENT;
+
+	// a volume without keyslots has no key size yet: accept the digest's
+	luks2_volume checkVolume = *volume;
+	if (checkVolume.segment.key_size == 0)
+		checkVolume.segment.key_size = (uint32_t)keySize;
+	int result = luks2_check_key(&checkVolume, key, keySize);
+	luks2_wipe(&checkVolume, sizeof(checkVolume));
+	if (result != LUKS2_OK)
+		return result;
+
+	if (slot < 0) {
+		for (int i = 0; i < LUKS2_MAX_KEYSLOTS; i++) {
+			if (!volume->keyslots[i].used) {
+				slot = i;
+				break;
+			}
+		}
+		if (slot < 0)
+			return LUKS2_ERROR_NO_KEYSLOT;
+	} else if (volume->keyslots[slot].used)
+		return LUKS2_ERROR_BAD_ARGUMENT;
+
+	// the new keyslot uses the stripes of an existing one, or the default
+	uint32_t stripes = LUKS2_DEFAULT_STRIPES;
+	for (int i = 0; i < LUKS2_MAX_KEYSLOTS; i++) {
+		if (volume->keyslots[i].used && volume->keyslots[i].supported) {
+			stripes = volume->keyslots[i].stripes;
+			break;
+		}
+	}
+
+	luks2_json* backup = luks2_json_clone(volume->json);
+	if (backup == NULL)
+		return LUKS2_ERROR_NO_MEMORY;
+
+	result = create_keyslot(volume, io, key, keySize, passphrase,
+		passphraseLength, kdf, slot, stripes);
+	if (result == LUKS2_OK) {
+		char name[4];
+		index_string(slot, name);
+		char digestName[4];
+		index_string(volume->segment_digest, digestName);
+		luks2_json* digest = luks2_json_get(
+			luks2_json_get(volume->json, "digests"), digestName);
+		if (digest == NULL
+			|| !luks2_json_append(luks2_json_get(digest, "keyslots"),
+				new_string(name))) {
+			result = LUKS2_ERROR_NO_MEMORY;
+		}
+	}
+	if (result == LUKS2_OK)
+		result = write_headers(volume, io);
+	if (result == LUKS2_OK)
+		result = refresh_volume(volume, io);
+
+	if (result != LUKS2_OK) {
+		// back to the metadata on disk
+		luks2_json_free(volume->json);
+		volume->json = backup;
+		refresh_volume(volume, io);
+		return result;
+	}
+
+	luks2_json_free(backup);
+	if (_slot != NULL)
+		*_slot = slot;
+	return LUKS2_OK;
+}
+
+
+extern "C" int
+luks2_remove_keyslot(luks2_volume* volume, const luks2_device_io* io,
+	int slot)
+{
+	if (io->write == NULL)
+		return LUKS2_ERROR_READ_ONLY;
+	if (slot < 0 || slot >= LUKS2_MAX_KEYSLOTS || !volume->keyslots[slot].used)
+		return LUKS2_ERROR_BAD_ARGUMENT;
+
+	luks2_json* backup = luks2_json_clone(volume->json);
+	if (backup == NULL)
+		return LUKS2_ERROR_NO_MEMORY;
+
+	char name[4];
+	index_string(slot, name);
+	uint64_t areaOffset = volume->keyslots[slot].area_offset;
+	uint64_t areaSize = volume->keyslots[slot].area_size;
+
+	luks2_json_remove(luks2_json_get(volume->json, "keyslots"), name);
+	luks2_json* digests = luks2_json_get(volume->json, "digests");
+	for (luks2_json* digest = digests != NULL ? digests->first : NULL;
+			digest != NULL; digest = digest->next) {
+		luks2_json_remove_string(luks2_json_get(digest, "keyslots"), name);
+	}
+	luks2_json* tokens = luks2_json_get(volume->json, "tokens");
+	for (luks2_json* token = tokens != NULL ? tokens->first : NULL;
+			token != NULL; token = token->next) {
+		luks2_json_remove_string(luks2_json_get(token, "keyslots"), name);
+	}
+
+	int result = write_headers(volume, io);
+	if (result == LUKS2_OK)
+		result = refresh_volume(volume, io);
+	if (result != LUKS2_OK) {
+		luks2_json_free(volume->json);
+		volume->json = backup;
+		refresh_volume(volume, io);
+		return result;
+	}
+	luks2_json_free(backup);
+
+	// the headers no longer point to it: overwrite the old area
+	size_t chunkSize = 64 * 1024;
+	uint8_t* noise = (uint8_t*)malloc(chunkSize);
+	if (noise == NULL)
+		return LUKS2_ERROR_NO_MEMORY;
+	for (uint64_t offset = 0; offset < areaSize && result == LUKS2_OK;
+			offset += chunkSize) {
+		size_t length = areaSize - offset < chunkSize
+			? (size_t)(areaSize - offset) : chunkSize;
+		if (luks2_random(noise, length) != 0)
+			result = LUKS2_ERROR_RANDOM;
+		else if (!write_fully(io, areaOffset + offset, noise, length))
+			result = LUKS2_ERROR_IO;
+	}
+	free(noise);
+	return result;
+}
diff --git a/src/tests/system/luks2/build_host.sh b/src/tests/system/luks2/build_host.sh
new file mode 100755
index 0000000000..e167a55317
--- /dev/null
+++ b/src/tests/system/luks2/build_host.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Builds the LUKS2 code, the crypto tests and the luks tool for the build host
+# (Linux) with the host compiler.
+# Usage: build_host.sh <output dir> [compiler flags], e.g.
+#   build_host.sh out -O2
+#   build_host.sh out-asan -g -O1 -fsanitize=address,undefined
+set -e
+B=$1
+shift
+R=$(cd "$(dirname "$0")/../../../.." && pwd)
+S=$R/src/libs/luks2
+mkdir -p "$B"
+CF="$* -Wall -Wextra -Wno-missing-field-initializers -I$R/headers/private"
+gcc $CF -c "$S/crypto/aes_ct.c" -o "$B/aes_ct.o"
+for f in crypto/aes_xts crypto/sha2_hmac crypto/argon2 arch/x86/aes_ni json \
+		luks2_util luks2_read luks2_write; do
+	g++ $CF -c "$S/$f.cpp" -o "$B/$(basename $f).o"
+done
+g++ $CF "$R/src/tests/system/luks2/crypto_test.cpp" "$B/aes_ct.o" \
+	"$B/aes_xts.o" "$B/sha2_hmac.o" "$B/argon2.o" "$B/aes_ni.o" \
+	-o "$B/crypto_test"
+g++ $CF "$R/src/bin/luks/luks.cpp" "$B"/*.o -o "$B/luks"
diff --git a/src/tests/system/luks2/crypto_crosscheck.py b/src/tests/system/luks2/crypto_crosscheck.py
new file mode 100755
index 0000000000..4e293d0ace
--- /dev/null
+++ b/src/tests/system/luks2/crypto_crosscheck.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Compares the LUKS2 crypto primitives with OpenSSL (through the Python
+# "cryptography" package, hashlib and, for Argon2i, the openssl command) on
+# random inputs.
+# Usage: crypto_crosscheck.py <crypto_test binary> [rounds]
+
+import hashlib
+import os
+import random
+import subprocess
+import sys
+
+from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
+from cryptography.hazmat.primitives.kdf.argon2 import Argon2id
+
+binary = sys.argv[1]
+rounds = int(sys.argv[2]) if len(sys.argv) > 2 else 20
+failures = 0
+checks = 0
+
+
+def run(*args):
+    out = subprocess.run([binary] + [str(a) for a in args], check=True,
+                         capture_output=True, text=True).stdout
+    return [bytes.fromhex(line) for line in out.split()]
+
+
+def compare(name, got, expected):
+    global failures, checks
+    checks += 1
+    if got != expected:
+        failures += 1
+        print("FAIL", name)
+        print("  got     ", got.hex()[:96])
+        print("  expected", expected.hex()[:96])
+
+
+for i in range(rounds):
+    for impl in ("portable", "best"):
+        key = os.urandom(random.choice((32, 64)))
+        if key[:len(key) // 2] == key[len(key) // 2:]:
+            continue
+        iv = random.choice((0, 1, 0xff, random.getrandbits(64)))
+        length = random.choice((16, 32, 48, 512, 1024, 4096 - 16 * 8, 2048))
+        data = os.urandom(length)
+        encrypted, decrypted = run("xts", impl, key.hex(), iv, data.hex())
+        tweak = iv.to_bytes(16, "little")
+        encryptor = Cipher(algorithms.AES(key), modes.XTS(tweak)).encryptor()
+        expected = encryptor.update(data) + encryptor.finalize()
+        compare("xts %s key %d iv %#x length %d" % (impl, len(key), iv,
+                length), encrypted, expected)
+        compare("xts decrypt", decrypted, data)
+
+    hash_name = random.choice(("sha256", "sha512"))
+    password = os.urandom(random.choice((0, 1, 8, 63, 64, 65, 129, 200)))
+    salt = os.urandom(random.choice((0, 16, 32, 100)))
+    iterations = random.choice((1, 2, 1000, 4096))
+    length = random.choice((16, 32, 64, 65, 100))
+    got, = run("pbkdf2", hash_name, password.hex() or "''", salt.hex() or "''",
+               iterations, length) if password and salt else (None,)
+    if got is not None:
+        expected = hashlib.pbkdf2_hmac(hash_name, password, salt, iterations,
+                                       length)
+        compare("pbkdf2 %s password %d salt %d iterations %d length %d"
+                % (hash_name, len(password), len(salt), iterations, length),
+                got, expected)
+
+    kind = random.choice(("i", "id"))
+    lanes = random.choice((1, 2, 3, 4, 7))
+    memory = random.choice((8 * lanes, 8 * lanes + 5, 64, 100, 1024, 4099))
+    memory = max(memory, 8 * lanes)
+    passes = random.choice((1, 2, 3, 4))
+    length = random.choice((4, 16, 32, 64, 65, 100, 256))
+    password = os.urandom(random.choice((1, 8, 32, 100)))
+    salt = os.urandom(random.choice((8, 16, 32)))
+    got, = run("argon2", kind, password.hex(), salt.hex(), passes, memory,
+               lanes, length)
+    if kind == "id":
+        expected = Argon2id(salt=salt, length=length, iterations=passes,
+                            lanes=lanes, memory_cost=memory).derive(password)
+    else:
+        out = subprocess.run(
+            ["openssl", "kdf", "-keylen", str(length),
+             "-kdfopt", "hexpass:" + password.hex(),
+             "-kdfopt", "hexsalt:" + salt.hex(),
+             "-kdfopt", "iter:%d" % passes, "-kdfopt", "memcost:%d" % memory,
+             "-kdfopt", "lanes:%d" % lanes, "ARGON2I"],
+            check=True, capture_output=True, text=True).stdout
+        expected = bytes.fromhex(out.strip().replace(":", ""))
+    compare("argon2%s t=%d m=%d p=%d length %d" % (kind, passes, memory,
+            lanes, length), got, expected)
+
+print("%d checks, %d failures" % (checks, failures))
+sys.exit(1 if failures else 0)
diff --git a/src/tests/system/luks2/crypto_test.cpp b/src/tests/system/luks2/crypto_test.cpp
new file mode 100644
index 0000000000..5ad688874d
--- /dev/null
+++ b/src/tests/system/luks2/crypto_test.cpp
@@ -0,0 +1,348 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Host tests of the LUKS2 crypto primitives against published test vectors
+	(FIPS-197, IEEE 1619, FIPS 180-4, RFC 7914, RFC 7693, RFC 9106).
+	"crypto_test vectors" runs them; "crypto_test <primitive> <args>" prints
+	one result in hex, for comparisons with OpenSSL (run_tests.sh).
+*/
+
+
+#include <luks2/luks2_crypto.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+
+static int sFailures = 0;
+
+
+static size_t
+from_hex(const char* hex, uint8_t* out, size_t maxLength)
+{
+	size_t length = 0;
+	while (hex[0] != '\0' && hex[1] != '\0' && length < maxLength) {
+		unsigned value;
+		sscanf(hex, "%2x", &value);
+		out[length++] = (uint8_t)value;
+		hex += 2;
+	}
+	return length;
+}
+
+
+static void
+print_hex(const uint8_t* data, size_t length)
+{
+	for (size_t i = 0; i < length; i++)
+		printf("%02x", data[i]);
+	printf("\n");
+}
+
+
+static void
+check(const char* name, const uint8_t* got, const char* expectedHex)
+{
+	uint8_t expected[4096];
+	size_t length = from_hex(expectedHex, expected, sizeof(expected));
+	if (memcmp(got, expected, length) != 0) {
+		printf("FAIL %s\n  got      ", name);
+		print_hex(got, length);
+		printf("  expected %s\n", expectedHex);
+		sFailures++;
+	} else
+		printf("ok   %s\n", name);
+}
+
+
+static void
+test_aes(int accelerated)
+{
+	luks2_aes_allow_acceleration(accelerated);
+	const char* suffix = accelerated ? " (best)" : " (portable)";
+	char name[128];
+
+	// FIPS-197 appendix C
+	uint8_t key[32], in[16], out[16], back[16];
+	from_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
+		key, 32);
+	from_hex("00112233445566778899aabbccddeeff", in, 16);
+	static const struct { size_t length; const char* expected; } kCases[] = {
+		{ 16, "69c4e0d86a7b0430d8cdb78070b4c55a" },
+		{ 24, "dda97ca4864cdfe06eaf70a0ec0d7191" },
+		{ 32, "8ea2b7ca516745bfeafc49904b496089" }
+	};
+	for (const auto& c : kCases) {
+		luks2_aes aes;
+		luks2_aes_set_key(&aes, key, c.length);
+		luks2_aes_encrypt(&aes, in, out, 1);
+		snprintf(name, sizeof(name), "AES-%zu encrypt%s [%s]", c.length * 8,
+			suffix, luks2_aes_implementation_name(aes.implementation));
+		check(name, out, c.expected);
+		luks2_aes_decrypt(&aes, out, back, 1);
+		snprintf(name, sizeof(name), "AES-%zu decrypt%s", c.length * 8,
+			suffix);
+		check(name, back, "00112233445566778899aabbccddeeff");
+		luks2_aes_clear(&aes);
+	}
+
+	// many blocks at once must match block by block
+	uint8_t data[16 * 37], single[16 * 37], multi[16 * 37];
+	for (size_t i = 0; i < sizeof(data); i++)
+		data[i] = (uint8_t)(i * 7 + 3);
+	luks2_aes aes;
+	luks2_aes_set_key(&aes, key, 32);
+	for (int i = 0; i < 37; i++)
+		luks2_aes_encrypt(&aes, data + i * 16, single + i * 16, 1);
+	luks2_aes_encrypt(&aes, data, multi, 37);
+	snprintf(name, sizeof(name), "AES-256 37 blocks%s", suffix);
+	if (memcmp(single, multi, sizeof(single)) != 0) {
+		printf("FAIL %s\n", name);
+		sFailures++;
+	} else
+		printf("ok   %s\n", name);
+	luks2_aes_decrypt(&aes, multi, multi, 37);
+	snprintf(name, sizeof(name), "AES-256 37 blocks round trip%s", suffix);
+	if (memcmp(data, multi, sizeof(data)) != 0) {
+		printf("FAIL %s\n", name);
+		sFailures++;
+	} else
+		printf("ok   %s\n", name);
+
+	// IEEE 1619-2007 XTS-AES-128 vector 4 (data unit 0, 512 bytes 00..ff
+	// twice) and vector 10 (XTS-AES-256, data unit 0xff)
+	uint8_t xtsKey[64];
+	uint8_t sector[512];
+	from_hex("2718281828459045235360287471352631415926535897932384626433832795",
+		xtsKey, 32);
+	for (int i = 0; i < 512; i++)
+		sector[i] = (uint8_t)i;
+	luks2_xts xts;
+	luks2_xts_set_key(&xts, xtsKey, 32);
+	luks2_xts_encrypt(&xts, 0, sector, 512);
+	snprintf(name, sizeof(name), "XTS-AES-128 IEEE 1619 vector 4%s", suffix);
+	check(name, sector, "27a7479befa1d476489f308cd4cfa6e2a96e4bbe3208ff25287dd3819616e89c");
+	luks2_xts_decrypt(&xts, 0, sector, 512);
+	bool roundTrip = true;
+	for (int i = 0; i < 512; i++)
+		roundTrip &= sector[i] == (uint8_t)i;
+	printf("%s XTS-AES-128 decrypt round trip%s\n", roundTrip ? "ok  " : "FAIL",
+		suffix);
+	sFailures += roundTrip ? 0 : 1;
+
+	from_hex("27182818284590452353602874713526624977572470936999595749669676273141592653589793238462643383279502884197169399375105820974944592",
+		xtsKey, 64);
+	for (int i = 0; i < 512; i++)
+		sector[i] = (uint8_t)i;
+	luks2_xts_set_key(&xts, xtsKey, 64);
+	luks2_xts_encrypt(&xts, 0xff, sector, 512);
+	snprintf(name, sizeof(name), "XTS-AES-256 IEEE 1619 vector 10%s", suffix);
+	check(name, sector, "1c3b3a102f770386e4836c99e370cf9bea00803f5e482357a4ae12d414a3e63b");
+	luks2_xts_clear(&xts);
+
+	luks2_aes_allow_acceleration(1);
+}
+
+
+static void
+test_hashes()
+{
+	uint8_t digest[64];
+	luks2_sha256 sha256;
+	luks2_sha256_init(&sha256);
+	luks2_sha256_update(&sha256, "abc", 3);
+	luks2_sha256_final(&sha256, digest);
+	check("SHA-256 abc", digest,
+		"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+
+	const char* twoBlocks = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
+	luks2_sha256_init(&sha256);
+	luks2_sha256_update(&sha256, twoBlocks, strlen(twoBlocks));
+	luks2_sha256_final(&sha256, digest);
+	check("SHA-256 448 bits", digest,
+		"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
+
+	// one million 'a', fed in odd pieces
+	char a[1001];
+	memset(a, 'a', sizeof(a));
+	luks2_sha256_init(&sha256);
+	for (int i = 0; i < 1000; i++)
+		luks2_sha256_update(&sha256, a, i % 2 ? 999 : 1001);
+	luks2_sha256_final(&sha256, digest);
+	check("SHA-256 million a", digest,
+		"cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
+
+	luks2_sha512 sha512;
+	luks2_sha512_init(&sha512);
+	luks2_sha512_update(&sha512, "abc", 3);
+	luks2_sha512_final(&sha512, digest);
+	check("SHA-512 abc", digest,
+		"ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a"
+		"2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f");
+
+	const char* sha512TwoBlocks = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
+	luks2_sha512_init(&sha512);
+	luks2_sha512_update(&sha512, sha512TwoBlocks, strlen(sha512TwoBlocks));
+	luks2_sha512_final(&sha512, digest);
+	check("SHA-512 896 bits", digest,
+		"8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018"
+		"501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909");
+
+	// RFC 7914 section 11
+	uint8_t key[64];
+	luks2_pbkdf2(LUKS2_HASH_SHA256, "passwd", 6, "salt", 4, 1, key, 64);
+	check("PBKDF2-SHA256 passwd/salt/1", key,
+		"55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc"
+		"49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783");
+	luks2_pbkdf2(LUKS2_HASH_SHA256, "Password", 8, "NaCl", 4, 80000, key, 64);
+	check("PBKDF2-SHA256 Password/NaCl/80000", key,
+		"4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56"
+		"a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d");
+
+	// RFC 7693 appendix A
+	luks2_blake2b blake;
+	luks2_blake2b_init(&blake, 64, NULL, 0);
+	luks2_blake2b_update(&blake, "abc", 3);
+	luks2_blake2b_final(&blake, digest);
+	check("BLAKE2b-512 abc", digest,
+		"ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d1"
+		"7d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923");
+}
+
+
+static void
+test_argon2()
+{
+	// RFC 9106 sections 5.1 to 5.3
+	uint8_t password[32], salt[16], secret[8], ad[12], tag[32];
+	memset(password, 1, sizeof(password));
+	memset(salt, 2, sizeof(salt));
+	memset(secret, 3, sizeof(secret));
+	memset(ad, 4, sizeof(ad));
+
+	static const struct { int type; const char* name; const char* tag; }
+	kCases[] = {
+		{ LUKS2_ARGON2D, "Argon2d RFC 9106",
+			"512b391b6f1162975371d30919734294f868e3be3984f3c1a13a4db9fabe4acb" },
+		{ LUKS2_ARGON2I, "Argon2i RFC 9106",
+			"c814d9d1dc7f37aa13f0d77f2494bda1c8de6b016dd388d29952a4c4672b6ce8" },
+		{ LUKS2_ARGON2ID, "Argon2id RFC 9106",
+			"0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659" }
+	};
+	for (const auto& c : kCases) {
+		int result = luks2_argon2(c.type, 3, 32, 4, password, 32, salt, 16,
+			secret, 8, ad, 12, tag, 32);
+		if (result != 0) {
+			printf("FAIL %s: error %d\n", c.name, result);
+			sFailures++;
+			continue;
+		}
+		check(c.name, tag, c.tag);
+	}
+}
+
+
+static void
+benchmark()
+{
+	uint8_t key[64];
+	memset(key, 0x5a, sizeof(key));
+	size_t size = 64 * 1024 * 1024;
+	uint8_t* buffer = (uint8_t*)calloc(1, size);
+	for (int accelerated = 0; accelerated < 2; accelerated++) {
+		luks2_aes_allow_acceleration(accelerated);
+		luks2_xts xts;
+		luks2_xts_set_key(&xts, key, 64);
+		clock_t start = clock();
+		for (size_t offset = 0; offset < size; offset += 512)
+			luks2_xts_decrypt(&xts, offset / 512, buffer + offset, 512);
+		double seconds = (double)(clock() - start) / CLOCKS_PER_SEC;
+		printf("XTS-AES-256 decrypt, %s: %.0f MB/s\n",
+			luks2_aes_implementation_name(xts.data.implementation),
+			size / seconds / 1e6);
+	}
+	free(buffer);
+
+	clock_t start = clock();
+	uint8_t out[64];
+	luks2_pbkdf2(LUKS2_HASH_SHA256, "password", 8, "saltsaltsaltsalt", 16,
+		1000000, out, 32);
+	printf("PBKDF2-SHA256: %.0f iterations/s\n",
+		1e6 / ((double)(clock() - start) / CLOCKS_PER_SEC));
+
+	start = clock();
+	luks2_argon2(LUKS2_ARGON2ID, 1, 256 * 1024, 1, "password", 8,
+		"saltsaltsaltsalt", 16, NULL, 0, NULL, 0, out, 32);
+	printf("Argon2id: %.0f MiB/s per pass\n",
+		256 / ((double)(clock() - start) / CLOCKS_PER_SEC));
+}
+
+
+int
+main(int argc, char** argv)
+{
+	if (argc >= 2 && strcmp(argv[1], "vectors") == 0) {
+		test_aes(0);
+		test_aes(1);
+		test_hashes();
+		test_argon2();
+		printf("%d failures\n", sFailures);
+		return sFailures == 0 ? 0 : 1;
+	}
+
+	if (argc >= 2 && strcmp(argv[1], "benchmark") == 0) {
+		benchmark();
+		return 0;
+	}
+
+	uint8_t a[4096], b[4096], out[4096];
+	if (argc == 6 && strcmp(argv[1], "xts") == 0) {
+		// xts <portable|best> <key hex> <iv> <data hex>: encrypt
+		luks2_aes_allow_acceleration(strcmp(argv[2], "best") == 0);
+		size_t keyLength = from_hex(argv[3], a, sizeof(a));
+		size_t length = from_hex(argv[5], out, sizeof(out));
+		luks2_xts xts;
+		if (luks2_xts_set_key(&xts, a, keyLength) != 0)
+			return 2;
+		luks2_xts_encrypt(&xts, strtoull(argv[4], NULL, 0), out, length);
+		print_hex(out, length);
+		memcpy(b, out, length);
+		luks2_xts_decrypt(&xts, strtoull(argv[4], NULL, 0), b, length);
+		print_hex(b, length);
+		return 0;
+	}
+	if (argc == 7 && strcmp(argv[1], "pbkdf2") == 0) {
+		// pbkdf2 <hash> <password hex> <salt hex> <iterations> <length>
+		size_t passwordLength = from_hex(argv[3], a, sizeof(a));
+		size_t saltLength = from_hex(argv[4], b, sizeof(b));
+		size_t length = strtoul(argv[6], NULL, 0);
+		if (luks2_pbkdf2(luks2_hash_from_name(argv[2]), a, passwordLength, b,
+				saltLength, strtoul(argv[5], NULL, 0), out, length) != 0)
+			return 2;
+		print_hex(out, length);
+		return 0;
+	}
+	if (argc == 9 && strcmp(argv[1], "argon2") == 0) {
+		// argon2 <i|id> <password hex> <salt hex> <t> <m> <p> <length>
+		int type = strcmp(argv[2], "i") == 0 ? LUKS2_ARGON2I : LUKS2_ARGON2ID;
+		size_t passwordLength = from_hex(argv[3], a, sizeof(a));
+		size_t saltLength = from_hex(argv[4], b, sizeof(b));
+		size_t length = strtoul(argv[8], NULL, 0);
+		if (luks2_argon2(type, strtoul(argv[5], NULL, 0),
+				strtoul(argv[6], NULL, 0), strtoul(argv[7], NULL, 0), a,
+				passwordLength, b, saltLength, NULL, 0, NULL, 0, out, length)
+				!= 0)
+			return 2;
+		print_hex(out, length);
+		return 0;
+	}
+
+	fprintf(stderr, "usage: %s vectors | benchmark | xts ... | pbkdf2 ... | "
+		"argon2 ...\n", argv[0]);
+	return 2;
+}
diff --git a/src/tests/system/luks2/cryptsetup_test.sh b/src/tests/system/luks2/cryptsetup_test.sh
new file mode 100755
index 0000000000..5d0abc2dfe
--- /dev/null
+++ b/src/tests/system/luks2/cryptsetup_test.sh
@@ -0,0 +1,260 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Interoperability tests of the LUKS2 code (through the host build of the
+# luks tool) against Linux's cryptsetup, on image files, without root:
+# cryptsetup makes volumes that luks must open and decrypt byte for byte,
+# and luks makes volumes that cryptsetup must accept and open.
+#
+# Usage: cryptsetup_test.sh <cryptsetup binary> <luks binary> <empty work dir>
+
+CS=$1
+LUKS=$2
+W=$3
+HERE=$(cd "$(dirname "$0")" && pwd)
+[ -x "$CS" ] && [ -x "$LUKS" ] && [ -d "$W" ] || {
+	echo "usage: $0 <cryptsetup> <luks> <work dir>"; exit 2; }
+cd "$W" || exit 2
+
+passed=0
+failed=0
+ok() { passed=$((passed + 1)); echo "ok   $*"; }
+bad() { failed=$((failed + 1)); echo "FAIL $*"; }
+
+cs() { "$CS" -q --disable-locks "$@"; }
+
+# expect_open <name> <image> <key file> [<keyslot that must open it>]
+expect_open() {
+	out=$("$LUKS" test -k "$3" "$2" 2>&1)
+	if [ $? -eq 0 ] && { [ -z "$4" ] || echo "$out" | grep -q "keyslot $4 opens"; }; then
+		ok "$1 ($out)"
+	else
+		bad "$1: $out"
+	fi
+}
+
+# expect_refused <name> <image> <key file> [<message part>]
+expect_refused() {
+	out=$("$LUKS" test -k "$3" "$2" 2>&1)
+	if [ $? -ne 0 ] && { [ -z "$4" ] || echo "$out" | grep -q "$4"; }; then
+		ok "$1 (refused: $out)"
+	else
+		bad "$1: expected a refusal, got: $out"
+	fi
+}
+
+# cryptsetup's view of the volume key, as hex
+cs_volume_key() {
+	cs luksDump --dump-volume-key --key-file "$2" "$1" 2>/dev/null \
+		| sed -n '/MK dump/,$p' | sed 's/MK dump://' | tr -d ' \t\n'
+}
+
+# cs_opens <name> <image> <key file> [<slot>]
+cs_opens() {
+	if [ -n "$4" ]; then
+		cs luksOpen --test-passphrase --key-file "$3" --key-slot "$4" "$2" 2>&1
+	else
+		cs luksOpen --test-passphrase --key-file "$3" "$2" 2>&1
+	fi
+	if [ $? -eq 0 ]; then ok "$1"; else bad "$1"; fi
+}
+
+cs_refuses() {
+	if cs luksOpen --test-passphrase --key-file "$3" "$2" >/dev/null 2>&1; then
+		bad "$1: cryptsetup still opens it"
+	else
+		ok "$1"
+	fi
+}
+
+printf 'correct horse battery staple' > k0
+printf 'second passphrase' > k1
+printf 'third: \303\244\303\266\303\274 \342\202\254' > k2		# UTF-8
+printf 'wrong passphrase' > kx
+head -c 100000 /dev/urandom > kbin		# a binary key file
+head -c $((64 * 1024 * 1024)) /dev/urandom > plain64.img
+
+image() { rm -f "$1"; truncate -s "$2" "$1"; }
+
+echo "== volumes made by cryptsetup, opened by luks"
+
+image cs-default.img 40M
+cs luksFormat --type luks2 --key-file k0 --iter-time 500 cs-default.img
+expect_open "cryptsetup defaults (argon2id, benchmarked)" cs-default.img k0 0
+expect_refused "wrong passphrase" cs-default.img kx "no keyslot"
+"$LUKS" dump cs-default.img | sed 's/^/     /'
+
+image cs-argon2i.img 40M
+cs luksFormat --type luks2 --key-file k0 --pbkdf argon2i --pbkdf-memory 65536 \
+	--pbkdf-parallel 3 --pbkdf-force-iterations 5 cs-argon2i.img
+expect_open "argon2i, 64 MiB, 3 lanes, 5 passes" cs-argon2i.img k0 0
+
+image cs-pbkdf2.img 40M
+cs luksFormat --type luks2 --key-file k0 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 5000 cs-pbkdf2.img
+expect_open "pbkdf2-sha256, 5000 iterations" cs-pbkdf2.img k0 0
+
+image cs-sha512.img 40M
+cs luksFormat --type luks2 --key-file k0 --hash sha512 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 5000 cs-sha512.img
+expect_open "pbkdf2-sha512 (AF and digest sha512 too)" cs-sha512.img k0 0
+
+image cs-aes128.img 40M
+cs luksFormat --type luks2 --key-file k0 --key-size 256 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 cs-aes128.img
+expect_open "AES-128-XTS (256-bit key)" cs-aes128.img k0 0
+
+image cs-label.img 40M
+cs luksFormat --type luks2 --key-file k0 --label "Haiku System" \
+	--subsystem test --pbkdf pbkdf2 --pbkdf-force-iterations 1000 cs-label.img
+if "$LUKS" dump cs-label.img | grep -q "label: *Haiku System"; then
+	ok "label read"
+else
+	bad "label not read"
+fi
+
+image cs-bigheader.img 40M
+cs luksFormat --type luks2 --key-file k0 --luks2-metadata-size 64k \
+	--luks2-keyslots-size 8m --pbkdf pbkdf2 --pbkdf-force-iterations 1000 \
+	cs-bigheader.img
+expect_open "64 KiB metadata, 8 MiB keyslots area" cs-bigheader.img k0 0
+
+image cs-binkey.img 40M
+cs luksFormat --type luks2 --key-file kbin --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 cs-binkey.img
+expect_open "100000-byte binary key file" cs-binkey.img kbin 0
+
+echo "== several keyslots, priorities, removal (cryptsetup)"
+
+image cs-slots.img 40M
+cs luksFormat --type luks2 --key-file k0 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 cs-slots.img
+cs luksAddKey --key-file k0 --new-key-slot 1 --pbkdf argon2id \
+	--pbkdf-memory 32768 --pbkdf-force-iterations 4 cs-slots.img k1
+cs luksAddKey --key-file k0 --new-key-slot 5 --pbkdf argon2i \
+	--pbkdf-memory 16384 --pbkdf-force-iterations 4 cs-slots.img k2
+expect_open "slot 0 of 3" cs-slots.img k0 0
+expect_open "slot 1 of 3 (argon2id)" cs-slots.img k1 1
+expect_open "slot 5 of 3 (argon2i, UTF-8 passphrase)" cs-slots.img k2 5
+cs config --priority ignore --key-slot 1 cs-slots.img
+expect_refused "slot 1 with priority ignore" cs-slots.img k1
+out=$("$LUKS" test -S 1 -k k1 cs-slots.img 2>&1) \
+	&& ok "slot 1 with priority ignore, asked for by number" \
+	|| bad "slot 1 asked for by number: $out"
+cs config --priority normal --key-slot 1 cs-slots.img
+cs luksKillSlot --key-file k1 cs-slots.img 0
+expect_refused "slot 0 after luksKillSlot" cs-slots.img k0
+expect_open "slot 1 after slot 0 was killed" cs-slots.img k1 1
+
+echo "== damaged headers"
+
+image cs-damaged.img 40M
+cs luksFormat --type luks2 --key-file k0 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 cs-damaged.img
+# one byte of the primary JSON area
+printf 'X' | dd of=cs-damaged.img bs=1 seek=5000 conv=notrunc 2>/dev/null
+if "$LUKS" dump cs-damaged.img | grep -q "PRIMARY DAMAGED, secondary ok"; then
+	ok "damaged primary detected"
+else
+	bad "damaged primary not detected"
+fi
+expect_open "opened from the secondary header" cs-damaged.img k0 0
+printf 'X' | dd of=cs-damaged.img bs=1 seek=$((16384 + 5000)) conv=notrunc \
+	2>/dev/null
+expect_refused "both headers damaged" cs-damaged.img k0 "damaged"
+
+# a keyslot area byte: that keyslot can't open any more
+image cs-badslot.img 40M
+cs luksFormat --type luks2 --key-file k0 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 cs-badslot.img
+printf 'X' | dd of=cs-badslot.img bs=1 seek=$((32768 + 1000)) conv=notrunc \
+	2>/dev/null
+expect_refused "damaged keyslot area" cs-badslot.img k0 "no keyslot"
+
+image cs-notluks.img 40M
+expect_refused "not a LUKS2 volume" cs-notluks.img k0 "not a LUKS2"
+
+image cs-luks1.img 40M
+cs luksFormat --type luks1 --key-file k0 --pbkdf-force-iterations 1000 \
+	cs-luks1.img
+expect_refused "LUKS1 volume" cs-luks1.img k0 "not a LUKS2"
+
+echo "== data encrypted by cryptsetup, decrypted by luks"
+
+# offline encryption keeps <size - reduce> bytes of plaintext
+for sector in 512 4096; do
+	for bits in 512 256; do
+		head -c $((48 * 1024 * 1024)) plain64.img > cs-data.img
+		cs reencrypt --encrypt --type luks2 --key-file k0 \
+			--reduce-device-size 16M --sector-size $sector --key-size $bits \
+			--pbkdf pbkdf2 --pbkdf-force-iterations 1000 \
+			--force-offline-reencrypt cs-data.img
+		rm -f decrypted.img
+		"$LUKS" read -k k0 cs-data.img decrypted.img
+		kept=$((48 * 1024 * 1024 - 16 * 1024 * 1024))
+		if cmp -n $kept decrypted.img plain64.img >/dev/null; then
+			ok "cryptsetup's data, sector $sector, AES-$((bits / 2))-XTS: $kept bytes identical"
+		else
+			bad "cryptsetup's data, sector $sector, AES-$((bits / 2))-XTS differs"
+		fi
+	done
+done
+
+echo "== an interrupted reencryption is refused"
+head -c $((48 * 1024 * 1024)) plain64.img > cs-interrupted.img
+cs reencrypt --encrypt --type luks2 --key-file k0 --reduce-device-size 16M \
+	--pbkdf pbkdf2 --pbkdf-force-iterations 1000 --force-offline-reencrypt \
+	--init-only cs-interrupted.img
+expect_refused "reencryption in progress" cs-interrupted.img k0 \
+	"doesn't support"
+
+echo "== volumes made by luks, opened by cryptsetup"
+
+for sector in 512 4096; do
+	image ours.img 48M
+	"$LUKS" format -y -k k0 --sector-size $sector --pbkdf argon2id \
+		--memory 65536 --time 3 --parallel 4 ours.img >/dev/null
+	if cs luksDump ours.img >/dev/null 2>&1; then
+		ok "cryptsetup accepts our header (sector $sector)"
+	else
+		bad "cryptsetup rejects our header (sector $sector)"
+	fi
+	cs_opens "cryptsetup opens our argon2id keyslot (sector $sector)" ours.img k0
+	head -c $((32 * 1024 * 1024)) plain64.img > plain32.img
+	"$LUKS" write -k k0 ours.img plain32.img
+	key=$(cs_volume_key ours.img k0)
+	if python3 -I "$HERE/xts_check.py" ours.img 16777216 $sector "$key" \
+			plain32.img; then
+		ok "our data decrypts with cryptsetup's volume key and OpenSSL (sector $sector)"
+	else
+		bad "our data with cryptsetup's volume key (sector $sector)"
+	fi
+done
+
+"$LUKS" addkey -k k0 --new-key-file k1 --pbkdf pbkdf2 --iterations 3000 \
+	ours.img >/dev/null
+"$LUKS" addkey -k k0 --new-key-file k2 --pbkdf argon2i --memory 16384 \
+	--time 4 --parallel 2 ours.img >/dev/null
+cs_opens "cryptsetup opens our pbkdf2 keyslot 1" ours.img k1 1
+cs_opens "cryptsetup opens our argon2i keyslot 2" ours.img k2 2
+cs luksAddKey --key-file k1 --new-key-slot 7 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 ours.img kbin
+expect_open "luks opens the keyslot cryptsetup added to our volume" ours.img \
+	kbin 7
+"$LUKS" removekey -k k1 ours.img >/dev/null
+cs_refuses "cryptsetup can't use our removed keyslot 1" ours.img k1
+cs_opens "cryptsetup still opens slot 0" ours.img k0 0
+if [ "$(cs_volume_key ours.img kbin)" = "$key" ]; then
+	ok "the volume key is unchanged after adding and removing keyslots"
+else
+	bad "the volume key changed"
+fi
+if cs luksDump ours.img | grep -q "^  1: luks2"; then
+	bad "cryptsetup still lists our removed keyslot"
+else
+	ok "cryptsetup no longer lists our removed keyslot"
+fi
+
+echo "$passed passed, $failed failed"
+[ $failed -eq 0 ]
