+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Runs the host tests of the LUKS2 code: test vectors, the comparison with
+# OpenSSL, and the interoperability tests with cryptsetup, once optimised
+# and once with AddressSanitizer and UndefinedBehaviorSanitizer.
+# Needs gcc, python3 with "cryptography", openssl, and a cryptsetup binary
+# (it needs no root: everything works on image files).
+# Usage: run_tests.sh <cryptsetup binary> <work dir>
+set -e
+CS=$1
+W=$2
+HERE=$(cd "$(dirname "$0")" && pwd)
+mkdir -p "$W"
+for variant in o2 asan; do
+	if [ $variant = o2 ]; then
+		flags="-O2"
+	else
+		flags="-g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer"
+	fi
+	echo "=== $variant build"
+	sh "$HERE/build_host.sh" "$W/$variant" $flags
+	"$W/$variant/crypto_test" vectors
+	python3 -I "$HERE/crypto_crosscheck.py" "$W/$variant/crypto_test" 40
+	rm -rf "$W/cryptsetup-$variant"
+	mkdir "$W/cryptsetup-$variant"
+	sh "$HERE/cryptsetup_test.sh" "$CS" "$W/$variant/luks" \
+		"$W/cryptsetup-$variant"
+done
+"$W/o2/crypto_test" benchmark
diff --git a/src/tests/system/luks2/xts_check.py b/src/tests/system/luks2/xts_check.py
new file mode 100755
index 0000000000..cc338c0bdc
--- /dev/null
+++ b/src/tests/system/luks2/xts_check.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Decrypts a LUKS2 data segment with OpenSSL (Python "cryptography") from a
+# volume key in hex, and compares it with a plaintext file.
+# Usage: xts_check.py <image> <segment offset> <sector size> <key hex>
+#                     <plaintext file>
+
+import sys
+
+from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
+
+image, offset, sector_size, key_hex, plain_path = sys.argv[1:6]
+offset = int(offset)
+sector_size = int(sector_size)
+key = bytes.fromhex(key_hex)
+
+with open(plain_path, "rb") as f:
+    plain = f.read()
+
+with open(image, "rb") as f:
+    f.seek(offset)
+    data = f.read(len(plain))
+
+out = bytearray()
+for position in range(0, len(plain), sector_size):
+    iv = (position // 512).to_bytes(16, "little")
+    decryptor = Cipher(algorithms.AES(key), modes.XTS(iv)).decryptor()
+    out += decryptor.update(data[position:position + sector_size]) \
+        + decryptor.finalize()
+
+if bytes(out) != plain:
+    for i in range(len(plain)):
+        if out[i] != plain[i]:
+            print("differs at byte %d" % i)
+            break
+    sys.exit(1)
+print("OpenSSL decrypts %d bytes identically" % len(plain))
