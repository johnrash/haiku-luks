diff --git a/headers/private/luks2/luks2.h b/headers/private/luks2/luks2.h
new file mode 100644
index 0000000000..eb7226cfe5
--- /dev/null
+++ b/headers/private/luks2/luks2.h
@@ -0,0 +1,245 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LUKS2_H
+#define _LUKS2_H
+
+
+/*!	LUKS2 volumes: reading and checking the header, unlocking a keyslot with
+	a passphrase, checking a volume key, and (for the tools) creating
+	volumes and adding or removing keyslots. Written from the LUKS2 on-disk
+	format specification. The supported subset is described in
+	DESIGN.md, which comes with these changes.
+
+	The code does no I/O of its own: callers pass a luks2_device_io with
+	read (and, for changes, write) callbacks on the whole LUKS2 device
+	(partition). It's the same code in the kernel driver, the boot loader,
+	the command line tool and the host tests.
+*/
+
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+#include <luks2/luks2_crypto.h>
+#include <luks2/luks2_json.h>
+
+
+#define LUKS2_BINARY_HEADER_SIZE	4096
+#define LUKS2_MAGIC_SIZE			6
+#define LUKS2_UUID_SIZE				40
+#define LUKS2_LABEL_SIZE			48
+#define LUKS2_SALT_SIZE				64
+#define LUKS2_MAX_KEYSLOTS			32
+#define LUKS2_MAX_DIGESTS			32
+#define LUKS2_MAX_KEY_SIZE			64
+#define LUKS2_KEYSLOT_SECTOR_SIZE	512
+#define LUKS2_IV_SECTOR_SIZE		512
+
+#define LUKS2_DEFAULT_HEADER_SIZE	16384
+#define LUKS2_DEFAULT_DATA_OFFSET	(16 * 1024 * 1024)
+#define LUKS2_DEFAULT_STRIPES		4000
+#define LUKS2_DEFAULT_DIGEST_ITERATIONS	100000
+
+
+enum {
+	LUKS2_OK					= 0,
+	LUKS2_ERROR_IO				= -1,
+	LUKS2_ERROR_NOT_LUKS2		= -2,
+	LUKS2_ERROR_CORRUPT			= -3,
+	LUKS2_ERROR_UNSUPPORTED		= -4,
+	LUKS2_ERROR_NO_MEMORY		= -5,
+	LUKS2_ERROR_BAD_PASSPHRASE	= -6,
+	LUKS2_ERROR_BAD_KEY			= -7,
+	LUKS2_ERROR_NO_KEYSLOT		= -8,
+	LUKS2_ERROR_BAD_ARGUMENT	= -9,
+	LUKS2_ERROR_KDF_MEMORY		= -10,
+	LUKS2_ERROR_RANDOM			= -11,
+	LUKS2_ERROR_READ_ONLY		= -12
+};
+
+enum {
+	LUKS2_KDF_PBKDF2 = 1,
+	LUKS2_KDF_ARGON2I,
+	LUKS2_KDF_ARGON2ID
+};
+
+
+struct luks2_device_io {
+	void*		cookie;
+	ssize_t		(*read)(void* cookie, uint64_t offset, void* buffer,
+					size_t size);
+	ssize_t		(*write)(void* cookie, uint64_t offset, const void* buffer,
+					size_t size);
+					// NULL for read-only access
+	uint64_t	size;
+					// of the whole LUKS2 device, in bytes
+};
+
+
+struct luks2_kdf {
+	int			type;
+	int			hash;			// PBKDF2
+	uint32_t	iterations;		// PBKDF2
+	uint32_t	time;			// Argon2 passes
+	uint32_t	memory;			// Argon2 memory in KiB
+	uint32_t	cpus;			// Argon2 lanes
+	uint8_t		salt[LUKS2_SALT_SIZE];
+	size_t		salt_length;
+};
+
+
+struct luks2_keyslot {
+	bool		used;
+	bool		supported;		// type, area, KDF, AF this code can open
+	int			priority;		// 0 ignore, 1 normal, 2 high
+	uint32_t	key_size;		// of the volume key
+	uint64_t	area_offset;
+	uint64_t	area_size;
+	uint32_t	area_key_size;
+	luks2_kdf	kdf;
+	uint32_t	stripes;
+	int			af_hash;
+	int			digest;			// index in digests, -1 if none
+};
+
+
+struct luks2_digest {
+	bool		used;
+	int			hash;
+	uint32_t	iterations;
+	uint8_t		salt[LUKS2_SALT_SIZE];
+	size_t		salt_length;
+	uint8_t		digest[LUKS2_MAX_DIGEST_SIZE];
+	size_t		digest_length;
+	uint32_t	keyslots;		// bit mask
+	uint32_t	segments;		// bit mask
+};
+
+
+struct luks2_segment {
+	uint64_t	offset;			// bytes from the start of the device
+	uint64_t	size;			// bytes (for "dynamic": to the device's end)
+	bool		dynamic;
+	uint64_t	iv_tweak;		// added to the IV, in 512-byte sectors
+	uint32_t	sector_size;
+	uint32_t	key_size;		// of the volume key
+};
+
+
+struct luks2_volume {
+	char		uuid[LUKS2_UUID_SIZE];
+	char		label[LUKS2_LABEL_SIZE];
+	char		subsystem[LUKS2_LABEL_SIZE];
+	uint64_t	header_size;	// binary header + JSON area
+	uint64_t	sequence_id;
+	int			header_hash;
+	bool		primary_valid;
+	bool		secondary_valid;
+
+	luks2_json*	json;
+	uint64_t	json_size;
+	uint64_t	keyslots_size;
+
+	luks2_keyslot keyslots[LUKS2_MAX_KEYSLOTS];
+	luks2_digest digests[LUKS2_MAX_DIGESTS];
+	luks2_segment segment;
+	int			segment_digest;	// the digest covering segment 0
+	bool		allow_discards;
+};
+
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+const char* luks2_error_string(int error);
+
+/*!	A quick check of the first 512 bytes of a device: the LUKS magic and
+	version 2. */
+bool luks2_has_signature(const void* firstSector, size_t length);
+
+/*!	Reads both header copies, checks their checksums, picks the newer valid
+	one, parses and checks the metadata. */
+int luks2_read_header(const luks2_device_io* io, luks2_volume** _volume);
+void luks2_free_volume(luks2_volume* volume);
+
+/*!	Tries the keyslots that can open segment 0 with \a passphrase: the
+	given one, or all with priority 2 then 1 when \a keyslot is -1.
+	\a key must hold LUKS2_MAX_KEY_SIZE bytes; the volume key's size is
+	returned in \a _keySize, the keyslot in \a _keyslot (may be NULL). */
+int luks2_unlock(const luks2_volume* volume, const luks2_device_io* io,
+	const void* passphrase, size_t passphraseLength, int keyslot,
+	uint8_t* key, size_t* _keySize, int* _keyslot);
+
+/*!	Checks a volume key against segment 0's digest. */
+int luks2_check_key(const luks2_volume* volume, const uint8_t* key,
+	size_t keySize);
+
+/*!	Sets up the data cipher for segment 0. */
+int luks2_setup_cipher(const luks2_volume* volume, const uint8_t* key,
+	size_t keySize, luks2_xts* xts);
+
+/*!	The plain64 IV of the segment sector that starts at \a segmentOffset
+	(bytes from the start of the segment). */
+static inline uint64_t
+luks2_sector_iv(const luks2_volume* volume, uint64_t segmentOffset)
+{
+	return segmentOffset / LUKS2_IV_SECTOR_SIZE + volume->segment.iv_tweak;
+}
+
+/*!	Tells whether an Argon2 keyslot fits in \a availableKiB (for callers
+	that want to say why a keyslot was skipped). */
+bool luks2_keyslot_memory_fits(const luks2_keyslot* keyslot,
+	uint64_t availableKiB);
+
+
+// Creating and changing volumes (the tools; not built into the kernel or
+// the boot loader). They need luks2_random(), which the tool provides.
+
+/*!	Fills \a buffer with cryptographically secure random bytes; returns 0
+	on success. Provided by whoever links the writing code. */
+int luks2_random(void* buffer, size_t size);
+
+struct luks2_format_parameters {
+	const char*	label;			// may be NULL
+	const char*	uuid;			// NULL: a random one
+	uint32_t	sector_size;	// 512 to 4096
+	uint32_t	key_size;		// 32 or 64 (AES-128/256-XTS)
+	uint64_t	data_offset;	// 0: LUKS2_DEFAULT_DATA_OFFSET
+	uint64_t	header_size;	// 0: LUKS2_DEFAULT_HEADER_SIZE
+	luks2_kdf	kdf;			// the salt is generated
+	uint32_t	stripes;		// 0: LUKS2_DEFAULT_STRIPES
+	uint32_t	digest_iterations;
+								// 0: LUKS2_DEFAULT_DIGEST_ITERATIONS
+};
+
+/*!	Writes a new LUKS2 header with keyslot 0 for \a passphrase and a new
+	random volume key, which is returned in \a key (may be NULL). Doesn't
+	touch the data area. */
+int luks2_format(const luks2_device_io* io,
+	const luks2_format_parameters* parameters, const void* passphrase,
+	size_t passphraseLength, uint8_t* key, size_t* _keySize);
+
+/*!	Adds a keyslot for \a passphrase holding \a key (checked against the
+	digest first); \a keyslot -1 picks the first free one. Updates
+	\a volume. */
+int luks2_add_keyslot(luks2_volume* volume, const luks2_device_io* io,
+	const uint8_t* key, size_t keySize, const void* passphrase,
+	size_t passphraseLength, const luks2_kdf* kdf, int keyslot,
+	int* _keyslot);
+
+/*!	Removes a keyslot and overwrites its area with random data. */
+int luks2_remove_keyslot(luks2_volume* volume, const luks2_device_io* io,
+	int keyslot);
+
+
+#ifdef __cplusplus
+}
+#endif
+
+
+#endif	// _LUKS2_H
diff --git a/headers/private/luks2/luks2_crypto.h b/headers/private/luks2/luks2_crypto.h
new file mode 100644
index 0000000000..a04f9b4f32
--- /dev/null
+++ b/headers/private/luks2/luks2_crypto.h
@@ -0,0 +1,224 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LUKS2_CRYPTO_H
+#define _LUKS2_CRYPTO_H
+
+
+/*!	The cryptographic primitives the LUKS2 code needs. Everything here is
+	portable C/C++ with no OS or CPU assumptions; the AES implementation can
+	be accelerated by a CPU-specific implementation picked at key setup
+	(see luks2_aes_set_key()). Used by the kernel driver, the boot loader,
+	the command line tool and the host tests.
+*/
+
+
+#include <stddef.h>
+#include <stdint.h>
+
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+/* helpers */
+
+/*! Overwrites \a size bytes with zeros in a way the compiler can't drop. */
+void luks2_wipe(void* buffer, size_t size);
+
+/*! Compares in constant time; returns 1 when equal. */
+int luks2_equal(const void* a, const void* b, size_t size);
+
+
+/* AES */
+
+#define LUKS2_AES_BLOCK_SIZE	16
+
+enum {
+	LUKS2_AES_PORTABLE = 0,		/* constant-time bitsliced C */
+	LUKS2_AES_X86_AESNI,		/* x86/x86_64 AES-NI */
+	LUKS2_AES_ARM64_CE			/* reserved: ARMv8 crypto extensions */
+};
+
+typedef struct luks2_aes_ct {
+	uint32_t	sk_exp[120];
+	unsigned	num_rounds;
+} luks2_aes_ct;
+
+typedef struct luks2_aes {
+	/* round keys of the accelerated implementation (encryption, then
+	   decryption), 16-byte aligned */
+	uint8_t		round_keys[2][15 * 16] __attribute__((aligned(16)));
+	luks2_aes_ct portable;
+	unsigned	rounds;
+	int			implementation;
+} luks2_aes;
+
+/*!	Sets the key (16, 24 or 32 bytes). Picks an accelerated implementation
+	when the CPU has one and acceleration isn't disabled.
+	Returns 0 on success, -1 for a bad key length. */
+int luks2_aes_set_key(luks2_aes* aes, const uint8_t* key, size_t length);
+void luks2_aes_encrypt(const luks2_aes* aes, const uint8_t* in, uint8_t* out,
+	size_t blocks);
+void luks2_aes_decrypt(const luks2_aes* aes, const uint8_t* in, uint8_t* out,
+	size_t blocks);
+void luks2_aes_clear(luks2_aes* aes);
+
+/*!	Globally allows or forbids the accelerated implementations for keys set
+	from now on (for tests and benchmarks). Allowed by default. */
+void luks2_aes_allow_acceleration(int allow);
+
+/*!	The implementation that luks2_aes_set_key() would pick now. */
+int luks2_aes_best_implementation(void);
+const char* luks2_aes_implementation_name(int implementation);
+
+
+/* XTS (IEEE 1619) on AES, no ciphertext stealing: lengths are multiples of
+   16 bytes */
+
+typedef struct luks2_xts {
+	luks2_aes	data;
+	luks2_aes	tweak;
+} luks2_xts;
+
+/*!	\a key holds both keys (32 or 64 bytes: AES-128 or AES-256).
+	Returns 0 on success. */
+int luks2_xts_set_key(luks2_xts* xts, const uint8_t* key, size_t length);
+void luks2_xts_clear(luks2_xts* xts);
+
+/*!	Encrypts/decrypts one data unit (sector) in place. \a iv is the
+	plain64 IV: the sector number, as a little-endian 128-bit tweak. */
+void luks2_xts_encrypt(const luks2_xts* xts, uint64_t iv, uint8_t* buffer,
+	size_t length);
+void luks2_xts_decrypt(const luks2_xts* xts, uint64_t iv, uint8_t* buffer,
+	size_t length);
+
+
+/* SHA-2 */
+
+#define LUKS2_SHA256_DIGEST_SIZE	32
+#define LUKS2_SHA256_BLOCK_SIZE		64
+#define LUKS2_SHA512_DIGEST_SIZE	64
+#define LUKS2_SHA512_BLOCK_SIZE		128
+#define LUKS2_MAX_DIGEST_SIZE		64
+#define LUKS2_MAX_HASH_BLOCK_SIZE	128
+
+typedef struct luks2_sha256 {
+	uint32_t	state[8];
+	uint64_t	length;
+	uint8_t		buffer[64];
+	size_t		used;
+} luks2_sha256;
+
+typedef struct luks2_sha512 {
+	uint64_t	state[8];
+	uint64_t	length;
+	uint8_t		buffer[128];
+	size_t		used;
+} luks2_sha512;
+
+void luks2_sha256_init(luks2_sha256* context);
+void luks2_sha256_update(luks2_sha256* context, const void* data,
+	size_t length);
+void luks2_sha256_final(luks2_sha256* context, uint8_t* digest);
+
+void luks2_sha512_init(luks2_sha512* context);
+void luks2_sha512_update(luks2_sha512* context, const void* data,
+	size_t length);
+void luks2_sha512_final(luks2_sha512* context, uint8_t* digest);
+
+
+/* A hash picked by name, for HMAC, PBKDF2 and the anti-forensic split */
+
+enum {
+	LUKS2_HASH_SHA256 = 1,
+	LUKS2_HASH_SHA512
+};
+
+typedef struct luks2_hash {
+	int			algorithm;
+	union {
+		luks2_sha256	sha256;
+		luks2_sha512	sha512;
+	} u;
+} luks2_hash;
+
+/*!	Returns the algorithm for a LUKS2 hash name ("sha256", "sha512"), or 0. */
+int luks2_hash_from_name(const char* name);
+const char* luks2_hash_name(int algorithm);
+size_t luks2_hash_digest_size(int algorithm);
+size_t luks2_hash_block_size(int algorithm);
+void luks2_hash_init(luks2_hash* hash, int algorithm);
+void luks2_hash_update(luks2_hash* hash, const void* data, size_t length);
+void luks2_hash_final(luks2_hash* hash, uint8_t* digest);
+
+
+/* HMAC and PBKDF2 (RFC 2104, RFC 8018) */
+
+typedef struct luks2_hmac {
+	luks2_hash	inner;
+	luks2_hash	outer;
+} luks2_hmac;
+
+void luks2_hmac_init(luks2_hmac* hmac, int algorithm, const void* key,
+	size_t keyLength);
+void luks2_hmac_update(luks2_hmac* hmac, const void* data, size_t length);
+void luks2_hmac_final(luks2_hmac* hmac, uint8_t* mac);
+
+/*!	Returns 0 on success, -1 for bad arguments. */
+int luks2_pbkdf2(int algorithm, const void* password, size_t passwordLength,
+	const void* salt, size_t saltLength, uint32_t iterations, uint8_t* output,
+	size_t outputLength);
+
+
+/* BLAKE2b (RFC 7693) */
+
+typedef struct luks2_blake2b {
+	uint64_t	h[8];
+	uint64_t	t[2];
+	uint8_t		buffer[128];
+	size_t		used;
+	size_t		outputLength;
+} luks2_blake2b;
+
+int luks2_blake2b_init(luks2_blake2b* context, size_t outputLength,
+	const void* key, size_t keyLength);
+void luks2_blake2b_update(luks2_blake2b* context, const void* data,
+	size_t length);
+void luks2_blake2b_final(luks2_blake2b* context, uint8_t* output);
+
+
+/* Argon2 (RFC 9106), version 0x13 */
+
+enum {
+	LUKS2_ARGON2D = 0,
+	LUKS2_ARGON2I = 1,
+	LUKS2_ARGON2ID = 2
+};
+
+enum {
+	LUKS2_ARGON2_OK = 0,
+	LUKS2_ARGON2_BAD_PARAMETERS = -1,
+	LUKS2_ARGON2_NO_MEMORY = -2
+};
+
+/*!	Computes Argon2 single-threaded; the lanes are computed one after the
+	other, which gives the same result as a parallel computation.
+	\a memoryKiB is the memory cost in KiB (blocks), \a lanes the
+	parallelism. Each lane is allocated separately with malloc() and wiped
+	before it's freed. */
+int luks2_argon2(int type, uint32_t timeCost, uint32_t memoryKiB,
+	uint32_t lanes, const void* password, size_t passwordLength,
+	const void* salt, size_t saltLength, const void* secret,
+	size_t secretLength, const void* associatedData,
+	size_t associatedDataLength, uint8_t* output, size_t outputLength);
+
+
+#ifdef __cplusplus
+}
+#endif
+
+
+#endif	/* _LUKS2_CRYPTO_H */
diff --git a/headers/private/luks2/luks2_driver.h b/headers/private/luks2/luks2_driver.h
new file mode 100644
index 0000000000..270187fe9d
--- /dev/null
+++ b/headers/private/luks2/luks2_driver.h
@@ -0,0 +1,91 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LUKS2_DRIVER_H
+#define _LUKS2_DRIVER_H
+
+
+/*!	The interface of the luks_disk driver (drivers/disk/virtual/luks_disk):
+	ioctls on its control device, and the module the kernel uses at boot to
+	open the volume the boot loader unlocked.
+*/
+
+
+#include <Drivers.h>
+#include <limits.h>
+
+
+#define LUKS2_CONTROL_DEVICE_NAME	"disk/virtual/luks/control"
+#define LUKS2_RAW_DEVICE_BASE_NAME	"disk/virtual/luks"
+#define LUKS2_MAX_DEVICES			32
+
+#define LUKS2_DRIVER_INTERFACE_VERSION	1
+
+
+enum {
+	LUKS2_IOCTL_OPEN = B_DEVICE_OP_CODES_END + 0x4c00,
+	LUKS2_IOCTL_CLOSE,
+	LUKS2_IOCTL_GET_INFO,
+	LUKS2_IOCTL_GET_DEVICE_INFO		// on a raw device
+};
+
+
+enum {
+	LUKS2_OPEN_READ_ONLY = 0x01
+};
+
+
+struct luks2_open_request {
+	uint32	version;				// LUKS2_DRIVER_INTERFACE_VERSION
+	uint32	flags;
+	char	path[PATH_MAX];			// the LUKS2 partition or disk
+	uint8	key[64];				// the volume key
+	uint32	key_size;
+	int32	id;						// out
+	char	device[PATH_MAX];		// out: "/dev/disk/virtual/luks/<id>/raw"
+};
+
+
+struct luks2_close_request {
+	uint32	version;
+	int32	id;
+};
+
+
+struct luks2_device_info {
+	uint32	version;
+	int32	id;						// in for GET_INFO (the first open
+									// device with this or a higher ID); out
+	char	path[PATH_MAX];			// the underlying device
+	char	device[PATH_MAX];
+	char	uuid[40];
+	char	label[48];
+	uint64	size;					// of the decrypted device, in bytes
+	uint32	sector_size;
+	uint32	key_bits;
+	uint32	flags;
+	int32	open_count;
+	char	implementation[32];		// the AES implementation in use
+};
+
+
+// The module the kernel's boot code uses (vfs_boot.cpp), exported by the
+// driver add-on.
+#define LUKS2_BOOT_MODULE_NAME	"drivers/disk/virtual/luks_disk/boot/v1"
+
+#ifdef _KERNEL_MODE
+#include <module.h>
+
+typedef struct luks2_boot_module_info {
+	module_info	info;
+
+	/*!	Opens the LUKS2 volume at \a path with \a key (checked against the
+		header). The decrypted device's path is returned in \a device. */
+	status_t	(*open_volume)(const char* path, const uint8* key,
+					size_t keySize, char* device, size_t deviceSize);
+} luks2_boot_module_info;
+#endif
+
+
+#endif	// _LUKS2_DRIVER_H
diff --git a/headers/private/luks2/luks2_json.h b/headers/private/luks2/luks2_json.h
new file mode 100644
index 0000000000..f8affbae16
--- /dev/null
+++ b/headers/private/luks2/luks2_json.h
@@ -0,0 +1,82 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LUKS2_JSON_H
+#define _LUKS2_JSON_H
+
+
+/*!	A small JSON parser and serialiser for the LUKS2 metadata: a tree of
+	nodes allocated with malloc(), no recursion deeper than
+	LUKS2_JSON_MAX_DEPTH, numbers kept as text (LUKS2 stores big integers
+	as strings anyway). Unknown content survives a parse/serialise round
+	trip, so rewriting a header keeps fields this code doesn't know.
+*/
+
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+
+#define LUKS2_JSON_MAX_DEPTH	32
+
+
+enum luks2_json_type {
+	LUKS2_JSON_NULL = 0,
+	LUKS2_JSON_FALSE,
+	LUKS2_JSON_TRUE,
+	LUKS2_JSON_NUMBER,
+	LUKS2_JSON_STRING,
+	LUKS2_JSON_ARRAY,
+	LUKS2_JSON_OBJECT
+};
+
+
+struct luks2_json {
+	luks2_json_type	type;
+	char*			key;		// member name, when inside an object
+	char*			text;		// string value, or a number's text
+	luks2_json*		first;		// children of arrays and objects
+	luks2_json*		last;
+	luks2_json*		next;
+};
+
+
+luks2_json* luks2_json_parse(const char* text, size_t length);
+void luks2_json_free(luks2_json* node);
+
+/*!	Writes compact JSON into \a buffer (NUL-terminated). Returns the length
+	without the NUL, or -1 if it doesn't fit. */
+ssize_t luks2_json_serialize(const luks2_json* node, char* buffer,
+	size_t size);
+
+luks2_json* luks2_json_get(const luks2_json* object, const char* key);
+luks2_json* luks2_json_get_typed(const luks2_json* object, const char* key,
+	luks2_json_type type);
+const char* luks2_json_get_string(const luks2_json* object, const char* key);
+
+/*!	Reads a non-negative integer stored as a JSON number or as a decimal
+	string (the LUKS2 convention for 64-bit values). Returns false if
+	it's missing or isn't such an integer. */
+bool luks2_json_get_uint64(const luks2_json* object, const char* key,
+	uint64_t* _value);
+bool luks2_json_to_uint64(const luks2_json* node, uint64_t* _value);
+
+size_t luks2_json_count(const luks2_json* node);
+
+// building and changing trees; all return NULL/false when out of memory
+luks2_json* luks2_json_new(luks2_json_type type, const char* text);
+luks2_json* luks2_json_new_uint64(uint64_t value, bool asString);
+/*!	Adds \a value as member \a key (replacing an existing one) and takes
+	ownership of \a value, also on failure. */
+bool luks2_json_set(luks2_json* object, const char* key, luks2_json* value);
+bool luks2_json_append(luks2_json* array, luks2_json* value);
+/*!	Removes and frees a member; returns false if there was none. */
+bool luks2_json_remove(luks2_json* object, const char* key);
+/*!	Removes and frees the first array element that is the string \a text. */
+bool luks2_json_remove_string(luks2_json* array, const char* text);
+luks2_json* luks2_json_clone(const luks2_json* node);
+
+
+#endif	// _LUKS2_JSON_H
