diff --git a/src/system/boot/loader/heap.cpp b/src/system/boot/loader/heap.cpp
index 043be1395e..c55cca2088 100644
--- a/src/system/boot/loader/heap.cpp
+++ b/src/system/boot/loader/heap.cpp
@@ -120,13 +120,57 @@ struct LargeAllocationHashDefinition {
 typedef BOpenHashTable<LargeAllocationHashDefinition> LargeAllocationHashTable;
 
 
-static void* sHeapBase;
-static void* sHeapEnd;
+#ifdef BOOT_SUPPORT_HEAP_GROWTH
+static const int32 kMaxHeapRegions = 8;
+	// when the heap runs out, another region of kDefaultHeapSize is added
+#else
+static const int32 kMaxHeapRegions = 1;
+#endif
+
+struct HeapRegion {
+	void*	base;
+	size_t	size;
+};
+
+static HeapRegion sHeapRegions[kMaxHeapRegions];
+static int32 sHeapRegionCount;
 static SimpleAllocator<kAlignment> sAllocator;
 
 static LargeAllocationHashTable sLargeAllocations;
 
 
+static bool
+is_heap_address(void* address)
+{
+	for (int32 i = 0; i < sHeapRegionCount; i++) {
+		if (address >= sHeapRegions[i].base
+			&& address < (uint8*)sHeapRegions[i].base + sHeapRegions[i].size) {
+			return true;
+		}
+	}
+	return false;
+}
+
+
+static status_t
+add_heap_region(size_t size)
+{
+	if (sHeapRegionCount >= kMaxHeapRegions)
+		return B_NO_MEMORY;
+
+	void* base;
+	ssize_t actualSize = platform_allocate_heap_region(size, &base);
+	if (actualSize < 0)
+		return B_NO_MEMORY;
+
+	sHeapRegions[sHeapRegionCount].base = base;
+	sHeapRegions[sHeapRegionCount].size = actualSize;
+	sHeapRegionCount++;
+	sAllocator.AddChunk(base, actualSize);
+	return B_OK;
+}
+
+
 static void*
 malloc_large(size_t size)
 {
@@ -176,9 +220,10 @@ heap_release()
 		allocation = next;
 	}
 
-	platform_free_heap_region(sHeapBase, (addr_t)sHeapEnd - (addr_t)sHeapBase);
+	for (int32 i = 0; i < sHeapRegionCount; i++)
+		platform_free_heap_region(sHeapRegions[i].base, sHeapRegions[i].size);
 
-	sHeapBase = sHeapEnd = NULL;
+	sHeapRegionCount = 0;
 	memset((void*)&sAllocator, 0, sizeof(sAllocator));
 	memset((void*)&sLargeAllocations, 0, sizeof(sLargeAllocations));
 }
@@ -200,16 +245,9 @@ heap_init(stage2_args* args)
 	if (args->heap_size == 0)
 		args->heap_size = kDefaultHeapSize;
 
-	void* base;
-	ssize_t size = platform_allocate_heap_region(args->heap_size, &base);
-	if (size < 0)
+	if (add_heap_region(args->heap_size) != B_OK)
 		return B_ERROR;
 
-	sHeapBase = base;
-	sHeapEnd = (void*)((addr_t)base + size);
-
-	sAllocator.AddChunk(sHeapBase, size);
-
 	if (sLargeAllocations.Init(64) != B_OK)
 		return B_NO_MEMORY;
 
@@ -227,13 +265,24 @@ heap_available()
 void*
 malloc(size_t size)
 {
-	if (sHeapBase == NULL)
+	if (sHeapRegionCount == 0)
 		return NULL;
 
 	if (size >= kLargeAllocationThreshold)
 		return malloc_large(size);
 
 	void* allocated = sAllocator.Allocate(size);
+#ifdef BOOT_SUPPORT_HEAP_GROWTH
+	if (allocated == NULL && size != 0
+		&& add_heap_region(kDefaultHeapSize) == B_OK) {
+		// The boot menu mounts the system package of each installed system
+		// it lists, some 700 KB of heap apiece, and their old states add
+		// more: two systems can be too much for one region.
+		dprintf("malloc(): heap region %" B_PRId32 " added\n",
+			sHeapRegionCount);
+		allocated = sAllocator.Allocate(size);
+	}
+#endif
 	if (allocated == NULL) {
 		if (size == 0)
 			return allocated;
@@ -264,7 +313,7 @@ realloc(void* oldBuffer, size_t newSize)
 
 	size_t oldSize = 0;
 	if (oldBuffer != NULL) {
-		if (oldBuffer >= sHeapBase && oldBuffer < sHeapEnd) {
+		if (is_heap_address(oldBuffer)) {
 			oldSize = sAllocator.UsableSize(oldBuffer);
 		} else {
 			LargeAllocation* allocation = sLargeAllocations.Lookup(oldBuffer);
@@ -318,7 +367,7 @@ free(void* allocated)
 
 	TRACE("free(%p)\n", allocated);
 
-	if (allocated < sHeapBase || allocated >= sHeapEnd) {
+	if (!is_heap_address(allocated)) {
 		free_large(allocated);
 		return;
 	}
