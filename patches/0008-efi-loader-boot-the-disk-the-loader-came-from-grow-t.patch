 class EfiDevice : public Node
@@ -139,6 +143,61 @@ device_contains_partition(EfiDevice *device, boot::Partition *partition)
 }
 
 
+static uint16
+device_path_node_length(const efi_device_path_protocol* node)
+{
+	// device path nodes needn't be aligned
+	uint16 length;
+	memcpy(&length, &node->Length, sizeof(length));
+	return length;
+}
+
+
+/*!	Whether \a disk's device path is the start of \a path, or all of it:
+	then \a path names the disk, or a partition (or an El Torito image) on
+	it. */
+static bool
+device_path_starts_with(const efi_device_path_protocol* path,
+	const efi_device_path_protocol* disk)
+{
+	int32 nodes = 0;
+	while (disk->Type != DEVICE_PATH_END) {
+		uint16 length = device_path_node_length(disk);
+		if (length < sizeof(efi_device_path_protocol) || ++nodes > 64
+			|| path->Type == DEVICE_PATH_END
+			|| device_path_node_length(path) != length
+			|| memcmp(path, disk, length) != 0) {
+			return false;
+		}
+		path = (const efi_device_path_protocol*)((const uint8*)path + length);
+		disk = (const efi_device_path_protocol*)((const uint8*)disk + length);
+	}
+	return nodes > 0;
+}
+
+
+/*!	The device path of what the firmware loaded the boot loader from: a
+	partition (the ESP), or an El Torito image when it booted a hybrid
+	anyboot image the way it boots a CD. NULL if the firmware doesn't say. */
+static const efi_device_path_protocol*
+boot_loader_device_path()
+{
+	efi_loaded_image_protocol* loadedImage;
+	if (kBootServices->HandleProtocol(kImage, &LoadedImageGUID,
+			(void**)&loadedImage) != EFI_SUCCESS
+		|| loadedImage->DeviceHandle == NULL) {
+		return NULL;
+	}
+
+	efi_device_path_protocol* path;
+	if (kBootServices->HandleProtocol(loadedImage->DeviceHandle,
+			&DevicePathGUID, (void**)&path) != EFI_SUCCESS) {
+		return NULL;
+	}
+	return path;
+}
+
+
 status_t
 platform_add_boot_device(struct stage2_args *args, NodeList *devicesList)
 {
@@ -150,17 +209,22 @@ platform_add_boot_device(struct stage2_args *args, NodeList *devicesList)
 	// If the bootloader was started from the network (net_stack_init will find
 	// the ip= parameter in the LoadOptions), add network booting as the first
 	// entry if available
+	RemoteDisk* remoteDisk = NULL;
 	status_t error = net_stack_init();
 	if (error != B_OK) {
 		TRACE("Can't init network...\n");
 	} else {
 		TRACE("Network is initialized! Search for remote disk...\n");
-		RemoteDisk *remoteDisk = RemoteDisk::FindAnyRemoteDisk();
+		remoteDisk = RemoteDisk::FindAnyRemoteDisk();
 		if (remoteDisk != NULL) {
 			devicesList->Add(remoteDisk);
 		}
 	}
 
+	const efi_device_path_protocol* loaderPath = boot_loader_device_path();
+	EfiDevice* loaderDisk = NULL;
+	int32 diskCount = 0;
+
 	// Read to zero sized buffer to get memory needed for handles
 	if (kBootServices->LocateHandle(ByProtocol, &BlockIoGUID, 0, &memSize, 0)
 			!= EFI_BUFFER_TOO_SMALL)
@@ -206,8 +270,33 @@ platform_add_boot_device(struct stage2_args *args, NodeList *devicesList)
 		if (device == NULL)
 			panic("Can't allocate memory for block devices!");
 		devicesList->Insert(device);
+
+		efi_device_path_protocol* diskPath;
+		bool isLoaderDisk = loaderDisk == NULL && loaderPath != NULL
+			&& kBootServices->HandleProtocol(handles[n], &DevicePathGUID,
+				(void**)&diskPath) == EFI_SUCCESS
+			&& device_path_starts_with(loaderPath, diskPath);
+		if (isLoaderDisk)
+			loaderDisk = device;
+
+		dprintf("efi: disk %" B_PRId32 ": %" B_PRIu64 " MiB, %" B_PRIu32
+			"-byte blocks%s%s\n", diskCount++,
+			(uint64)device->Size() / (1024 * 1024), device->BlockSize(),
+			blockIo->Media->RemovableMedia ? ", removable" : "",
+			isLoaderDisk ? ", the boot loader's" : "");
 	}
 
+	if (loaderDisk != NULL) {
+		// Look for the system on the disk the firmware loaded us from first
+		// (after a network disk, which only ip= in the load options adds):
+		// when other disks hold a Haiku system too, the one the firmware was
+		// told to boot is still what the user picked. The firmware lists the
+		// built-in disks first.
+		devicesList->Remove(loaderDisk);
+		devicesList->InsertAfter(remoteDisk, loaderDisk);
+	} else
+		dprintf("efi: the boot loader's disk is unknown\n");
+
 	return devicesList->Count() > 0 ? B_OK : B_ENTRY_NOT_FOUND;
 }
 
