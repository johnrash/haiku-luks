@@ -0,0 +1,185 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# The EFI boot loader on a machine that has Haiku installed on its internal
+# disk, started from a USB stick (QEMU x86_64, OVMF): the firmware lists the
+# internal disk first, as some laptops do. The internal disk is a
+# raw BFS volume with the image's system package and 152 old package
+# states; the stick is the anyboot image with the new loader.
+#  - boot 1: no keys pressed: the loader must boot the stick's system, the
+#    disk it was loaded from, not the internal disk's;
+#  - boot 2: the boot menu must list both systems (on a laptop, the heap
+#    ran out while the stick was checked, and it was missing);
+#  - boot 3: loaded from a disk with only an ESP, the loader falls back to
+#    the internal disk and its 152 states; the menu must still list the
+#    stick, which needs a second heap region.
+#
+# Usage: run-loader-disk-test.sh <anyboot image> <haiku_loader.efi>
+#            <work dir> <bfs_shell>
+
+set -e
+IMAGE=$1
+LOADER=$2
+W=$3
+BFS=$4
+HERE=$(cd "$(dirname "$0")" && pwd)
+mkdir -p "$W"
+cd "$W"
+
+passed=0
+failed=0
+ok() { passed=$((passed + 1)); echo "ok   $*"; }
+bad() { failed=$((failed + 1)); echo "FAIL $*"; }
+
+set -- $(python3 -I "$HERE/anyboot_layout.py" "$IMAGE")
+bfsStart=$1
+bfsEnd=$2
+espStart=$3
+elToritoStart=$4
+if [ -z "$elToritoStart" ]; then
+	echo "$IMAGE isn't an anyboot image"
+	exit 1
+fi
+
+echo "== the stick: the anyboot image with the new loader in both places"
+cp "$IMAGE" stick.img
+mcopy -o -i stick.img@@$elToritoStart "$LOADER" ::/EFI/BOOT/BOOTX64.EFI
+mcopy -o -i stick.img@@$espStart "$LOADER" ::/EFI/BOOT/BOOTX64.EFI
+
+echo "== the internal disk: raw BFS, the system package, 152 old states"
+package=$(printf 'ls /myfs/system/packages\nquit\n' \
+	| "$BFS" --start-offset $bfsStart --end-offset $bfsEnd "$IMAGE" 2>&1 \
+	| grep -a -o 'haiku-r[^ ]*\.hpkg' | head -1)
+rm -f "$package" internal.img
+printf 'cp /myfs/system/packages/%s :%s/%s\nquit\n' "$package" "$W" \
+	"$package" | "$BFS" --start-offset $bfsStart --end-offset $bfsEnd \
+	"$IMAGE" > /dev/null 2>&1
+printf '%s\n' "$package" > activated-packages
+truncate -s 1200M internal.img
+"$BFS" --initialize internal.img "Haiku HD" "block_size 2048" > /dev/null
+{
+	echo "mkdir -p /myfs/system/packages/administrative"
+	echo "cp :$W/$package /myfs/system/packages/$package"
+	for day in $(seq 6 24); do
+		for hour in 01 02 03 04 05 06 07 08; do
+			state=state_2026-10-$(printf %02d $day)_$hour:00:00
+			echo "mkdir /myfs/system/packages/administrative/$state"
+			echo "cp :$W/activated-packages" \
+				"/myfs/system/packages/administrative/$state/activated-packages"
+		done
+	done
+	echo sync
+	echo quit
+} | "$BFS" internal.img > internal.log 2>&1
+rm -f "$package"
+
+echo "== a disk with only an ESP, holding the new loader"
+rm -f esp.img
+truncate -s 64M esp.img
+sgdisk -n 1:2048:0 -t 1:ef00 esp.img > /dev/null
+mformat -i esp.img@@1M -F -v ESP ::
+mmd -i esp.img@@1M ::/EFI ::/EFI/BOOT
+mcopy -i esp.img@@1M "$LOADER" ::/EFI/BOOT/BOOTX64.EFI
+
+# boot <name> <extra QEMU options> <console options...>
+# The internal disk is connected first (bootindex 0, nothing to boot on it)
+# so that the firmware lists it first; the stick follows.
+boot() {
+	name=$1
+	extra=$2
+	shift 2
+	cp /usr/share/OVMF/OVMF_VARS_4M.fd vars-$name.fd
+	rm -f serial-$name.sock
+	timeout 900 qemu-system-x86_64 -M q35 -cpu max -smp 2 -m 2048 \
+		-accel tcg,thread=multi \
+		-drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
+		-drive if=pflash,format=raw,file=vars-$name.fd \
+		$extra \
+		-drive if=none,id=internal,file=internal.img,format=raw,snapshot=on \
+		-device nvme,drive=internal,serial=internal,bootindex=1 \
+		-device qemu-xhci,id=xhci \
+		-drive if=none,id=stick,file=stick.img,format=raw,snapshot=on \
+		-device usb-storage,bus=xhci.0,drive=stick,bootindex=2 \
+		-nic none -display none -no-reboot \
+		-chardev socket,id=ser0,path=serial-$name.sock,server=on,wait=on \
+		-serial chardev:ser0 \
+		> qemu-$name.log 2>&1 &
+	qemu=$!
+	python3 -I "$HERE/loader_console.py" serial-$name.sock serial-$name.log \
+		"$@" || true
+	kill $qemu 2>/dev/null || true
+	wait $qemu 2>/dev/null || true
+	# the console as lines, without escape sequences
+	sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' serial-$name.log | tr '\r' '\n' \
+		> text-$name.log
+	grep -a -E "^efi: |heap region|Out of memory|Mounted boot partition" \
+		text-$name.log | sed 's/^/  /' || true
+}
+
+listed() {
+	# listed <name> <volume>: the volume list shows the volume (only what
+	# follows the list's title: the main menu names the boot volume too)
+	sed -n '/Select Boot Volume\/State/,$p' text-$1.log \
+		| sed '1s/.*Select Boot Volume\/State//' \
+		| grep -a -q -E "$2 \([0-9.]+ [MG]iB\)"
+}
+
+echo "== boot 1: the loader boots the stick, not the internal disk"
+boot first "" --until "Mounted boot partition" --timeout 600
+stickMiB=$(( $(stat -c %s stick.img) / 1048576 ))
+if grep -a -q -E "^efi: disk [0-9]+: $stickMiB MiB.*the boot loader's" \
+		text-first.log; then
+	ok "the loader found the disk it was loaded from"
+else
+	bad "the loader found the disk it was loaded from"
+fi
+if grep -a -q "Mounted boot partition: /dev/disk/usb/" text-first.log; then
+	ok "Haiku booted from the stick"
+else
+	bad "Haiku booted from the stick"
+fi
+
+echo "== boot 2: the boot menu lists both systems"
+boot second "" --menu --timeout 300
+if grep -a -q "Select boot volume/state (Current: Haiku (" text-second.log; then
+	ok "the menu's boot volume is the stick's"
+else
+	bad "the menu's boot volume is the stick's"
+fi
+if listed second "Haiku" && listed second "Haiku HD"; then
+	ok "both systems are listed"
+else
+	bad "both systems are listed"
+fi
+if grep -a -q "Out of memory" text-second.log; then
+	bad "no out of memory"
+else
+	ok "no out of memory"
+fi
+
+echo "== boot 3: from an ESP-only disk: the internal disk boots, the heap grows"
+boot third "-drive if=none,id=esp,file=esp.img,format=raw,snapshot=on
+	-device nvme,drive=esp,serial=esp,bootindex=0" --menu --timeout 300
+if grep -a -q -E "^efi: disk [0-9]+: 64 MiB.*the boot loader's" \
+		text-third.log \
+	&& grep -a -q "Select boot volume/state (Current: Haiku HD (" \
+		text-third.log; then
+	ok "nothing to boot on the loader's disk: the internal disk is used"
+else
+	bad "nothing to boot on the loader's disk: the internal disk is used"
+fi
+if listed third "Haiku" && listed third "Haiku HD"; then
+	ok "both systems are listed"
+else
+	bad "both systems are listed"
+fi
+if grep -a -q "heap region 2 added" text-third.log \
+	&& ! grep -a -q "Out of memory" text-third.log; then
+	ok "the heap grew instead of running out"
+else
+	bad "the heap grew instead of running out"
+fi
+
+echo "$passed passed, $failed failed"
+[ $failed -eq 0 ]
