diff --git a/src/tests/system/luks2/qemu/anyboot_layout.py b/src/tests/system/luks2/qemu/anyboot_layout.py
new file mode 100755
index 0000000000..d6f5fc37dd
--- /dev/null
+++ b/src/tests/system/luks2/qemu/anyboot_layout.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Prints where the parts of an anyboot image are, in bytes:
+#   <BFS start> <BFS end> <ESP partition start> <El Torito EFI image start>
+# The ESP partition (MBR type 0xef) and the El Torito EFI image (what OVMF
+# boots from a hybrid stick) each hold a copy of the EFI boot loader.
+#
+# Usage: anyboot_layout.py <image>
+
+import struct
+import sys
+
+with open(sys.argv[1], "rb") as f:
+    mbr = f.read(512)
+    if mbr[510:512] != b"\x55\xaa":
+        sys.exit("no MBR")
+    bfs = esp = None
+    for i in range(4):
+        entry = mbr[0x1be + 16 * i:0x1be + 16 * (i + 1)]
+        kind = entry[4]
+        start, sectors = struct.unpack_from("<II", entry, 8)
+        if kind == 0xeb and bfs is None:
+            bfs = (start * 512, (start + sectors) * 512)
+        elif kind == 0xef and esp is None:
+            esp = start * 512
+    if bfs is None or esp is None:
+        sys.exit("no BFS or no ESP partition")
+
+    # the El Torito boot record is ISO 9660 sector 17
+    f.seek(17 * 2048)
+    record = f.read(2048)
+    if record[1:6] != b"CD001" or not record[7:30].startswith(b"EL TORITO"):
+        sys.exit("no El Torito boot record")
+    f.seek(struct.unpack_from("<I", record, 0x47)[0] * 2048)
+    catalog = f.read(2048)
+    eltorito = None
+    platform = catalog[1]
+    for i in range(32, 2048, 32):
+        entry = catalog[i:i + 32]
+        if entry[0] in (0x90, 0x91):
+            # a section header: the platform of the entries that follow
+            platform = entry[1]
+        elif entry[0] == 0x88 and platform == 0xef:
+            eltorito = struct.unpack_from("<I", entry, 8)[0] * 2048
+            break
+    if eltorito is None:
+        sys.exit("no El Torito EFI image")
+
+print(bfs[0], bfs[1], esp, eltorito)
diff --git a/src/tests/system/luks2/qemu/loader_console.py b/src/tests/system/luks2/qemu/loader_console.py
new file mode 100755
index 0000000000..ddead9dc12
--- /dev/null
+++ b/src/tests/system/luks2/qemu/loader_console.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Drives a QEMU guest's serial console for run-loader-disk-test.sh and logs
+# everything it reads. With --menu it presses Space until the boot loader's
+# menu shows, opens "Select boot volume/state" and stops once the list is
+# drawn; with --until it stops a moment after the text shows up.
+#
+# Usage: loader_console.py <serial socket> <log> [--menu] [--until <text>]
+#            [--timeout <seconds>]
+
+import socket
+import sys
+import time
+
+serial_path, log_path = sys.argv[1:3]
+options = sys.argv[3:]
+use_menu = "--menu" in options
+until = None
+if "--until" in options:
+    until = options[options.index("--until") + 1].encode()
+timeout = 600
+if "--timeout" in options:
+    timeout = int(options[options.index("--timeout") + 1])
+
+
+def connect(path):
+    deadline = time.time() + 30
+    while True:
+        try:
+            s = socket.socket(socket.AF_UNIX)
+            s.connect(path)
+            return s
+        except OSError:
+            if time.time() > deadline:
+                raise
+            time.sleep(0.2)
+
+
+serial = connect(serial_path)
+serial.settimeout(0.05)
+log = open(log_path, "wb")
+seen = b""
+state = "space" if use_menu else "watch"
+start = time.time()
+last_space = 0
+done_at = None
+
+while time.time() - start < timeout:
+    try:
+        chunk = serial.recv(65536)
+        if not chunk:
+            break
+    except socket.timeout:
+        chunk = b""
+    if chunk:
+        log.write(chunk)
+        log.flush()
+        seen += chunk
+
+    now = time.time()
+    if state == "space":
+        # the loader looks for Space for a moment only: keep pressing it
+        if b"Select boot volume/state" in seen:
+            time.sleep(1.5)
+            serial.sendall(b"\r")
+            state = "list"
+            print("console: opened the volume list", flush=True)
+        elif now - last_space > 0.05:
+            serial.sendall(b" ")
+            last_space = now
+    elif state == "list":
+        title = seen.find(b"Select Boot Volume/State")
+        if title >= 0 and seen.find(b"Rescan volumes", title) >= 0:
+            # let the rest of the screen arrive
+            done_at = now + 3
+            state = "wait"
+    elif state == "wait" and now > done_at:
+        break
+    if until is not None and until in seen:
+        time.sleep(2)
+        break
+
+log.close()
+print("console: done after %d s" % (time.time() - start), flush=True)
