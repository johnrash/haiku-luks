+extern "C" int
+luks2_fd_flush(int fd)
+{
+	struct stat st;
+	if (fstat(fd, &st) != 0)
+		return errno;
+#ifdef __HAIKU__
+	if (!S_ISREG(st.st_mode)) {
+		// devfs ignores fsync(): the driver flushes the drive's cache
+		if (ioctl(fd, B_FLUSH_DRIVE_CACHE, NULL, 0) != 0
+			&& errno != B_DEV_INVALID_IOCTL && errno != B_BAD_VALUE
+			&& errno != B_NOT_SUPPORTED) {
+			return errno;
+		}
+		return 0;
+	}
+#endif
+	// a file, or a Linux block device (whose fsync() flushes the cache);
+	// EINVAL: a special file with nothing to synchronise
+	while (fsync(fd) != 0) {
+		if (errno == EINVAL && !S_ISREG(st.st_mode))
+			return 0;
+		if (errno != EINTR)
+			return errno;
+	}
+	return 0;
+}
+
