+extern "C" int
+luks2_lock_fd(int fd)
+{
+	while (flock(fd, LOCK_EX | LOCK_NB) != 0) {
+		if (errno == EINTR)
+			continue;
+		return errno == EAGAIN ? EWOULDBLOCK : errno;
+	}
+	return 0;
+}
