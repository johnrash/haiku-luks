+	char resolved[PATH_MAX];
+	if (realpath(path, resolved) == NULL)
+		strlcpy(resolved, path, sizeof(resolved));
+
+	luks2_device_info info;
+	if (luks2_find_open_device(resolved, &info) == B_OK)
+		return LUKS2_IN_USE_OPEN;
+
+	struct stat st;
+	if (stat(resolved, &st) == 0) {
+		int32 cookie = 0;
+		dev_t volume;
+		while ((volume = next_dev(&cookie)) >= 0) {
+			fs_info fsInfo;
+			if (fs_stat_dev(volume, &fsInfo) == 0
+				&& fsInfo.device_name[0] == '/'
+				&& same_file(st, fsInfo.device_name)) {
+				return LUKS2_IN_USE_MOUNTED;
+			}
+		}
+	}
+
+	if (has_partitions(resolved))
+		return LUKS2_IN_USE_PARTITIONS;
+	return LUKS2_NOT_IN_USE;
+}
