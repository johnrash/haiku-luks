diff --git a/src/tests/system/luks2/crash_test.cpp b/src/tests/system/luks2/crash_test.cpp
new file mode 100644
index 0000000000..7d79cb073c
--- /dev/null
+++ b/src/tests/system/luks2/crash_test.cpp
@@ -0,0 +1,292 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	A crash model for the LUKS2 writer: adds and removes keyslots on a disk
+	in memory that loses power after each of its writes and flushes in
+	turn. Writes not yet flushed may then be lost, kept, or torn (only their
+	first sector kept, or all but it), in every combination. Each state must
+	still open: a header copy holds up, and the passphrase that was there
+	before opens the volume; a keyslot the header lists opens with its
+	passphrase.
+
+	--no-flush leaves the flush hook out: then states that don't open must
+	turn up (the model notices missing flushes).
+*/
+
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <vector>
+
+#include <luks2/luks2.h>
+
+
+static const size_t kDiskSize = 20 * 1024 * 1024;
+static const size_t kSector = 512;
+static const size_t kMaxCombinations = 1 << 16;
+
+static const char* kOld = "old passphrase";
+static const char* kNew = "new passphrase";
+
+
+struct Write {
+	uint64_t				offset;
+	std::vector<uint8_t>	data;
+};
+
+
+struct Disk {
+	std::vector<uint8_t>	durable;
+	std::vector<uint8_t>	visible;
+	std::vector<Write>		pending;
+	long					operationsLeft;
+	long					operations;
+	bool					crashed;
+
+	explicit Disk(const std::vector<uint8_t>& image)
+		:
+		durable(image),
+		visible(image),
+		operationsLeft(-1),
+		operations(0),
+		crashed(false)
+	{
+	}
+
+	bool Step()
+	{
+		if (crashed)
+			return false;
+		operations++;
+		if (operationsLeft == 0) {
+			crashed = true;
+			return false;
+		}
+		if (operationsLeft > 0)
+			operationsLeft--;
+		return true;
+	}
+};
+
+
+static ssize_t
+disk_read(void* cookie, uint64_t offset, void* buffer, size_t size)
+{
+	Disk& disk = *(Disk*)cookie;
+	if (offset > disk.visible.size() || size > disk.visible.size() - offset)
+		return -1;
+	memcpy(buffer, disk.visible.data() + offset, size);
+	return size;
+}
+
+
+static ssize_t
+disk_write(void* cookie, uint64_t offset, const void* buffer, size_t size)
+{
+	Disk& disk = *(Disk*)cookie;
+	if (!disk.Step())
+		return -1;
+	memcpy(disk.visible.data() + offset, buffer, size);
+	Write write;
+	write.offset = offset;
+	write.data.assign((const uint8_t*)buffer, (const uint8_t*)buffer + size);
+	disk.pending.push_back(write);
+	return size;
+}
+
+
+static int
+disk_flush(void* cookie)
+{
+	Disk& disk = *(Disk*)cookie;
+	if (!disk.Step())
+		return -1;
+	disk.durable = disk.visible;
+	disk.pending.clear();
+	return 0;
+}
+
+
+static luks2_device_io
+make_io(Disk& disk, bool flush)
+{
+	luks2_device_io io = { &disk, disk_read, disk_write, kDiskSize,
+		flush ? disk_flush : NULL };
+	return io;
+}
+
+
+static luks2_kdf
+fast_kdf()
+{
+	luks2_kdf kdf;
+	memset(&kdf, 0, sizeof(kdf));
+	kdf.type = LUKS2_KDF_PBKDF2;
+	kdf.hash = LUKS2_HASH_SHA256;
+	kdf.iterations = 1000;
+	return kdf;
+}
+
+
+static bool
+opens(const luks2_volume* volume, const luks2_device_io* io,
+	const char* passphrase, int keyslot)
+{
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize;
+	int result = luks2_unlock(volume, io, passphrase, strlen(passphrase),
+		keyslot, key, &keySize, NULL);
+	luks2_wipe(key, sizeof(key));
+	return result == LUKS2_OK;
+}
+
+
+enum Operation { kAdd, kRemove };
+
+
+//! Runs the change on \a disk; the result is ignored (it may crash).
+static void
+run(Operation operation, Disk& disk, bool flush)
+{
+	luks2_device_io io = make_io(disk, flush);
+	luks2_volume* volume;
+	if (luks2_read_header(&io, &volume) != LUKS2_OK)
+		return;
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize;
+	if (luks2_unlock(volume, &io, kOld, strlen(kOld), -1, key, &keySize,
+			NULL) == LUKS2_OK) {
+		if (operation == kAdd) {
+			luks2_kdf kdf = fast_kdf();
+			luks2_add_keyslot(volume, &io, key, keySize, kNew, strlen(kNew),
+				&kdf, 1, NULL);
+		} else
+			luks2_remove_keyslot(volume, &io, 1);
+	}
+	luks2_wipe(key, sizeof(key));
+	luks2_free_volume(volume);
+}
+
+
+/*!	Checks one state after a crash; returns an error text, or NULL. */
+static const char*
+check_state(Operation operation, std::vector<uint8_t>& image)
+{
+	Disk disk(image);
+	luks2_device_io io = make_io(disk, true);
+	luks2_volume* volume;
+	if (luks2_read_header(&io, &volume) != LUKS2_OK)
+		return "no header copy holds up";
+
+	const char* problem = NULL;
+	if (!opens(volume, &io, kOld, -1))
+		problem = "the old passphrase doesn't open it";
+	else if (operation == kAdd && volume->keyslots[1].used
+		&& !opens(volume, &io, kNew, 1)) {
+		problem = "the header lists the new keyslot, which doesn't open";
+	}
+	luks2_free_volume(volume);
+	return problem;
+}
+
+
+/*!	All crash points of \a operation on \a base; returns the number of
+	states that don't open. */
+static long
+test(Operation operation, const std::vector<uint8_t>& base, bool flush,
+	long& statesChecked)
+{
+	// a run without a crash counts the steps
+	Disk clean(base);
+	run(operation, clean, flush);
+	long steps = clean.operations;
+
+	long failures = 0;
+	for (long crashAt = 0; crashAt <= steps; crashAt++) {
+		Disk disk(base);
+		disk.operationsLeft = crashAt;
+		run(operation, disk, flush);
+
+		// every fate of every unflushed write: lost, kept, first sector
+		// only, all but the first sector
+		size_t count = disk.pending.size();
+		size_t combinations = 1;
+		for (size_t i = 0; i < count && combinations < kMaxCombinations; i++)
+			combinations *= 4;
+		if (combinations > kMaxCombinations)
+			combinations = kMaxCombinations;
+		for (size_t combination = 0; combination < combinations;
+				combination++) {
+			std::vector<uint8_t> image = disk.durable;
+			size_t fates = combination;
+			for (size_t i = 0; i < count; i++) {
+				const Write& write = disk.pending[i];
+				int fate = fates % 4;
+				fates /= 4;
+				size_t size = write.data.size();
+				size_t first = size < kSector ? size : kSector;
+				if (fate == 1)
+					memcpy(&image[write.offset], write.data.data(), size);
+				else if (fate == 2)
+					memcpy(&image[write.offset], write.data.data(), first);
+				else if (fate == 3) {
+					memcpy(&image[write.offset + first],
+						write.data.data() + first, size - first);
+				}
+			}
+			statesChecked++;
+			const char* problem = check_state(operation, image);
+			if (problem != NULL) {
+				if (failures < 5) {
+					printf("%s, crash after step %ld of %ld, %zu unflushed "
+						"writes (fates %zu): %s\n",
+						operation == kAdd ? "add" : "remove", crashAt, steps,
+						count, combination, problem);
+				}
+				failures++;
+			}
+		}
+	}
+	return failures;
+}
+
+
+int
+main(int argc, char** argv)
+{
+	bool flush = !(argc > 1 && strcmp(argv[1], "--no-flush") == 0);
+
+	// a volume with keyslot 0
+	std::vector<uint8_t> base(kDiskSize, 0);
+	Disk formatDisk(base);
+	luks2_device_io io = make_io(formatDisk, true);
+	luks2_format_parameters parameters;
+	memset(&parameters, 0, sizeof(parameters));
+	parameters.sector_size = 512;
+	parameters.key_size = 64;
+	parameters.digest_iterations = 1000;
+	parameters.kdf = fast_kdf();
+	if (luks2_format(&io, &parameters, kOld, strlen(kOld), NULL, NULL)
+			!= LUKS2_OK) {
+		printf("format failed\n");
+		return 2;
+	}
+	std::vector<uint8_t> oneSlot = formatDisk.visible;
+
+	// the same with keyslot 1 too, for the removal
+	Disk addDisk(oneSlot);
+	run(kAdd, addDisk, true);
+	std::vector<uint8_t> twoSlots = addDisk.visible;
+
+	long states = 0;
+	long failures = test(kAdd, oneSlot, flush, states);
+	failures += test(kRemove, twoSlots, flush, states);
+	printf("%ld crash states, %ld don't open%s\n", states, failures,
+		flush ? "" : " (without flushes)");
+	return failures == 0 ? 0 : 1;
+}
diff --git a/src/tests/system/luks2/cryptsetup_test.sh b/src/tests/system/luks2/cryptsetup_test.sh
index 4950add530..2d594a4872 100755
--- a/src/tests/system/luks2/cryptsetup_test.sh
+++ b/src/tests/system/luks2/cryptsetup_test.sh
@@ -282,5 +282,146 @@ else
 	ok "cryptsetup no longer lists our removed keyslot"
 fi
 
+echo "== the correctness review of 2026-11-11"
+
+# an interrupted update: the newer primary asks for a feature we don't have;
+# the older secondary must not be used instead, nor written over the primary
+python3 -I "$HERE/craft_header.py" cs-base.img newer.img newer-unsupported
+before=$(md5sum < newer.img)
+expect_refused "a newer unsupported header isn't replaced by the older copy" \
+	newer.img k0 "doesn't support"
+if "$LUKS" addkey -k k0 --new-key-file k1 --pbkdf pbkdf2 --iterations 1000 \
+		newer.img >/dev/null 2>&1; then
+	bad "addkey wrote over the newer unsupported header"
+elif [ "$(md5sum < newer.img)" = "$before" ]; then
+	ok "addkey leaves the volume with the newer unsupported header alone"
+else
+	bad "addkey refused, but changed the image"
+fi
+if cs luksDump --dump-json-metadata newer.img | grep -q offline-reencrypt; then
+	ok "cryptsetup still sees the newer header's requirement"
+else
+	bad "the newer header's requirement is gone"
+fi
+
+# the newer copy's metadata is damaged: the older one is used, and the next
+# change repairs both
+python3 -I "$HERE/craft_header.py" cs-base.img newer.img newer-damaged
+if "$LUKS" dump newer.img | grep -q "(secondary copy), PRIMARY DAMAGED, secondary ok"; then
+	ok "a newer copy with damaged metadata: the secondary is used and named"
+else
+	bad "newer-damaged dump: $("$LUKS" dump newer.img 2>&1 | grep header)"
+fi
+expect_open "opened from the older secondary copy" newer.img k0 0
+"$LUKS" addkey -k k0 --new-key-file k1 --pbkdf pbkdf2 --iterations 1000 \
+	newer.img >/dev/null 2>&1
+if "$LUKS" dump newer.img | grep -q "(primary copy), primary ok, secondary ok" \
+	&& cs luksDump newer.img >/dev/null 2>&1; then
+	ok "the next change rewrote both copies"
+else
+	bad "both copies after addkey: $("$LUKS" dump newer.img 2>&1 | grep header)"
+fi
+cs_opens "cryptsetup opens the repaired volume's new keyslot" newer.img k1 1
+
+# an unbound keyslot (another key) doesn't count as a way into the data
+image unbound.img 40M
+cs luksFormat --type luks2 --key-file k0 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 unbound.img
+cs luksAddKey --unbound --key-size 512 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 unbound.img k1
+	# (cryptsetup picks the slot)
+unboundSlot=$("$LUKS" dump unbound.img \
+	| sed -n 's/^  keyslot *\([0-9]*\):.*unbound.*/\1/p')
+if [ -n "$unboundSlot" ] \
+	&& cs luksDump unbound.img | grep -q "^  $unboundSlot: luks2 (unbound)"; then
+	ok "dump marks the unbound keyslot $unboundSlot, as cryptsetup does"
+else
+	bad "dump doesn't mark the unbound keyslot"
+fi
+out=$("$LUKS" removekey -k k0 unbound.img 0 2>&1)
+if [ $? -ne 0 ] && echo "$out" | grep -q "last one"; then
+	ok "the last bound keyslot isn't removed for an unbound one"
+else
+	bad "removekey 0 with an unbound slot: $out"
+fi
+expect_open "slot 0 still opens it" unbound.img k0 0
+out=$("$LUKS" removekey -k k0 unbound.img $unboundSlot 2>&1) \
+	&& ok "the unbound keyslot itself can be removed" \
+	|| bad "removing the unbound keyslot: $out"
+
+# two changes at the same time: the second waits for nobody, it's refused
+image race.img 40M
+"$LUKS" format -y -k k0 --pbkdf pbkdf2 --iterations 1000 race.img >/dev/null
+"$LUKS" addkey -k k0 --new-key-file k1 --pbkdf pbkdf2 --iterations 1000 \
+	race.img >/dev/null
+rm -f gate
+mkfifo gate
+"$LUKS" removekey -k gate race.img 1 > first.out 2>&1 &
+first=$!
+exec 3>gate
+	# returns when the first one opens its key file: it holds the lock
+out=$("$LUKS" removekey -k k0 race.img 0 2>&1)
+second=$?
+cat k1 >&3
+exec 3>&-
+wait $first
+firstStatus=$?
+if [ $second -ne 0 ] && echo "$out" | grep -q "another program"; then
+	ok "a second luks command on a locked volume is refused"
+else
+	bad "the second removekey: $out"
+fi
+[ $firstStatus -eq 0 ] && ok "the first one finished ($(cat first.out))" \
+	|| bad "the first removekey: $(cat first.out)"
+expect_open "the volume still opens with slot 0" race.img k0 0
+
+# cryptsetup changes the header while luks waits for a passphrase: luks
+# notices before writing
+"$LUKS" addkey -k gate --new-key-file k2 --pbkdf pbkdf2 --iterations 1000 \
+	race.img > first.out 2>&1 &
+first=$!
+exec 3>gate
+cs luksAddKey --key-file k0 --new-key-slot 5 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 race.img k1
+cat k0 >&3
+exec 3>&-
+wait $first
+firstStatus=$?
+if [ $firstStatus -ne 0 ] && grep -q "changed by another program" first.out; then
+	ok "a header changed meanwhile is noticed ($(cat first.out))"
+else
+	bad "addkey after cryptsetup's change: $(cat first.out)"
+fi
+cs_opens "cryptsetup's keyslot 5 survived" race.img k1 5
+expect_open "slot 0 survived" race.img k0 0
+rm -f gate
+
+# luks write: all of the file or nothing
+image write.img 32M
+"$LUKS" format -y -k k0 --pbkdf pbkdf2 --iterations 1000 write.img >/dev/null
+before=$(md5sum < write.img)
+head -c $((16 * 1024 * 1024 + 512)) plain64.img > big.img
+head -c $((1024 * 1024 + 100)) plain64.img > odd.img
+for file in big.img odd.img; do
+	out=$("$LUKS" write -k k0 write.img $file 2>&1)
+	if [ $? -ne 0 ] && [ "$(md5sum < write.img)" = "$before" ]; then
+		ok "luks write refuses $file, the volume unchanged ($out)"
+	else
+		bad "luks write $file: $out"
+	fi
+done
+
+# crashes during keyslot changes: one header copy always holds up
+if "$(dirname "$LUKS")/crash_test" > crash.out 2>&1; then
+	ok "crash model: $(tail -1 crash.out)"
+else
+	bad "crash model: $(tail -3 crash.out)"
+fi
+if "$(dirname "$LUKS")/crash_test" --no-flush > crash.out 2>&1; then
+	bad "the crash model doesn't notice missing flushes"
+else
+	ok "the crash model notices missing flushes ($(tail -1 crash.out))"
+fi
+
 echo "$passed passed, $failed failed"
 [ $failed -eq 0 ]
