-			return errno;
-		deviceSize = (uint64)geometry.bytes_per_sector
-			* geometry.sectors_per_track * geometry.cylinder_count
-			* geometry.head_count;
-		if (geometry.read_only && !fReadOnly) {
-			ERROR("%s is read-only\n", path);
-			return B_READ_ONLY_DEVICE;
-		}
+	bool readOnlyDevice;
+	status_t status = get_device_size(fFD, &deviceSize, &readOnlyDevice);
+	if (status != B_OK)
+		return status;
+	if (readOnlyDevice && !fReadOnly) {
+		ERROR("%s is read-only\n", path);
+		return B_READ_ONLY_DEVICE;
 	}
 
-	luks2_device_io io = { &fFD, header_read, NULL, deviceSize };
+	luks2_device_io io = { &fFD, header_read, NULL, deviceSize, NULL };
 	luks2_volume* volume;
 	int result = luks2_read_header(&io, &volume);
 	if (result != LUKS2_OK) {
@@ -1115,6 +1127,32 @@ boot_open_volume(const char* path, const uint8* key, size_t keySize,
 }
 
 
+/*!	The UUID of the LUKS2 volume at \a path, from the header copy the
+	reader picks: the secondary one when the primary is damaged. */
+static status_t
+boot_volume_uuid(const char* path, char* uuid, size_t uuidSize)
+{
+	int fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return errno;
+	uint64 size;
+	bool readOnly;
+	status_t status = get_device_size(fd, &size, &readOnly);
+	luks2_device_io io = { &fd, header_read, NULL, size, NULL };
+	if (status == B_OK && !luks2_probe(&io))
+		status = B_BAD_TYPE;
+	luks2_volume* volume = NULL;
+	if (status == B_OK)
+		status = luks2_to_status(luks2_read_header(&io, &volume));
+	close(fd);
+	if (status != B_OK)
+		return status;
+	strlcpy(uuid, volume->uuid, uuidSize);
+	luks2_free_volume(volume);
+	return B_OK;
+}
+
