+static status_t
+get_device_size(int fd, uint64* _size, bool* _readOnly)
+{
+	struct stat st;
+	if (fstat(fd, &st) != 0)
+		return errno;
+	*_readOnly = false;
+	if (S_ISREG(st.st_mode)) {
+		*_size = st.st_size;
+		return B_OK;
+	}
+	device_geometry geometry;
+	if (ioctl(fd, B_GET_GEOMETRY, &geometry, sizeof(geometry)) != 0)
+		return errno;
+	*_size = (uint64)geometry.bytes_per_sector * geometry.sectors_per_track
+		* geometry.cylinder_count * geometry.head_count;
+	*_readOnly = geometry.read_only;
+	return B_OK;
+}
+
