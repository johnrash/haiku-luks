+	ok "the GPT is intact; its partition holds the LUKS2 volume Haiku made"
+else
+	bad "parted.img: $(sgdisk -v parted.img | tail -2)"
+fi
+
 guestFailed=$(grep -c "LUKSTEST FAIL" serial.log || true)
 grep -q "LUKSTEST done" serial.log || { bad "the guest test didn't finish"; }
 echo "host: $passed passed, $failed failed; guest failures: $guestFailed"
