+	(/dev/disk/.../0, 1, ...); those of a partition next to it, with its
+	name and "_" in front (0_0, 0_1, ...). */
+static bool
+has_partitions(const char* path)
+{
+	if (strncmp(path, "/dev/disk/", 10) != 0)
+		return false;
+	char directory[PATH_MAX];
+	strlcpy(directory, path, sizeof(directory));
+	char* slash = strrchr(directory, '/');
+	if (slash == NULL)
+		return false;
+	*slash = '\0';
+	const char* name = slash + 1;
+	size_t nameLength = strlen(name);
+	bool isDisk = strcmp(name, "raw") == 0;
+
+	DIR* dir = opendir(directory);
+	if (dir == NULL)
+		return false;
+	bool found = false;
+	while (struct dirent* entry = readdir(dir)) {
+		const char* other = entry->d_name;
+		if (isDisk ? isdigit((unsigned char)other[0])
+				: strncmp(other, name, nameLength) == 0
+					&& other[nameLength] == '_') {
+			found = true;
+			break;
+		}
+	}
+	closedir(dir);
+	return found;
+}
