+/*!	Opens the device; for writing, with a lock that keeps other luks
+	commands (and EncryptedVolume) from changing the volume until it's
+	closed. */
 static bool
 open_device(const char* path, bool writable, Device& device)
 {
-	device.fd = open(path, writable ? O_RDWR : O_RDONLY);
+	int mode = writable ? O_RDWR : O_RDONLY;
+#ifdef __linux__
+	// Linux refuses an exclusive open of a block device that's mounted or
+	// mapped
+	struct stat st;
+	if (writable && stat(path, &st) == 0 && S_ISBLK(st.st_mode))
+		mode |= O_EXCL;
+#endif
+	device.fd = open(path, mode);
 	if (device.fd < 0) {
 		fprintf(stderr, "%s: can't open %s: %s\n", kProgramName, path,
-			strerror(errno));
+			errno == EBUSY ? "it's in use" : strerror(errno));
+		return false;
+	}
+	if (writable && luks2_lock_fd(device.fd) == EWOULDBLOCK) {
+		fprintf(stderr, "%s: another program is changing %s; try again "
+			"when it's done\n", kProgramName, path);
+		close(device.fd);
 		return false;
 	}
 	device.io.cookie = &device.fd;
 	device.io.read = device_read;
 	device.io.write = writable ? device_write : NULL;
 	device.io.size = device_size(device.fd);
+	device.io.flush = writable ? luks2_fd_flush_cookie : NULL;
+	return true;
+}
+
+
+/*!	Refuses to overwrite a device someone uses: right before formatting it
+	or writing its data area. (Linux: the exclusive open did that.) */
+static bool
+check_not_in_use(const char* path)
+{
+#ifdef __HAIKU__
+	const char* reason = NULL;
+	switch (luks2_partition_in_use(path)) {
+		case LUKS2_IN_USE_MOUNTED:
+			reason = "it's mounted; unmount it first";
+			break;
