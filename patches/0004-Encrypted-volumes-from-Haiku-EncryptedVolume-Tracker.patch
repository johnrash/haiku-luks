+/*!	Unlock and Lock for LUKS2 partitions, Encrypt for partitions without a
+	partition table that aren't in use. */
+void
+MainWindow::_UpdateEncryptionMenus(BPartition* partition, bool writable)
+{
+	bool isEncrypted = false;
+	bool isUnlocked = false;
+	bool holdsBootVolume = false;
+	BPath path;
+	if (partition != NULL && partition->GetPath(&path) == B_OK) {
+		isEncrypted = luks2_partition_label(path.Path(), NULL, 0, NULL, 0);
+		luks2_device_info info;
+		if (isEncrypted
+			&& luks2_find_open_device(path.Path(), &info) == B_OK) {
+			isUnlocked = true;
+			// the boot volume can't be locked
+			BVolume bootVolume;
+			fs_info fsInfo;
+			BString prefix(info.device);
+			prefix.Truncate(prefix.FindLast('/') + 1);
+			holdsBootVolume = BVolumeRoster().GetBootVolume(&bootVolume)
+					== B_OK
+				&& fs_stat_dev(bootVolume.Device(), &fsInfo) == 0
+				&& strncmp(fsInfo.device_name, prefix.String(),
+					prefix.Length()) == 0;
+		}
+	}
+
+	fUnlockMenuItem->SetEnabled(isEncrypted && !isUnlocked);
+	fLockMenuItem->SetEnabled(isUnlocked && !holdsBootVolume);
+	fEncryptMenuItem->SetEnabled(partition != NULL && writable
+		&& !partition->IsMounted() && partition->CountChildren() == 0
+		&& !isUnlocked);
+}
