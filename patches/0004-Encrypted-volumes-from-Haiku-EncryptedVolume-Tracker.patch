diff --git a/src/libs/luks2/luks2_partitions.cpp b/src/libs/luks2/luks2_partitions.cpp
new file mode 100644
index 0000000000..570a55a498
--- /dev/null
+++ b/src/libs/luks2/luks2_partitions.cpp
@@ -0,0 +1,171 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Recognising LUKS2 partitions and talking to the luks_disk driver, for
+	userland programs. No crypto here: Tracker and DriveSetup use it. */
+
+
+#include <luks2/luks2_userland.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+
+// local copies, so that this file needs nothing else of the LUKS2 code
+static bool
+has_luks2_signature(const uint8_t* header)
+{
+	static const uint8_t kMagic[] = { 'L', 'U', 'K', 'S', 0xba, 0xbe, 0, 2 };
+	return memcmp(header, kMagic, sizeof(kMagic)) == 0;
+}
+
+
+static void
+copy_header_string(char* target, size_t targetSize, const uint8_t* source,
+	size_t sourceSize)
+{
+	if (target == NULL || targetSize == 0)
+		return;
+	size_t length = strnlen((const char*)source, sourceSize);
+	if (length >= targetSize)
+		length = targetSize - 1;
+	memcpy(target, source, length);
+	target[length] = '\0';
+}
+
+
+extern "C" bool
+luks2_partition_label(const char* path, char* label, size_t labelSize,
+	char* uuid, size_t uuidSize)
+{
+	int fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return false;
+	uint8_t header[512];
+	ssize_t bytesRead = pread(fd, header, sizeof(header), 0);
+	close(fd);
+	if (bytesRead != (ssize_t)sizeof(header)
+		|| !has_luks2_signature(header)) {
+		return false;
+	}
+
+	// binary header: label at 24 (48 bytes), UUID at 168 (40 bytes)
+	copy_header_string(label, labelSize, header + 24, 48);
+	copy_header_string(uuid, uuidSize, header + 168, 40);
+	return true;
+}
+
+
+#ifdef __HAIKU__
+
+
+static void
+wipe(void* buffer, size_t size)
+{
+	memset(buffer, 0, size);
+	__asm__ __volatile__("" : : "r"(buffer) : "memory");
+}
+
+
+static int
+open_control_device()
+{
+	return open("/dev/" LUKS2_CONTROL_DEVICE_NAME, O_RDONLY);
+}
+
+
+extern "C" status_t
+luks2_find_open_device(const char* path, luks2_device_info* info)
+{
+	char resolved[PATH_MAX];
+	if (realpath(path, resolved) == NULL)
+		strlcpy(resolved, path, sizeof(resolved));
+
+	int control = open_control_device();
+	if (control < 0)
+		return errno;
+
+	status_t status = B_ENTRY_NOT_FOUND;
+	int32 id = 0;
+	while (true) {
+		memset(info, 0, sizeof(*info));
+		info->version = LUKS2_DRIVER_INTERFACE_VERSION;
+		info->id = id;
+		if (ioctl(control, LUKS2_IOCTL_GET_INFO, info, sizeof(*info)) != 0)
+			break;
+		if (strcmp(info->path, resolved) == 0) {
+			status = B_OK;
+			break;
+		}
+		id = info->id + 1;
+	}
+	close(control);
+	return status;
+}
+
+
+extern "C" status_t
+luks2_open_device(const char* path, const uint8_t* key, size_t keySize,
+	bool readOnly, char* device, size_t deviceSize, int32* _id)
+{
+	luks2_open_request* request
+		= (luks2_open_request*)calloc(1, sizeof(luks2_open_request));
+	if (request == NULL)
+		return B_NO_MEMORY;
+	if (keySize > sizeof(request->key)) {
+		free(request);
+		return B_BAD_VALUE;
+	}
+
+	request->version = LUKS2_DRIVER_INTERFACE_VERSION;
+	request->flags = readOnly ? LUKS2_OPEN_READ_ONLY : 0;
+	memcpy(request->key, key, keySize);
+	request->key_size = keySize;
+	if (realpath(path, request->path) == NULL)
+		strlcpy(request->path, path, sizeof(request->path));
+
+	status_t status;
+	int control = open_control_device();
+	if (control < 0)
+		status = errno;
+	else {
+		status = ioctl(control, LUKS2_IOCTL_OPEN, request, sizeof(*request))
+			== 0 ? B_OK : errno;
+		close(control);
+	}
+
+	if (status == B_OK) {
+		if (device != NULL)
+			strlcpy(device, request->device, deviceSize);
+		if (_id != NULL)
+			*_id = request->id;
+	}
+	wipe(request, sizeof(*request));
+	free(request);
+	return status;
+}
+
+
+extern "C" status_t
+luks2_close_device(int32 id)
+{
+	int control = open_control_device();
+	if (control < 0)
+		return errno;
+	luks2_close_request request = { LUKS2_DRIVER_INTERFACE_VERSION, id };
+	status_t status = ioctl(control, LUKS2_IOCTL_CLOSE, &request,
+		sizeof(request)) == 0 ? B_OK : errno;
+	close(control);
+	return status;
+}
+
+
+#endif	// __HAIKU__
diff --git a/src/libs/luks2/luks2_userland.cpp b/src/libs/luks2/luks2_userland.cpp
new file mode 100644
index 0000000000..f00b778805
--- /dev/null
+++ b/src/libs/luks2/luks2_userland.cpp
@@ -0,0 +1,167 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Random numbers and KDF parameters for userland programs that create
+	volumes and keyslots (the luks command, EncryptedVolume). */
+
+
+#include <luks2/luks2_userland.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifdef __HAIKU__
+#	include <OS.h>
+#else
+#	include <sys/random.h>
+#endif
+
+
+extern "C" int
+luks2_random(void* buffer, size_t size)
+{
+	uint8_t* bytes = (uint8_t*)buffer;
+#ifdef __HAIKU__
+	int fd = open("/dev/urandom", O_RDONLY);
+	if (fd < 0)
+		return -1;
+	while (size > 0) {
+		ssize_t bytesRead = read(fd, bytes, size);
+		if (bytesRead < 0 && errno == EINTR)
+			continue;
+		if (bytesRead <= 0) {
+			close(fd);
+			return -1;
+		}
+		bytes += bytesRead;
+		size -= bytesRead;
+	}
+	close(fd);
+#else
+	while (size > 0) {
+		ssize_t bytesRead = getrandom(bytes, size, 0);
+		if (bytesRead < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		bytes += bytesRead;
+		size -= bytesRead;
+	}
+#endif
+	return 0;
+}
+
+
+static double
+now()
+{
+	struct timespec time;
+	clock_gettime(CLOCK_MONOTONIC, &time);
+	return time.tv_sec + time.tv_nsec / 1e9;
+}
+
+
+static uint64_t
+physical_memory_kib()
+{
+#ifdef __HAIKU__
+	system_info info;
+	if (get_system_info(&info) == B_OK)
+		return (uint64_t)info.max_pages * B_PAGE_SIZE / 1024;
+#else
+	long pages = sysconf(_SC_PHYS_PAGES);
+	long pageSize = sysconf(_SC_PAGESIZE);
+	if (pages > 0 && pageSize > 0)
+		return (uint64_t)pages * pageSize / 1024;
+#endif
+	return 512 * 1024;
+}
+
+
+extern "C" void
+luks2_choose_kdf(luks2_kdf* kdf, int type, uint32_t iterTimeMs,
+	uint32_t memoryKiB, uint32_t lanes, uint32_t passes, uint32_t iterations)
+{
+	memset(kdf, 0, sizeof(*kdf));
+	kdf->type = type;
+	double target = (iterTimeMs != 0 ? iterTimeMs : 2000) / 1000.0;
+	const char* salt = "benchmark salt..";
+
+	if (type == LUKS2_KDF_PBKDF2) {
+		kdf->hash = LUKS2_HASH_SHA256;
+		kdf->iterations = iterations;
+		if (kdf->iterations == 0) {
+			uint8_t out[64];
+			uint32_t count = 1000;
+			double elapsed;
+			while (true) {
+				double start = now();
+				luks2_pbkdf2(LUKS2_HASH_SHA256, "passphrase", 10, salt, 16,
+					count, out, 64);
+				elapsed = now() - start;
+				if (elapsed > 0.1 || count > (1u << 30))
+					break;
+				count *= 4;
+			}
+			// 64 bytes of output are two PBKDF2 blocks
+			double rate = count * 2 / elapsed;
+			kdf->iterations = (uint32_t)(rate * target / 2);
+			if (kdf->iterations < 1000)
+				kdf->iterations = 1000;
+		}
+		return;
+	}
+
+	kdf->cpus = lanes != 0 ? lanes : 4;
+	kdf->memory = memoryKiB;
+	if (kdf->memory == 0) {
+		uint64_t memory = physical_memory_kib() / 4;
+		if (memory > 1024 * 1024)
+			memory = 1024 * 1024;
+		kdf->memory = (uint32_t)memory;
+	}
+	if (kdf->memory < 8 * kdf->cpus)
+		kdf->memory = 8 * kdf->cpus;
+	kdf->time = passes;
+
+	if (kdf->time == 0) {
+		// one pass over a sample, then scale
+		uint32_t sample = kdf->memory < 64 * 1024 ? kdf->memory : 64 * 1024;
+		uint8_t out[64];
+		double start = now();
+		luks2_argon2(type == LUKS2_KDF_ARGON2I ? LUKS2_ARGON2I : LUKS2_ARGON2ID,
+			1, sample, kdf->cpus, "passphrase", 10, salt, 16, NULL, 0, NULL, 0,
+			out, 64);
+		double perKiB = (now() - start) / sample;
+		double passTime = perKiB * kdf->memory;
+		kdf->time = (uint32_t)(target / passTime);
+		if (kdf->time < 4) {
+			// at least four passes, as cryptsetup; less memory instead
+			kdf->time = 4;
+			uint64_t memory = (uint64_t)(target / 4 / perKiB);
+			if (memory < kdf->memory) {
+				kdf->memory = memory < 32 * 1024 ? 32 * 1024
+					: (uint32_t)memory;
+			}
+		}
+	}
+}
+
+
+extern "C" uint32_t
+luks2_choose_digest_iterations(void)
+{
+	uint8_t out[32];
+	double start = now();
+	luks2_pbkdf2(LUKS2_HASH_SHA256, "key", 3, "salt", 4, 100000, out, 32);
+	double rate = 100000 / (now() - start);
+	uint32_t iterations = (uint32_t)(rate / 8);
+	return iterations < 1000 ? 1000 : iterations;
+}
