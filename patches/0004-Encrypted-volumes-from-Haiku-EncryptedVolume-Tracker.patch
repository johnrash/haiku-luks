+#ifndef _LUKS2_USERLAND_H
+#define _LUKS2_USERLAND_H
+
+
+/*!	Helpers for userland programs (the luks command, EncryptedVolume,
+	Tracker, DriveSetup).
+
+	luks2_partitions.cpp, without any crypto, so Tracker and DriveSetup can
+	use it: recognising a LUKS2 partition and talking to the luks_disk
+	driver.
+
+	luks2_userland.cpp, with the LUKS2 code: random numbers and choosing KDF
+	parameters for new keyslots.
+*/
+
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <luks2/luks2.h>
+
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+// luks2_partitions.cpp
+
+/*!	Tells whether \a path (a partition or disk) starts with a LUKS2 header
+	and returns its label and UUID (both may be NULL). Reads only the binary
+	header; it doesn't check the checksum. */
+bool luks2_partition_label(const char* path, char* label, size_t labelSize,
+	char* uuid, size_t uuidSize);
+
+#ifdef __HAIKU__
+#include <luks2/luks2_driver.h>
+
+/*!	Finds the luks_disk device opened from \a path, if any. */
+status_t luks2_find_open_device(const char* path, luks2_device_info* info);
+
+/*!	Opens \a path with the volume key through the driver; the decrypted
+	device's path goes to \a device. */
+status_t luks2_open_device(const char* path, const uint8_t* key,
+	size_t keySize, bool readOnly, char* device, size_t deviceSize,
+	int32* _id);
+
+status_t luks2_close_device(int32 id);
+#endif
+
+
+// luks2_userland.cpp
+
+/*!	KDF parameters for a new keyslot. 0 means "choose": Argon2 takes at most
+	1 GiB or a quarter of the RAM, 4 lanes, and at least 4 passes, measured
+	single-threaded (as the boot loader computes it) to take about
+	\a iterTimeMs; with less memory if 4 passes take longer. PBKDF2 gets the
+	iterations for \a iterTimeMs. */
+void luks2_choose_kdf(luks2_kdf* kdf, int type, uint32_t iterTimeMs,
+	uint32_t memoryKiB, uint32_t lanes, uint32_t passes,
+	uint32_t iterations);
+
+/*!	Iterations for the volume key's digest: about 1/8 s here. */
+uint32_t luks2_choose_digest_iterations(void);
+
+
+#ifdef __cplusplus
+}
+#endif
+
+
+#endif	// _LUKS2_USERLAND_H
