+	kEncryptMode,
+	kLockMode
+};
+
+
+// #pragma mark - disks
+
+
+/*!	The partition (or disk) whose device is \a path. */
+static status_t
+find_partition(const char* path, BDiskDevice* device, BPartition** _partition)
+{
+	char resolved[B_PATH_NAME_LENGTH];
+	if (realpath(path, resolved) == NULL)
+		strlcpy(resolved, path, sizeof(resolved));
+
+	struct PathVisitor : BDiskDeviceVisitor {
+		PathVisitor(const char* path) : fPath(path) {}
+		virtual bool Visit(BDiskDevice* device)
+		{
+			return Visit(device, 0);
+		}
+		virtual bool Visit(BPartition* partition, int32 level)
+		{
+			BPath path;
+			return partition->GetPath(&path) == B_OK
+				&& strcmp(path.Path(), fPath) == 0;
+		}
+		const char* fPath;
+	} visitor(resolved);
+
+	BDiskDeviceRoster roster;
+	if (!roster.VisitEachPartition(&visitor, device, _partition))
+		return B_ENTRY_NOT_FOUND;
+	return B_OK;
+}
+
+
+
+struct PartitionInfo {
+	BString	label;
+	BString	name;
+	off_t	size;
+	bool	mounted;
+	bool	hasChildren;
+};
+
+
+static status_t
+get_partition_info(const char* path, PartitionInfo& info)
+{
+	BDiskDevice device;
+	BPartition* partition;
+	status_t status = find_partition(path, &device, &partition);
+	if (status != B_OK)
+		return status;
+	info.size = partition->Size();
+	info.mounted = partition->IsMounted();
+	info.hasChildren = partition->CountChildren() > 0;
+	// a partition's name, never a disk's (that's its model)
+	info.name = partition->ContentName();
+	if (info.name.Length() == 0 && !partition->IsDevice())
+		info.name = partition->Name();
+	char label[48];
+	if (luks2_partition_label(path, label, sizeof(label), NULL, 0))
+		info.label = label;
+	return B_OK;
+}
+
+
+static BString
+size_string(off_t size)
+{
+	char buffer[64];
+	return BPrivate::string_for_size(size, buffer, sizeof(buffer));
+}
+
+
+/*!	Mounts the file systems on the decrypted device once the disk device
+	manager knows it (mount_server may mount them first: the device is
+	removable). Returns the first mount point. */
+static status_t
+mount_decrypted_device(const char* devicePath, bool readOnly, BPath& _mountPoint)
+{
+	BDiskDevice device;
+	BPartition* partition = NULL;
+	status_t status = B_ENTRY_NOT_FOUND;
+	for (int i = 0; i < 100; i++) {
+		status = find_partition(devicePath, &device, &partition);
+		if (status == B_OK)
+			break;
+		snooze(100000);
+	}
+	if (status != B_OK)
+		return status;
+
+	struct MountVisitor : BDiskDeviceVisitor {
+		MountVisitor(bool readOnly) : fReadOnly(readOnly), fStatus(B_ERROR) {}
+
+		virtual bool Visit(BDiskDevice* device)
+		{
+			return Visit(device, 0);
+		}
+
+		virtual bool Visit(BPartition* partition, int32 level)
+		{
+			if (!partition->ContainsFileSystem())
+				return false;
+			status_t status = B_OK;
+			if (!partition->IsMounted()) {
+				status = partition->Mount(NULL,
+					fReadOnly ? B_MOUNT_READ_ONLY : 0);
+				if (status == B_BUSY) {
+					// mount_server got there first
+					snooze(300000);
+					status = B_OK;
+				}
+			}
+			if (status == B_OK && fMountPoint.InitCheck() != B_OK)
+				partition->GetMountPoint(&fMountPoint);
+			if (fStatus != B_OK)
+				fStatus = status;
+			return false;
+		}
+
+		bool	fReadOnly;
+		status_t fStatus;
+		BPath	fMountPoint;
+	} visitor(readOnly);
+
+	// mount_server may be mounting it right now: give it a moment
+	snooze(500000);
+	device.Update();
+	device.VisitEachDescendant(&visitor);
+	if (visitor.fStatus != B_OK)
+		return visitor.fStatus == B_ERROR ? B_NO_INIT : visitor.fStatus;
+
+	device.Update();
+	visitor.fMountPoint.Unset();
+	visitor.fStatus = B_ERROR;
+	device.VisitEachDescendant(&visitor);
+	_mountPoint = visitor.fMountPoint;
+	return _mountPoint.InitCheck() == B_OK ? B_OK : B_ERROR;
+}
+
+
+static status_t
+lock_volume(const char* path)
+{
+	luks2_device_info info;
+	status_t status = luks2_find_open_device(path, &info);
+	if (status != B_OK)
+		return status;
+
+	BDiskDevice device;
+	BPartition* partition;
+	if (find_partition(info.device, &device, &partition) == B_OK) {
+		struct UnmountVisitor : BDiskDeviceVisitor {
+			UnmountVisitor() : fStatus(B_OK) {}
+			virtual bool Visit(BDiskDevice* device)
+			{
+				return Visit(device, 0);
+			}
+			virtual bool Visit(BPartition* partition, int32 level)
+			{
+				if (partition->IsMounted()) {
+					status_t status = partition->Unmount();
+					if (status != B_OK)
+						fStatus = status;
+				}
+				return false;
+			}
+			status_t fStatus;
+		} visitor;
+		device.VisitEachDescendant(&visitor);
+		if (visitor.fStatus != B_OK)
+			return visitor.fStatus;
+	}
+	return luks2_close_device(info.id);
+}
+
+
+// #pragma mark - the work, in its own thread
+
+
+struct Job {
+	BMessenger	target;
+	int			mode;
+	BString		path;
+	char*		passphrase;
+	size_t		passphraseLength;
+	bool		readOnly;
+	BString		volumeName;
+};
+
+
+static ssize_t
+fd_read(void* cookie, uint64_t offset, void* buffer, size_t size)
+{
+	return pread(*(int*)cookie, buffer, size, offset);
+}
+
+
+static ssize_t
+fd_write(void* cookie, uint64_t offset, const void* buffer, size_t size)
+{
+	return pwrite(*(int*)cookie, buffer, size, offset);
+}
+
+
+static uint64_t
+fd_size(int fd)
+{
+	device_geometry geometry;
+	if (ioctl(fd, B_GET_GEOMETRY, &geometry, sizeof(geometry)) == 0) {
+		return (uint64_t)geometry.bytes_per_sector
+			* geometry.sectors_per_track * geometry.cylinder_count
+			* geometry.head_count;
+	}
+	struct stat st;
+	if (fstat(fd, &st) == 0)
+		return st.st_size;
+	return 0;
+}
+
+
+static BString
+luks2_message(int error)
+{
+	switch (error) {
+		case LUKS2_ERROR_BAD_PASSPHRASE:
+			return B_TRANSLATE("That passphrase doesn't open this volume.");
+		case LUKS2_ERROR_KDF_MEMORY:
+			return B_TRANSLATE("There isn't enough memory to check the "
+				"passphrase.");
+		case LUKS2_ERROR_UNSUPPORTED:
+			return B_TRANSLATE("The volume uses a LUKS2 feature that isn't "
+				"supported.");
+		case LUKS2_ERROR_CORRUPT:
+			return B_TRANSLATE("The volume's LUKS2 header is damaged.");
+	}
+	return luks2_error_string(error);
+}
+
+
+static status_t
+unlock(Job& job, BMessage& result)
+{
+	int fd = open(job.path.String(), O_RDONLY);
+	if (fd < 0) {
+		result.AddString("error", strerror(errno));
+		return errno;
+	}
+	luks2_device_io io = { &fd, fd_read, NULL, fd_size(fd) };
+	luks2_volume* volume;
+	int luks2Result = luks2_read_header(&io, &volume);
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize = 0;
+	if (luks2Result == LUKS2_OK) {
+		luks2Result = luks2_unlock(volume, &io, job.passphrase,
+			job.passphraseLength, -1, key, &keySize, NULL);
+		luks2_free_volume(volume);
+	}
+	close(fd);
+	if (luks2Result != LUKS2_OK) {
+		luks2_wipe(key, sizeof(key));
+		result.AddString("error", luks2_message(luks2Result));
+		return luks2Result == LUKS2_ERROR_BAD_PASSPHRASE
+			? B_PERMISSION_DENIED : B_ERROR;
+	}
+
+	char device[B_PATH_NAME_LENGTH];
+	status_t status = luks2_open_device(job.path.String(), key, keySize,
+		job.readOnly, device, sizeof(device), NULL);
+	luks2_wipe(key, sizeof(key));
+	if (status != B_OK) {
+		result.AddString("error", strerror(status));
+		return status;
+	}
+	result.AddString("device", device);
+
+	BPath mountPoint;
+	status = mount_decrypted_device(device, job.readOnly, mountPoint);
+	if (status != B_OK) {
+		result.AddString("error", B_TRANSLATE("The volume is unlocked, but "
+			"nothing on it could be mounted."));
+		return status;
+	}
+	result.AddString("mount point", mountPoint.Path());
+	return B_OK;
+}
+
+
+static status_t
+encrypt(Job& job, BMessage& result)
+{
+	int fd = open(job.path.String(), O_RDWR);
+	if (fd < 0) {
+		result.AddString("error", strerror(errno));
+		return errno;
+	}
+	luks2_device_io io = { &fd, fd_read, fd_write, fd_size(fd) };
+
+	luks2_format_parameters parameters;
+	memset(&parameters, 0, sizeof(parameters));
+	parameters.label = job.volumeName.String();
+	parameters.sector_size = 512;
+	parameters.key_size = 64;
+	parameters.digest_iterations = luks2_choose_digest_iterations();
+	luks2_choose_kdf(&parameters.kdf, LUKS2_KDF_ARGON2ID, 2000, 0, 4, 0, 0);
+
+	uint8_t key[LUKS2_MAX_KEY_SIZE];
+	size_t keySize = 0;
+	int luks2Result = luks2_format(&io, &parameters, job.passphrase,
+		job.passphraseLength, key, &keySize);
+	fsync(fd);
+	close(fd);
+	if (luks2Result != LUKS2_OK) {
+		luks2_wipe(key, sizeof(key));
+		result.AddString("error", luks2_message(luks2Result));
+		return B_ERROR;
+	}
+
+	char device[B_PATH_NAME_LENGTH];
+	status_t status = luks2_open_device(job.path.String(), key, keySize, false,
+		device, sizeof(device), NULL);
+	luks2_wipe(key, sizeof(key));
+	if (status != B_OK) {
+		result.AddString("error", strerror(status));
+		return status;
+	}
+	result.AddString("device", device);
+
+	// a BFS volume on the decrypted device
+	BDiskDevice disk;
+	BPartition* partition = NULL;
+	status = B_ENTRY_NOT_FOUND;
+	for (int i = 0; i < 100 && status != B_OK; i++) {
+		status = find_partition(device, &disk, &partition);
+		if (status != B_OK)
+			snooze(100000);
+	}
+	if (status == B_OK)
+		status = disk.PrepareModifications();
+	if (status == B_OK) {
+		status = partition->Initialize("Be File System",
+			job.volumeName.String(), "");
+		if (status == B_OK)
+			status = disk.CommitModifications();
+		else
+			disk.CancelModifications();
+	}
+	if (status != B_OK) {
+		result.AddString("error", BString(B_TRANSLATE("The volume is "
+			"encrypted and unlocked, but BFS couldn't be put on it: "))
+			<< strerror(status));
+		return status;
+	}
+
+	BPath mountPoint;
+	status = mount_decrypted_device(device, false, mountPoint);
+	if (status != B_OK) {
+		result.AddString("error", B_TRANSLATE("The new volume couldn't be "
+			"mounted."));
+		return status;
+	}
+	result.AddString("mount point", mountPoint.Path());
+	return B_OK;
+}
+
+
+static status_t
+job_thread(void* data)
+{
+	Job* job = (Job*)data;
+	BMessage result(kMsgDone);
+	status_t status = job->mode == kUnlockMode
+		? unlock(*job, result) : encrypt(*job, result);
+	result.AddInt32("result", status);
+
+	luks2_wipe(job->passphrase, kMaxPassphraseLength + 1);
+	free(job->passphrase);
+	job->target.SendMessage(&result);
+	delete job;
+	return B_OK;
+}
+
