diff --git a/src/tests/system/luks2/qemu/run-ui-test.sh b/src/tests/system/luks2/qemu/run-ui-test.sh
new file mode 100755
index 0000000000..ec86359b94
--- /dev/null
+++ b/src/tests/system/luks2/qemu/run-ui-test.sh
@@ -0,0 +1,177 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Tests the Haiku side of encrypted volumes in QEMU (x86_64, UEFI, NVMe):
+# EncryptedVolume, Tracker's unlock message, mount_server's eject (lock),
+# Installer onto an encrypted partition with its EFI loader, then a boot of
+# that freshly installed encrypted disk on its own.
+# The guest is driven over ssh (a test key; sshd set up at boot by a launch
+# job), with hey; see guest-ui-test.sh.
+#
+# Usage: run-ui-test.sh <anyboot image> <work dir> <bfs_shell> [timeout s]
+
+set -e
+IMAGE=$1
+W=$2
+BFS=$3
+TIMEOUT=${4:-1800}
+HERE=$(cd "$(dirname "$0")" && pwd)
+# Locale settings (skip the first-boot language prompt): en_US
+LOCALE=${LOCALE_SETTINGS:-$HERE/locale-settings}
+mkdir -p "$W"
+cd "$W"
+
+passed=0
+failed=0
+ok() { passed=$((passed + 1)); echo "ok   $*"; }
+bad() { failed=$((failed + 1)); echo "FAIL $*"; }
+
+echo "== disks"
+cp "$IMAGE" boot.img
+rm -f blank.img target.img esp.img
+truncate -s 256M blank.img
+printf 'LUKSTEST-BLANK' | dd of=blank.img conv=notrunc 2>/dev/null
+truncate -s 1400M target.img
+sgdisk -n 1:2048:+64M -t 1:ef00 -c 1:"EFI system" -n 2:0:0 -t 2:8309 \
+	-c 2:"Haiku (encrypted)" target.img > /dev/null
+truncate -s 64M esp.img
+mformat -i esp.img -F -v EFI ::
+dd if=esp.img of=target.img bs=512 seek=2048 conv=notrunc 2>/dev/null
+rm esp.img
+
+echo "== ssh access for the test, and the guest's files"
+mkdir -p files
+rm -f vmkey vmkey.pub
+ssh-keygen -q -t ed25519 -N "" -C luks-test -f vmkey
+cp vmkey.pub files/authorized_keys
+printf 'installed system passphrase' > files/key-installed
+echo luks-vm > files/hostname
+cp "$LOCALE" "files/Locale settings"
+cp "$HERE/guest-boot-test.sh" files/test.sh
+cp "$HERE/guest-ui-test.sh" files/guest-ui-test.sh
+cat > files/ssh-setup.sh <<'EOF'
+#!/bin/sh
+# test VMs only: sshd for the test key
+S=/boot/system/settings/ssh
+mkdir -p $S /boot/system/var/empty /boot/system/var/run
+# the openssh package's first-boot script creates the sshd user
+for i in $(seq 1 120); do
+	grep -q "^sshd:" /boot/system/settings/etc/passwd 2>/dev/null && break
+	sleep 1
+done
+cat > $S/sshd_config <<CONFIG
+PermitRootLogin yes
+PasswordAuthentication no
+StrictModes no
+AuthorizedKeysFile /boot/system/settings/luks-test/authorized_keys
+Subsystem sftp /boot/system/lib/openssh/sftp-server
+CONFIG
+[ -e $S/ssh_host_ed25519_key ] || /boot/system/bin/ssh-keygen -A > /dev/dprintf 2>&1
+/boot/system/bin/sshd -f $S/sshd_config > /dev/dprintf 2>&1 \
+	&& echo "LUKSTEST sshd started" > /dev/dprintf
+EOF
+printf 'job x-vnd.luks-test-ssh {\n\tlaunch /bin/sh /boot/system/settings/luks-test/ssh-setup.sh\n}\n' \
+	> files/ssh.job
+printf 'job x-vnd.luks-test {\n\tlaunch /bin/sh /boot/system/settings/luks-test/test.sh\n}\n' \
+	> files/test.job
+offset=$(sfdisk -d boot.img | sed -n 's/.*1 : start= *\([0-9]*\),.*/\1/p')
+printf '%s\n' "mkdir -p /myfs/system/settings/luks-test" \
+	"mkdir -p /myfs/system/settings/launch" \
+	"mkdir -p /myfs/system/settings/network" \
+	"mkdir -p /myfs/home/config/settings" \
+	"cp :$W/files/ssh-setup.sh /myfs/system/settings/luks-test/ssh-setup.sh" \
+	"cp :$W/files/authorized_keys /myfs/system/settings/luks-test/authorized_keys" \
+	"cp :$W/files/ssh.job /myfs/system/settings/launch/luks-test-ssh" \
+	"cp :$W/files/hostname /myfs/system/settings/network/hostname" \
+	"cp \":$W/files/Locale settings\" \"/myfs/home/config/settings/Locale settings\"" \
+	"sync" "quit" | "$BFS" --start-offset $((offset * 512)) boot.img \
+	> bfs_shell.log 2>&1 || true
+
+vm() {
+	ssh -q -i "$W/vmkey" -p 2222 -o StrictHostKeyChecking=no \
+		-o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 user@127.0.0.1 "$@"
+}
+
+echo "== the live system: EncryptedVolume, Tracker, mount_server, Installer"
+cp /usr/share/OVMF/OVMF_VARS_4M.fd vars.fd
+rm -f serial.log mon.sock
+timeout "$TIMEOUT" qemu-system-x86_64 -M q35 -cpu max -smp 4 -m 3072 \
+	-accel tcg,thread=multi \
+	-drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
+	-drive if=pflash,format=raw,file=vars.fd \
+	-drive if=none,id=boot,file=boot.img,format=raw \
+	-device nvme,drive=boot,serial=boot \
+	-drive if=none,id=d1,file=blank.img,format=raw \
+	-device nvme,drive=d1,serial=blank \
+	-drive if=none,id=d2,file=target.img,format=raw \
+	-device nvme,drive=d2,serial=target \
+	-device e1000,netdev=n0 \
+	-netdev user,id=n0,hostfwd=tcp:127.0.0.1:2222-:22 \
+	-display none -serial file:serial.log -monitor unix:mon.sock,server,nowait \
+	-no-reboot > qemu.log 2>&1 &
+qemu=$!
+for i in $(seq 1 120); do
+	grep -aq "LUKSTEST sshd started" serial.log 2>/dev/null && break
+	sleep 3
+done
+sleep 10
+if scp -q -i vmkey -P 2222 -o StrictHostKeyChecking=no \
+		-o UserKnownHostsFile=/dev/null -r files user@127.0.0.1:/tmp/luks-test; then
+	vm "sh /tmp/luks-test/guest-ui-test.sh /tmp/luks-test" > guest-ui.log 2>&1 \
+		|| true
+else
+	echo "no ssh into the guest" > guest-ui.log
+	kill $qemu 2>/dev/null || true
+fi
+sed 's/^/guest: /' guest-ui.log
+mkdir -p shots
+scp -q -i vmkey -P 2222 -o StrictHostKeyChecking=no \
+	-o UserKnownHostsFile=/dev/null "user@127.0.0.1:/boot/home/ui-*.png" \
+	shots/ 2>/dev/null || true
+loaderMD5=$(vm "cat /tmp/loader.md5" 2>/dev/null || true)
+vm "sync; shutdown -q" > /dev/null 2>&1 || true
+wait $qemu || true
+
+if grep -q "^done: [0-9]* passed, 0 failed" guest-ui.log; then
+	ok "the live system's checks passed"
+else
+	bad "the live system's checks"
+fi
+rm -f esp-loader.efi
+mcopy -o -i target.img@@1M ::/EFI/BOOT/BOOTX64.EFI esp-loader.efi 2>/dev/null \
+	|| true
+if [ -n "$loaderMD5" ] \
+		&& [ "$(md5sum esp-loader.efi | cut -d' ' -f1)" = "$loaderMD5" ]; then
+	ok "Installer put the system's EFI loader on the ESP"
+else
+	bad "no EFI loader on the ESP"
+fi
+
+echo "== booting the installed encrypted disk on its own"
+cp /usr/share/OVMF/OVMF_VARS_4M.fd vars2.fd
+rm -f s2.sock m2.sock
+timeout "$TIMEOUT" qemu-system-x86_64 -M q35 -cpu max -smp 4 -m 2048 \
+	-accel tcg,thread=multi \
+	-drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
+	-drive if=pflash,format=raw,file=vars2.fd \
+	-drive if=none,id=disk,file=target.img,format=raw \
+	-device nvme,drive=disk,serial=installed \
+	-nic none -display none -no-reboot \
+	-chardev socket,id=ser0,path=s2.sock,server=on,wait=on \
+	-serial chardev:ser0 -monitor unix:m2.sock,server,nowait \
+	> qemu-installed.log 2>&1 &
+qemu=$!
+python3 -I "$HERE/boot_console.py" s2.sock m2.sock serial-installed.log \
+	files/key-installed --timeout "$TIMEOUT" || true
+wait $qemu || true
+grep -a "LUKSTEST" serial-installed.log | sed 's/^.*LUKSTEST /installed: /' \
+	| grep -v "installed:    |"
+if grep -aq "LUKSTEST done: [0-9]* passed, 0 failed" serial-installed.log; then
+	ok "the installed encrypted system booted with one passphrase prompt"
+else
+	bad "the installed system's boot"
+fi
+
+echo "$passed passed, $failed failed"
+[ $failed -eq 0 ]
