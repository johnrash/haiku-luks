+#include <luks2/luks2_userland.h>
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "EncryptedVolume"
+
+
+static const char* kSignature = "application/x-vnd.Haiku-EncryptedVolume";
+static const size_t kMaxPassphraseLength = 512;
+
+enum {
+	kMsgUnlock		= 'unlk',
+	kMsgEncrypt		= 'encr',
+	kMsgDone		= 'done',
+	kMsgTextChanged	= 'txch'
+};
+
+enum mode {
