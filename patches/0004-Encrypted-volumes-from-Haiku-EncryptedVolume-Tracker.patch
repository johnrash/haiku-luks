+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	EncryptedVolume: unlocks a LUKS2 partition and mounts what's inside,
+	locks it again, or encrypts a partition with a BFS volume inside.
+	Tracker's Mount menu and DriveSetup start it with a partition path:
+
+		EncryptedVolume <partition>				ask for the passphrase, mount
+		EncryptedVolume --encrypt <partition>	new LUKS2 volume with BFS
+		EncryptedVolume --lock <partition>		unmount and lock, no window
+
+	For tests the windows answer the scripting messages 'unlk' and 'encr'
+	(hey EncryptedVolume unlk of Window 0) after the work is done, with the
+	"result" status, "device" and "mount point".
+*/
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <Alert.h>
+#include <Application.h>
+#include <Bitmap.h>
+#include <Button.h>
+#include <Catalog.h>
+#include <CheckBox.h>
+#include <DiskDevice.h>
+#include <DiskDeviceRoster.h>
+#include <DiskDeviceVisitor.h>
+#include <Drivers.h>
+#include <Entry.h>
+#include <IconUtils.h>
+#include <LayoutBuilder.h>
+#include <Partition.h>
+#include <Path.h>
+#include <Resources.h>
+#include <Roster.h>
+#include <StringView.h>
+#include <TextControl.h>
+#include <View.h>
