+	volumes on the decrypted device are listed like any other. */
+void
+AddMenuItemVisitor::AddEncryptedVolume(BPartition* partition)
+{
+	if (partition->CountChildren() > 0 || partition->ContentType() != NULL)
+		return;
+
+	BPath path;
+	char label[48];
+	if (partition->GetPath(&path) != B_OK
+		|| !luks2_partition_label(path.Path(), label, sizeof(label), NULL, 0)) {
+		return;
+	}
+	luks2_device_info info;
+	if (luks2_find_open_device(path.Path(), &info) == B_OK)
+		return;
+
+	uint32 divisor = 1UL << 30;
+	char unit = 'G';
+	if (partition->Size() < divisor) {
+		divisor = 1UL << 20;
+		unit = 'M';
+	}
+	BString name;
+	name.SetToFormat(B_TRANSLATE("Unlock \"%s\" (%.1f %cB, encrypted)"
+		B_UTF8_ELLIPSIS), label[0] != '\0' ? label : B_TRANSLATE("unnamed"),
+		1.0 * partition->Size() / divisor, unit);
+
+	BMessage* message = new BMessage(kUnlockEncryptedVolume);
+	message->AddString("path", path.Path());
+	fMenu->AddItem(new BMenuItem(name.String(), message));
+}
