diff --git a/src/tests/system/luks2/qemu/guest-ui-test.sh b/src/tests/system/luks2/qemu/guest-ui-test.sh
new file mode 100755
index 0000000000..95bdaaee29
--- /dev/null
+++ b/src/tests/system/luks2/qemu/guest-ui-test.sh
@@ -0,0 +1,163 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# The guest half of run-ui-test.sh, run over ssh on the desktop: drives
+# EncryptedVolume, mount_server, Tracker and Installer with hey.
+#  1. EncryptedVolume --encrypt on a blank disk: LUKS2 + BFS, mounted
+#  2. files on it; unmounted through mount_server (as Tracker does): locked
+#  3. Tracker's "Unlock" message: EncryptedVolume, a wrong passphrase, the
+#     right one: mounted again, the files intact
+#  4. EncryptedVolume --lock (DriveSetup's Lock)
+#  5. partition 2 of a GPT disk encrypted, Installer installs onto it, and
+#     installs the EFI loader onto the disk's ESP
+# Usage: guest-ui-test.sh <test files dir>
+
+T=$1
+passed=0
+failed=0
+ok() { passed=$((passed + 1)); echo "ok   $*"; }
+bad() { failed=$((failed + 1)); echo "FAIL $*"; }
+result() { sed -n 's/^ *"'"$1"'" ([A-Z_0-9]*) : //p' | sed 's/^"\(.*\)"$/\1/'; }
+wait_window() {
+	# wait_window <app> <title part>
+	for i in $(seq 1 30); do
+		hey "$1" get Title of Window 0 2>/dev/null | grep -q "$2" && return 0
+		sleep 1
+	done
+	return 1
+}
+
+bootDisk=$(df /boot | sed -n 's/^ *Device: *\/dev\/disk\/nvme\/\([0-9]*\)\/.*/\1/p')
+for d in /dev/disk/nvme/*; do
+	n=$(basename "$d")
+	[ "$n" = "$bootDisk" ] && continue
+	if [ "$(head -c 14 "$d/raw")" = "LUKSTEST-BLANK" ]; then
+		BLANK=$d/raw
+	elif [ -e "$d/1" ]; then
+		TARGET=$d
+	fi
+done
+echo "boot disk $bootDisk, blank $BLANK, target $TARGET"
+
+echo "== 1. encrypt a blank disk with EncryptedVolume"
+EncryptedVolume --encrypt "$BLANK" > /tmp/ev.log 2>&1 &
+wait_window EncryptedVolume Encrypt || bad "no Encrypt window"
+name=$(hey EncryptedVolume get Value of View name of Window 0 | result result)
+[ "$name" = "Encrypted" ] && ok "a whole disk gets the default name" \
+	|| bad "default name \"$name\""
+hey EncryptedVolume set Value of View name of Window 0 to '"Secret"' > /dev/null
+hey EncryptedVolume set Value of View passphrase of Window 0 to '"first passphrase"' > /dev/null
+hey EncryptedVolume set Value of View repeat of Window 0 to '"not the same"' > /dev/null
+[ "$(hey EncryptedVolume get Enabled of View ok of Window 0 | result result)" = FALSE ] \
+	&& ok "Encrypt is disabled while the passphrases differ" \
+	|| bad "Encrypt enabled with different passphrases"
+hey EncryptedVolume set Value of View repeat of Window 0 to '"first passphrase"' > /dev/null
+screenshot -s -f png /boot/home/ui-encrypt.png
+reply=$(hey EncryptedVolume encr of Window 0)
+[ "$(echo "$reply" | result result)" = "0 (0x00000000)" ] \
+	&& ok "encrypted and mounted at $(echo "$reply" | result 'mount point')" \
+	|| bad "encrypt: $reply"
+cp /boot/system/lib/libbe.so /Secret/
+echo "secret note" > /Secret/note.txt
+sync
+sum=$(sha256sum /Secret/libbe.so | cut -d' ' -f1)
+
+echo "== 2. unmounted through mount_server: locked"
+dev=$(df /Secret | sed -n 's/^ *Device No.: *//p')
+hey application/x-vnd.Haiku-mount_server umnt with device_id="int32($dev)" > /dev/null
+sleep 3
+[ ! -d /Secret ] && ok "unmounted" || bad "/Secret still there"
+luks list | grep -q "No open" && ok "the unmount locked it (eject)" \
+	|| bad "still open: $(luks list)"
+
+echo "== 3. Tracker's Unlock message, a wrong passphrase, the right one"
+hey Tracker Tulk with path="\"$BLANK\"" > /dev/null
+wait_window EncryptedVolume Unlock && ok "Tracker started EncryptedVolume" \
+	|| bad "no Unlock window"
+hey EncryptedVolume set Value of View passphrase of Window 0 to '"wrong"' > /dev/null
+reply=$(hey EncryptedVolume unlk of Window 0)
+echo "$reply" | grep -q "doesn't open" && ok "the wrong passphrase is refused" \
+	|| bad "wrong passphrase: $reply"
+screenshot -s -f png /boot/home/ui-wrong.png
+hey EncryptedVolume set Value of View passphrase of Window 0 to '"first passphrase"' > /dev/null
+reply=$(hey EncryptedVolume unlk of Window 0)
+[ "$(echo "$reply" | result result)" = "0 (0x00000000)" ] \
+	&& ok "unlocked and mounted at $(echo "$reply" | result 'mount point')" \
+	|| bad "unlock: $reply"
+[ "$(sha256sum /Secret/libbe.so | cut -d' ' -f1)" = "$sum" ] \
+	&& [ "$(cat /Secret/note.txt)" = "secret note" ] \
+	&& ok "the files are intact" || bad "files differ"
+
+echo "== 4. EncryptedVolume --lock (DriveSetup's Lock)"
+EncryptedVolume --lock "$BLANK" && luks list | grep -q "No open" \
+	&& [ ! -d /Secret ] && ok "locked" || bad "lock: $(luks list)"
+
+echo "== 5. Installer onto an encrypted partition, EFI loader onto the ESP"
+EncryptedVolume --encrypt "$TARGET/1" > /tmp/ev2.log 2>&1 &
+wait_window EncryptedVolume Encrypt || bad "no Encrypt window"
+hey EncryptedVolume set Value of View name of Window 0 to '"HaikuLUKS"' > /dev/null
+hey EncryptedVolume set Value of View passphrase of Window 0 to "\"$(cat $T/key-installed)\"" > /dev/null
+hey EncryptedVolume set Value of View repeat of Window 0 to "\"$(cat $T/key-installed)\"" > /dev/null
+reply=$(hey EncryptedVolume encr of Window 0)
+[ "$(echo "$reply" | result result)" = "0 (0x00000000)" ] \
+	&& ok "partition 2 encrypted, BFS mounted at /HaikuLUKS" \
+	|| bad "encrypt the target: $reply"
+
+Installer > /tmp/installer.log 2>&1 &
+wait_window Installer README || bad "no README window"
+hey Installer next > /dev/null
+hey Installer agre > /dev/null
+sleep 6
+S="Menu 0 of View 0 of View srcMenuField of Window 0"
+M="Menu 0 of View 0 of View destMenuField of Window 0"
+target=-1
+count=$(hey Installer count MenuItem of $M | result result | cut -d' ' -f1)
+for i in $(seq 0 $((count - 1))); do
+	label=$(hey Installer get Label of MenuItem $i of $M | result result)
+	echo "   target $i: $label"
+	case "$label" in
+		HaikuLUKS*luks*) target=$i ;;
+	esac
+done
+[ $target -ge 0 ] && ok "Installer offers the unlocked volume as a target" \
+	|| bad "no HaikuLUKS target"
+hey Installer set Mark of MenuItem 0 of $S to "bool(true)" > /dev/null
+hey Installer set Mark of MenuItem $target of $M to "bool(true)" > /dev/null
+hey Installer iSPT of Window 0 > /dev/null
+hey Installer iTPT of Window 0 > /dev/null
+sleep 2
+screenshot -s -f png /boot/home/ui-installer.png
+hey Installer iBGN of Window 0 > /dev/null
+for i in $(seq 1 900); do
+	label=$(hey Installer get Label of View begin_button of Window 0 | result result)
+	[ "$label" != "Stop" ] && break
+	sleep 2
+done
+[ "$label" = "Quit" ] && [ -d /HaikuLUKS/system/packages ] \
+	&& ok "Installer finished: $(ls /HaikuLUKS/system/packages | wc -l) packages" \
+	|| bad "Installer: button \"$label\""
+
+E="Menu 2 of Menu 0 of MenuBar of Window 0"
+hey Installer get Label of MenuItem 0 of $E | result result
+hey Installer do MenuItem 0 of $E > /dev/null
+sleep 4
+screenshot -s -f png /boot/home/ui-efi.png
+hey Installer ALTB of Window 0 with which="int32(0)" > /dev/null
+ok "Install EFI loader invoked (the host checks the ESP)"
+md5sum /boot/system/data/platform_loaders/haiku_loader.efi | cut -d' ' -f1 \
+	> /tmp/loader.md5
+
+# the installed system runs the boot checks and lets us in at its first boot
+S=/HaikuLUKS/system/settings
+mkdir -p $S/luks-test $S/launch $S/network /HaikuLUKS/home/config/settings
+cp $T/ssh-setup.sh $T/authorized_keys $T/test.sh $S/luks-test/
+cp $T/ssh.job $S/launch/luks-test-ssh
+cp $T/test.job $S/launch/luks-test
+cp $T/hostname $S/network/hostname
+cp "$T/Locale settings" "/HaikuLUKS/home/config/settings/Locale settings"
+luks dump "$TARGET/1" | sed -n 's/^  UUID: *//p' > $S/luks-test/uuid
+sync
+hey Installer quit > /dev/null 2>&1
+
+echo "done: $passed passed, $failed failed"
