+
+class VolumeWindow : public BWindow {
+public:
+								VolumeWindow(int mode, const char* path);
+	virtual						~VolumeWindow();
+
+	virtual	void				MessageReceived(BMessage* message);
+
+private:
+			void				_Start(BMessage* request);
+			void				_Done(BMessage* message);
+			void				_SetBusy(bool busy, const char* status);
+			void				_UpdateButton();
+			void				_ReplyToScript(BMessage& reply);
+
+private:
+			int					fMode;
+			BString				fPath;
+			BTextControl*		fName;
+			BTextControl*		fPassphrase;
+			BTextControl*		fRepeat;
+			BCheckBox*			fReadOnly;
+			BStringView*		fStatus;
+			BButton*			fOK;
+			BButton*			fCancel;
+			BMessage*			fScriptRequest;
+			bool				fBusy;
+};
+
+
+VolumeWindow::VolumeWindow(int mode, const char* path)
+	:
+	BWindow(BRect(0, 0, 400, 200), mode == kUnlockMode
+			? B_TRANSLATE("Unlock encrypted volume")
+			: B_TRANSLATE("Encrypt partition"),
+		B_TITLED_WINDOW, B_NOT_ZOOMABLE | B_NOT_RESIZABLE
+			| B_AUTO_UPDATE_SIZE_LIMITS | B_QUIT_ON_WINDOW_CLOSE),
+	fMode(mode),
+	fPath(path),
+	fName(NULL),
+	fRepeat(NULL),
+	fReadOnly(NULL),
+	fScriptRequest(NULL),
+	fBusy(false)
+{
+	PartitionInfo info;
+	info.size = 0;
+	get_partition_info(path, info);
+
+	BString title;
+	BString detail;
+	if (mode == kUnlockMode) {
+		title = B_TRANSLATE("Unlock \"%label%\" (%size%)");
+		title.ReplaceFirst("%label%", info.label.Length() > 0
+			? info.label.String() : B_TRANSLATE("unnamed"));
+		detail = path;
+	} else {
+		title = B_TRANSLATE("Encrypt %path% (%size%)");
+		title.ReplaceFirst("%path%", path);
+		detail = B_TRANSLATE("Everything on this partition will be lost.");
+	}
+	title.ReplaceFirst("%size%", size_string(info.size).String());
+
+	BStringView* titleView = new BStringView("title", title.String());
+	titleView->SetFont(be_bold_font);
+	BStringView* detailView = new BStringView("detail", detail.String());
+
+	fPassphrase = new BTextControl("passphrase", B_TRANSLATE("Passphrase:"),
+		"", new BMessage(kMsgTextChanged));
+	fPassphrase->TextView()->HideTyping(true);
+	fPassphrase->SetModificationMessage(new BMessage(kMsgTextChanged));
+
+	fStatus = new BStringView("status", "");
+	fCancel = new BButton("cancel", B_TRANSLATE("Cancel"),
+		new BMessage(B_QUIT_REQUESTED));
+	fOK = new BButton("ok", mode == kUnlockMode ? B_TRANSLATE("Unlock")
+		: B_TRANSLATE("Encrypt"),
+		new BMessage(mode == kUnlockMode ? kMsgUnlock : kMsgEncrypt));
+
+	BLayoutBuilder::Grid<> grid(B_USE_DEFAULT_SPACING, B_USE_SMALL_SPACING);
+	int32 row = 0;
+	if (mode == kEncryptMode) {
+		fName = new BTextControl("name", B_TRANSLATE("Volume name:"),
+			info.name.Length() > 0 ? info.name.String() : "Encrypted",
+			new BMessage(kMsgTextChanged));
+		fName->SetModificationMessage(new BMessage(kMsgTextChanged));
+		grid.AddTextControl(fName, 0, row++);
+	}
+	grid.AddTextControl(fPassphrase, 0, row++);
+	if (mode == kEncryptMode) {
+		fRepeat = new BTextControl("repeat", B_TRANSLATE("Repeat:"), "",
+			new BMessage(kMsgTextChanged));
+		fRepeat->TextView()->HideTyping(true);
+		fRepeat->SetModificationMessage(new BMessage(kMsgTextChanged));
+		grid.AddTextControl(fRepeat, 0, row++);
+	} else {
+		fReadOnly = new BCheckBox("read only", B_TRANSLATE("Read-only"),
+			NULL);
+		grid.Add(fReadOnly, 1, row++);
+	}
+
+	BLayoutBuilder::Group<>(this, B_VERTICAL)
+		.SetInsets(B_USE_WINDOW_SPACING)
+		.AddGroup(B_HORIZONTAL)
+			.Add(new IconView())
+			.AddGroup(B_VERTICAL, B_USE_SMALL_SPACING)
+				.Add(titleView)
+				.Add(detailView)
+				.Add(grid.View())
+			.End()
+		.End()
+		.Add(fStatus)
+		.AddGroup(B_HORIZONTAL)
+			.AddGlue()
+			.Add(fCancel)
+			.Add(fOK)
+		.End();
+
+	fOK->MakeDefault(true);
+	fPassphrase->MakeFocus(true);
+	_UpdateButton();
+	CenterOnScreen();
+}
+
+
+VolumeWindow::~VolumeWindow()
+{
+	delete fScriptRequest;
+}
+
+
+void
+VolumeWindow::_SetBusy(bool busy, const char* status)
+{
+	fBusy = busy;
+	fStatus->SetText(status);
+	fPassphrase->SetEnabled(!busy);
+	if (fName != NULL)
+		fName->SetEnabled(!busy);
+	if (fRepeat != NULL)
+		fRepeat->SetEnabled(!busy);
+	if (fReadOnly != NULL)
+		fReadOnly->SetEnabled(!busy);
+	fCancel->SetEnabled(!busy);
+	_UpdateButton();
+}
+
+
+void
+VolumeWindow::_UpdateButton()
+{
+	bool enabled = !fBusy && fPassphrase->Text()[0] != '\0';
+	if (fMode == kEncryptMode) {
+		enabled = enabled && fName->Text()[0] != '\0'
+			&& strcmp(fPassphrase->Text(), fRepeat->Text()) == 0;
+	}
+	fOK->SetEnabled(enabled);
+}
+
+
+void
+VolumeWindow::_ReplyToScript(BMessage& reply)
+{
+	if (fScriptRequest == NULL)
+		return;
+	fScriptRequest->SendReply(&reply);
+	delete fScriptRequest;
+	fScriptRequest = NULL;
+}
+
+
+void
+VolumeWindow::_Start(BMessage* request)
+{
+	if (fBusy || !fOK->IsEnabled()) {
+		if (request->IsSourceWaiting()) {
+			BMessage reply(B_REPLY);
+			reply.AddInt32("result", B_NOT_ALLOWED);
+			reply.AddString("error", "not ready");
+			request->SendReply(&reply);
+		}
+		return;
+	}
+
+	if (fMode == kEncryptMode && !request->IsSourceWaiting()) {
+		BString text(B_TRANSLATE("Encrypting %path% erases everything on it. "
+			"Continue?"));
+		text.ReplaceFirst("%path%", fPath.String());
+		BAlert* alert = new BAlert(B_TRANSLATE("Encrypt partition"),
+			text.String(), B_TRANSLATE("Cancel"), B_TRANSLATE("Encrypt"),
+			NULL, B_WIDTH_AS_USUAL, B_WARNING_ALERT);
+		alert->SetShortcut(0, B_ESCAPE);
+		if (alert->Go() != 1)
+			return;
+	}
+
+	if (request->IsSourceWaiting())
+		fScriptRequest = DetachCurrentMessage();
+
+	Job* job = new Job;
+	job->target = BMessenger(this);
+	job->mode = fMode;
+	job->path = fPath;
+	job->passphrase = (char*)calloc(1, kMaxPassphraseLength + 1);
+	strlcpy(job->passphrase, fPassphrase->Text(), kMaxPassphraseLength + 1);
+	job->passphraseLength = strlen(job->passphrase);
+	job->readOnly = fReadOnly != NULL && fReadOnly->Value() == B_CONTROL_ON;
+	if (fName != NULL)
+		job->volumeName = fName->Text();
+
+	// the passphrase only lives in the job from now on
+	fPassphrase->SetText("");
+	if (fRepeat != NULL)
+		fRepeat->SetText("");
+
+	_SetBusy(true, fMode == kUnlockMode ? B_TRANSLATE("Unlocking…")
+		: B_TRANSLATE("Encrypting…"));
+
+	thread_id thread = spawn_thread(job_thread, "encrypted volume job",
+		B_NORMAL_PRIORITY, job);
+	if (thread < 0 || resume_thread(thread) != B_OK) {
+		luks2_wipe(job->passphrase, kMaxPassphraseLength + 1);
+		free(job->passphrase);
+		delete job;
+		_SetBusy(false, strerror(thread));
+	}
+}
+
+
+void
+VolumeWindow::_Done(BMessage* message)
+{
+	status_t result = message->GetInt32("result", B_ERROR);
+	BMessage reply(B_REPLY);
+	reply.AddInt32("result", result);
+	const char* text;
+	if (message->FindString("error", &text) == B_OK)
+		reply.AddString("error", text);
+	if (message->FindString("device", &text) == B_OK)
+		reply.AddString("device", text);
+	if (message->FindString("mount point", &text) == B_OK)
+		reply.AddString("mount point", text);
+	_ReplyToScript(reply);
+
+	if (result != B_OK) {
+		_SetBusy(false, message->GetString("error", strerror(result)));
+		fPassphrase->MakeFocus(true);
+		return;
+	}
+
+	// show the volume in Tracker
+	const char* mountPoint;
+	entry_ref ref;
+	if (message->FindString("mount point", &mountPoint) == B_OK
+		&& get_ref_for_path(mountPoint, &ref) == B_OK) {
+		be_roster->Launch(&ref);
+	}
+	PostMessage(B_QUIT_REQUESTED);
+}
+
+
+void
+VolumeWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgTextChanged:
+			_UpdateButton();
+			break;
+
+		case kMsgUnlock:
+		case kMsgEncrypt:
+			_Start(message);
+			break;
+
+		case kMsgDone:
+			_Done(message);
+			break;
+
+		default:
+			BWindow::MessageReceived(message);
+			break;
+	}
+}
+
+
+// #pragma mark - application
+
+
+class EncryptedVolumeApp : public BApplication {
+public:
+	EncryptedVolumeApp()
+		:
+		BApplication(kSignature),
+		fMode(kUnlockMode)
+	{
+	}
+
+	virtual void ArgvReceived(int32 argc, char** argv)
+	{
+		int mode = kUnlockMode;
+		const char* path = NULL;
+		for (int32 i = 1; i < argc; i++) {
+			if (strcmp(argv[i], "--encrypt") == 0)
+				mode = kEncryptMode;
+			else if (strcmp(argv[i], "--lock") == 0)
+				mode = kLockMode;
+			else
+				path = argv[i];
+		}
+		if (path == NULL)
+			return;
+		fMode = mode;
+		fPath = path;
+	}
+
+	virtual void ReadyToRun()
+	{
+		if (fPath.Length() == 0) {
+			_Fail(B_TRANSLATE("Start EncryptedVolume with the path of an "
+				"encrypted partition, from Tracker's Mount menu or from "
+				"DriveSetup."));
+			return;
+		}
+
+		if (fMode == kLockMode) {
+			status_t status = lock_volume(fPath.String());
+			if (status != B_OK) {
+				BString text(B_TRANSLATE("Locking %path% failed: %error%"));
+				text.ReplaceFirst("%path%", fPath.String());
+				text.ReplaceFirst("%error%", strerror(status));
+				_Fail(text.String());
+				return;
+			}
+			Quit();
+			return;
+		}
+
+		if (fMode == kUnlockMode) {
+			luks2_device_info info;
+			if (!luks2_partition_label(fPath.String(), NULL, 0, NULL, 0)) {
+				BString text(B_TRANSLATE("%path% isn't an encrypted (LUKS2) "
+					"volume."));
+				text.ReplaceFirst("%path%", fPath.String());
+				_Fail(text.String());
+				return;
+			}
+			if (luks2_find_open_device(fPath.String(), &info) == B_OK) {
+				BString text(B_TRANSLATE("%path% is unlocked already, as "
+					"%device%."));
+				text.ReplaceFirst("%path%", fPath.String());
+				text.ReplaceFirst("%device%", info.device);
+				_Fail(text.String());
+				return;
+			}
+		}
+
+		(new VolumeWindow(fMode, fPath.String()))->Show();
+	}
+
+private:
+	void _Fail(const char* text)
+	{
+		BAlert* alert = new BAlert(B_TRANSLATE("Encrypted volume"), text,
+			B_TRANSLATE("OK"), NULL, NULL, B_WIDTH_AS_USUAL, B_STOP_ALERT);
+		alert->Go();
+		Quit();
+	}
+
+private:
+	int		fMode;
+	BString	fPath;
+};
+
+
+int
+main()
+{
+	EncryptedVolumeApp app;
+	app.Run();
+	return 0;
+}
