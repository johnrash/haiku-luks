+				BootVolumeKey& entry = sBootVolumeKeys[i];
+				if (entry.opened || strcmp(entry.uuid, uuid) != 0)
+					continue;
+
+				KPath path;
+				if (partition->GetPath(&path) != B_OK)
+					return false;
+				char device[B_PATH_NAME_LENGTH];
+				status_t status = fLUKS->open_volume(path.Path(), entry.key,
+					entry.keySize, device, sizeof(device));
+				if (status == B_OK) {
+					dprintf("vfs_boot: encrypted boot volume %s opened as "
+						"%s\n", path.Path(), device);
+					entry.opened = true;
+					fOpened = true;
+				} else {
+					dprintf("vfs_boot: opening encrypted volume %s failed: "
+						"%s\n", path.Path(), strerror(status));
+				}
+			}
+			return false;
+		}
+
+		luks2_boot_module_info*	fLUKS;
+		bool					fOpened;
+	} visitor(luks);
+
