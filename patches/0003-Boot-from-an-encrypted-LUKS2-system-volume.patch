+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	LUKS2 encrypted volumes in the boot loader: partitions with a LUKS2
+	header are kept as locked volumes; after the passphrase opened one, an
+	EncryptedDisk node decrypts it and is scanned like a disk, so the BFS
+	volume inside can be the boot volume. The kernel gets the volume key in
+	the boot volume message (see luks_register_boot_device()) and opens the
+	volume itself without asking again.
+
+	All of it is platform independent: it uses the loader's Node and
+	Partition classes, the text console and malloc() (whose large
+	allocations, Argon2's memory, come from the platform's page allocator).
+*/
+
+
+#include "luks.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <boot/kernel_args.h>
+#include <boot/menu.h>
+#include <boot/partitions.h>
+#include <boot/platform/generic/text_console.h>
+#include <boot/stage2.h>
+#include <boot/stdio.h>
+#include <util/KMessage.h>
+
+#include <luks2/luks2.h>
+
+#include "loader.h"
+#include "RootFileSystem.h"
+
+
+//#define TRACE_LUKS
+#ifdef TRACE_LUKS
+#	define TRACE(x...) dprintf("luks: " x)
+#else
+#	define TRACE(x...) do {} while (false)
+#endif
+
+
+using namespace boot;
+
+
+static const size_t kMaxPassphraseLength = 512;
+static const size_t kBufferSize = 64 * 1024;
+
+
+struct LockedVolume;
+
+
+class EncryptedDisk : public Node {
+public:
+								EncryptedDisk(LockedVolume* volume,
+									const luks2_volume* header);
+	virtual						~EncryptedDisk();
+
+			status_t			Init(const uint8* key, size_t keySize);
+			void				Wipe();
+
+	virtual	ssize_t				ReadAt(void* cookie, off_t position,
+									void* buffer, size_t bufferSize);
+	virtual	ssize_t				WriteAt(void* cookie, off_t position,
+									const void* buffer, size_t bufferSize);
+	virtual	off_t				Size() const;
+	virtual	status_t			GetName(char* name, size_t nameSize) const;
+
+			const uint8*		Key() const { return fKey; }
+			size_t				KeySize() const { return fKeySize; }
+			const char*			UUID() const { return fUUID; }
+
+private:
+			LockedVolume*		fVolume;
+			luks2_xts			fCipher;
+			uint8				fKey[LUKS2_MAX_KEY_SIZE];
+			size_t				fKeySize;
+			uint64				fDataOffset;
+			off_t				fSize;
+			uint32				fSectorSize;
+			uint64				fIVTweak;
+			uint8*				fBuffer;
+			char				fUUID[LUKS2_UUID_SIZE];
+			char				fName[LUKS2_LABEL_SIZE + 16];
+			bool				fWiped;
+};
+
+
+/*!	A LUKS2 volume found while scanning. It keeps its own descriptor of the
+	device it's on: the loader deletes and recreates Partition objects when
+	it scans again. */
+struct LockedVolume {
+	LockedVolume*	next;
+	int				fd;			// of the device the volume is on
+	Node*			device;		// kept alive by fd
+	off_t			offset;		// of the LUKS2 partition on the device
+	off_t			size;
+	luks2_volume*	header;
+	EncryptedDisk*	disk;		// once unlocked
+	char			name[96];
+};
+
+
+static ssize_t
+volume_read(LockedVolume* volume, uint64 offset, void* buffer, size_t size)
+{
+	if (offset > (uint64)volume->size)
+		return 0;
+	if (size > (uint64)volume->size - offset)
+		size = volume->size - offset;
+	ssize_t bytesRead = read_pos(volume->fd, volume->offset + offset, buffer,
+		size);
+	return bytesRead < 0 ? (ssize_t)errno : bytesRead;
+}
+
+
+static LockedVolume* sVolumes = NULL;
+static LockedVolume* sBootVolume = NULL;
+
+
+// #pragma mark - EncryptedDisk
+
+
+EncryptedDisk::EncryptedDisk(LockedVolume* volume, const luks2_volume* header)
+	:
+	fVolume(volume),
+	fKeySize(0),
+	fDataOffset(header->segment.offset),
+	fSize(header->segment.size),
+	fSectorSize(header->segment.sector_size),
+	fIVTweak(header->segment.iv_tweak),
+	fBuffer(NULL),
+	fWiped(false)
+{
+	memset(&fCipher, 0, sizeof(fCipher));
+	memset(fKey, 0, sizeof(fKey));
+	strlcpy(fUUID, header->uuid, sizeof(fUUID));
+	snprintf(fName, sizeof(fName), "LUKS2 %s",
+		header->label[0] != '\0' ? header->label : header->uuid);
+}
+
+
+EncryptedDisk::~EncryptedDisk()
+{
+	Wipe();
+	free(fBuffer);
+}
+
+
+status_t
+EncryptedDisk::Init(const uint8* key, size_t keySize)
+{
+	if (keySize > sizeof(fKey))
+		return B_BAD_VALUE;
+	fBuffer = (uint8*)malloc(kBufferSize);
+	if (fBuffer == NULL)
+		return B_NO_MEMORY;
+	if (luks2_xts_set_key(&fCipher, key, keySize) != 0)
+		return B_BAD_VALUE;
+	memcpy(fKey, key, keySize);
+	fKeySize = keySize;
+	dprintf("luks: %s: %" B_PRIdOFF " bytes at %" B_PRIu64 ", sector size %"
+		B_PRIu32 ", AES-%u-XTS (%s)\n", fName, fSize, fDataOffset, fSectorSize,
+		(unsigned)(keySize * 4),
+		luks2_aes_implementation_name(fCipher.data.implementation));
+	return B_OK;
+}
+
+
+void
+EncryptedDisk::Wipe()
+{
+	luks2_xts_clear(&fCipher);
+	luks2_wipe(fKey, sizeof(fKey));
+	if (fBuffer != NULL)
+		luks2_wipe(fBuffer, kBufferSize);
+	fKeySize = 0;
+	fWiped = true;
+}
+
+
+ssize_t
+EncryptedDisk::ReadAt(void* cookie, off_t position, void* buffer,
+	size_t bufferSize)
+{
+	if (fWiped)
+		return B_NOT_ALLOWED;
+	if (position < 0)
+		return B_BAD_VALUE;
+	if (position >= fSize)
+		return 0;
+	if ((off_t)bufferSize > fSize - position)
+		bufferSize = fSize - position;
+
+	size_t done = 0;
+	while (done < bufferSize) {
+		uint64 current = position + done;
+		uint64 start = current / fSectorSize * fSectorSize;
+		size_t skip = current - start;
+		size_t chunk = skip + (bufferSize - done);
+		chunk = (chunk + fSectorSize - 1) / fSectorSize * fSectorSize;
+		if (chunk > kBufferSize)
+			chunk = kBufferSize;
+
+		ssize_t bytesRead = volume_read(fVolume, fDataOffset + start, fBuffer,
+			chunk);
+		if (bytesRead != (ssize_t)chunk)
+			return done > 0 ? (ssize_t)done : B_IO_ERROR;
+
+		for (size_t i = 0; i < chunk; i += fSectorSize) {
+			luks2_xts_decrypt(&fCipher,
+				(start + i) / LUKS2_IV_SECTOR_SIZE + fIVTweak, fBuffer + i,
+				fSectorSize);
+		}
+
+		size_t toCopy = chunk - skip;
+		if (toCopy > bufferSize - done)
+			toCopy = bufferSize - done;
+		memcpy((uint8*)buffer + done, fBuffer + skip, toCopy);
+		done += toCopy;
+	}
+	return done;
+}
+
+
+ssize_t
+EncryptedDisk::WriteAt(void* cookie, off_t position, const void* buffer,
+	size_t bufferSize)
+{
+	return B_NOT_ALLOWED;
+}
+
+
+off_t
+EncryptedDisk::Size() const
+{
+	return fSize;
+}
+
+
+status_t
+EncryptedDisk::GetName(char* name, size_t nameSize) const
+{
+	if (name == NULL)
+		return B_BAD_VALUE;
+	strlcpy(name, fName, nameSize);
+	return B_OK;
+}
+
+
+// #pragma mark - I/O on the LUKS2 partition
+
+
+static ssize_t
+header_read(void* cookie, uint64_t offset, void* buffer, size_t size)
+{
+	return volume_read((LockedVolume*)cookie, offset, buffer, size);
+}
+
+
+static luks2_device_io
+volume_io(LockedVolume* volume)
+{
+	luks2_device_io io = { volume, header_read, NULL, (uint64_t)volume->size };
+	return io;
+}
+
+
+// #pragma mark - locked volumes
+
+
+bool
+luks_probe_partition(Partition* partition)
+{
+	uint8 first[512];
+	if (partition->ReadAt(NULL, 0, first, sizeof(first)) != sizeof(first)
+		|| !luks2_has_signature(first, sizeof(first))) {
+		return false;
+	}
+
+	LockedVolume* volume = (LockedVolume*)calloc(1, sizeof(LockedVolume));
+	if (volume == NULL)
+		return false;
+	volume->fd = dup(partition->FD());
+	volume->device = volume->fd >= 0 ? get_node_from(volume->fd) : NULL;
+	volume->offset = partition->offset;
+	volume->size = partition->Size();
+	if (volume->device == NULL) {
+		if (volume->fd >= 0)
+			close(volume->fd);
+		free(volume);
+		return false;
+	}
+
+	luks2_device_io io = volume_io(volume);
+	int result = luks2_read_header(&io, &volume->header);
+	if (result != LUKS2_OK) {
+		dprintf("luks: partition at %" B_PRIdOFF ": %s\n", partition->offset,
+			luks2_error_string(result));
+		close(volume->fd);
+		free(volume);
+		return false;
+	}
+
+	// The loader scans disks more than once: the same volume seen again
+	for (LockedVolume* other = sVolumes; other != NULL; other = other->next) {
+		if (other->device == volume->device && other->offset == volume->offset
+			&& strcmp(other->header->uuid, volume->header->uuid) == 0) {
+			luks2_free_volume(volume->header);
+				close(volume->fd);
+			free(volume);
+			return true;
+		}
+	}
+
+	luks2_volume* header = volume->header;
+	uint64 size = header->segment.size;
+	const char* unit = "MiB";
+	uint64 tenths = size * 10 / (1024 * 1024);
+	if (tenths >= 10240) {
+		tenths /= 1024;
+		unit = "GiB";
+	}
+	snprintf(volume->name, sizeof(volume->name), "\"%s\" (%" B_PRIu64 ".%"
+		B_PRIu64 " %s)", header->label[0] != '\0' ? header->label : "unnamed",
+		tenths / 10, tenths % 10, unit);
+
+	// in the order found: the boot disk's partitions come first
+	LockedVolume** last = &sVolumes;
+	while (*last != NULL)
+		last = &(*last)->next;
+	*last = volume;
+
+	dprintf("luks: locked LUKS2 volume %s, UUID %s\n", volume->name,
+		header->uuid);
+	return true;
+}
+
+
+bool
+luks_has_locked_volumes()
+{
+	for (LockedVolume* volume = sVolumes; volume != NULL;
+			volume = volume->next) {
+		if (volume->disk == NULL)
+			return true;
+	}
+	return false;
+}
+
+
+// #pragma mark - the passphrase prompt
+
+
+static size_t
+encode_utf8(uint32 c, char* out)
+{
+	if (c < 0x80) {
+		out[0] = (char)c;
+		return 1;
+	}
+	if (c < 0x800) {
+		out[0] = (char)(0xc0 | (c >> 6));
+		out[1] = (char)(0x80 | (c & 0x3f));
+		return 2;
+	}
+	if (c < 0x10000) {
+		out[0] = (char)(0xe0 | (c >> 12));
+		out[1] = (char)(0x80 | ((c >> 6) & 0x3f));
+		out[2] = (char)(0x80 | (c & 0x3f));
+		return 3;
+	}
+	out[0] = (char)(0xf0 | (c >> 18));
+	out[1] = (char)(0x80 | ((c >> 12) & 0x3f));
+	out[2] = (char)(0x80 | ((c >> 6) & 0x3f));
+	out[3] = (char)(0x80 | (c & 0x3f));
+	return 4;
+}
+
+
+/*!	Reads a passphrase from the console without echo (one '*' per
+	character), as UTF-8. Returns its length, or -1 for Esc. */
+static ssize_t
+read_passphrase(char* buffer, size_t bufferSize)
+{
+	size_t length = 0;
+	while (true) {
+		int key = console_wait_for_key();
+		if (key == TEXT_CONSOLE_KEY_RETURN || key == '\n')
+			break;
+		if (key == TEXT_CONSOLE_KEY_ESCAPE) {
+			luks2_wipe(buffer, bufferSize);
+			printf("\n");
+			return -1;
+		}
+		if (key == TEXT_CONSOLE_KEY_BACKSPACE || key == 0x7f) {
+			if (length > 0) {
+				// remove the whole last UTF-8 character
+				do {
+					length--;
+				} while (length > 0 && ((uint8)buffer[length] & 0xc0) == 0x80);
+				printf("\b \b");
+			}
+			continue;
+		}
+		if (TEXT_CONSOLE_IS_CURSOR_KEY(key) || key < 0x20
+			|| (key >= 0xd800 && key < 0xe000) || key > 0x10ffff) {
+			continue;
+		}
+
+		char encoded[4];
+		size_t encodedLength = encode_utf8((uint32)key, encoded);
+		if (length + encodedLength >= bufferSize)
+			continue;
+		memcpy(buffer + length, encoded, encodedLength);
+		length += encodedLength;
+		luks2_wipe(encoded, sizeof(encoded));
+		printf("*");
+	}
+	buffer[length] = '\0';
+	printf("\n");
+	return length;
+}
+
+
+/*!	Scans the decrypted volume and returns the root directory of a bootable
+	volume on it, if there is one. */
+static Directory*
+bootable_volume_on(EncryptedDisk* disk)
+{
+	void* cookie;
+	if (gRoot->Open(&cookie, O_RDONLY) != B_OK)
+		return NULL;
+
+	Directory* found = NULL;
+	Directory* volume;
+	while (found == NULL
+		&& gRoot->GetNextNode(cookie, (Node**)&volume) == B_OK) {
+		Partition* partition;
+		if (gRoot->GetPartitionFor(volume, &partition) != B_OK)
+			continue;
+		// (get_node_from() doesn't add a reference)
+		if (get_node_from(partition->FD()) == disk && is_bootable(volume))
+			found = volume;
+	}
+	gRoot->Close(cookie);
+	return found;
+}
+
+
+/*!	Asks for the passphrase of \a volume until it opens or the user presses
+	Esc; then scans the decrypted contents. */
+static status_t
+unlock_volume(LockedVolume* volume)
+{
+	if (volume->disk != NULL)
+		return B_OK;
+
+	luks2_device_io io = volume_io(volume);
+	char* passphrase = (char*)malloc(kMaxPassphraseLength + 1);
+	if (passphrase == NULL)
+		return B_NO_MEMORY;
+
+	status_t status = B_ERROR;
+	for (int32 attempt = 0; ; attempt++) {
+		console_clear_screen();
+		printf("\n  Encrypted volume %s\n\n", volume->name);
+		if (attempt > 0)
+			printf("  That passphrase doesn't open this volume.\n\n");
+		printf("  Passphrase (Esc for the boot menu): ");
+
+		ssize_t length = read_passphrase(passphrase, kMaxPassphraseLength + 1);
+		if (length < 0) {
+			status = B_CANCELED;
+			break;
+		}
+
+		printf("\n  Unlocking...\n");
+		uint8 key[LUKS2_MAX_KEY_SIZE];
+		size_t keySize = 0;
+		int keyslot = -1;
+		int result = luks2_unlock(volume->header, &io, passphrase, length, -1,
+			key, &keySize, &keyslot);
+		luks2_wipe(passphrase, kMaxPassphraseLength + 1);
+
+		if (result == LUKS2_ERROR_BAD_PASSPHRASE)
+			continue;
+		if (result != LUKS2_OK) {
+			luks2_wipe(key, sizeof(key));
+			printf("\n  The volume can't be unlocked: %s.\n",
+				luks2_error_string(result));
+			if (result == LUKS2_ERROR_KDF_MEMORY)
+				printf("  Its keyslots need more memory than is free here.\n");
+			printf("\n  Press any key to continue.\n");
+			console_wait_for_key();
+			status = B_ERROR;
+			break;
+		}
+
+		dprintf("luks: %s opened with keyslot %d\n", volume->name, keyslot);
+		EncryptedDisk* disk = new(std::nothrow) EncryptedDisk(volume,
+			volume->header);
+		status = disk != NULL ? disk->Init(key, keySize) : B_NO_MEMORY;
+		luks2_wipe(key, sizeof(key));
+		if (status != B_OK) {
+			delete disk;
+			break;
+		}
+
+		volume->disk = disk;
+		add_partitions_for(disk, true, false);
+		status = B_OK;
+		break;
+	}
+
+	free(passphrase);
+	console_clear_screen();
+	return status;
+}
+
+
+status_t
+luks_unlock_boot_volume(BootVolume& bootVolume)
+{
+	for (LockedVolume* volume = sVolumes; volume != NULL;
+			volume = volume->next) {
+		if (volume->disk != NULL)
+			continue;
+
+		status_t status = unlock_volume(volume);
+		if (status == B_CANCELED)
+			return status;
+		if (status != B_OK)
+			continue;
+
+		Directory* root = bootable_volume_on(volume->disk);
+		if (root != NULL && bootVolume.SetTo(root) == B_OK)
+			return B_OK;
+		dprintf("luks: no bootable volume on %s\n", volume->name);
+	}
+	return B_ENTRY_NOT_FOUND;
+}
+
+
+// #pragma mark - boot menu
+
+
+void
+luks_add_menu_items(Menu* menu, bool (*target)(Menu* menu, MenuItem* item))
+{
+	for (LockedVolume* volume = sVolumes; volume != NULL;
+			volume = volume->next) {
+		if (volume->disk != NULL)
+			continue;
+		char label[128];
+		snprintf(label, sizeof(label), "Unlock encrypted volume %s",
+			volume->name);
+		MenuItem* item = new(std::nothrow) MenuItem(label);
+		if (item == NULL)
+			return;
+		item->SetType(MENU_ITEM_NO_CHOICE);
+		item->SetTarget(target);
+		item->SetData(volume);
+		item->SetHelpText("Asks for the passphrase of this LUKS2 volume and "
+			"boots from it.");
+		menu->AddItem(item);
+	}
+}
+
+
+Directory*
+luks_unlock_menu_item(MenuItem* item)
+{
+	LockedVolume* volume = (LockedVolume*)item->Data();
+	dprintf("luks: unlocking %s from the boot menu\n", volume->name);
+	if (unlock_volume(volume) != B_OK)
+		return NULL;
+	item->SetEnabled(false);
+	return bootable_volume_on(volume->disk);
+}
+
+
+// #pragma mark - handing the key to the kernel
+
+
+void
+luks_register_boot_device(Node* device)
+{
+	sBootVolume = NULL;
+	for (LockedVolume* volume = sVolumes; volume != NULL;
+			volume = volume->next) {
+		if (volume->disk != NULL && volume->disk == device) {
+			sBootVolume = volume;
+			return;
+		}
+	}
+}
+
+
+void
+luks_add_boot_volume_key()
+{
+	if (sBootVolume == NULL)
+		return;
+
+	EncryptedDisk* disk = sBootVolume->disk;
+	if (gBootParams.AddString(BOOT_VOLUME_LUKS_UUID, disk->UUID()) != B_OK
+		|| gBootParams.AddData(BOOT_VOLUME_LUKS_KEY, B_RAW_TYPE, disk->Key(),
+			disk->KeySize()) != B_OK) {
+		dprintf("luks: no room for the volume key in the boot volume "
+			"message\n");
+	}
+}
+
+
+void
+luks_cleanup()
+{
+	const void* data;
+	int32 size;
+	for (int32 i = 0; gBootParams.FindData(BOOT_VOLUME_LUKS_KEY, B_RAW_TYPE,
+			i, &data, &size) == B_OK; i++) {
+		luks2_wipe(const_cast<void*>(data), size);
+	}
+
+	for (LockedVolume* volume = sVolumes; volume != NULL;
+			volume = volume->next) {
+		if (volume->disk != NULL)
+			volume->disk->Wipe();
+	}
+}
