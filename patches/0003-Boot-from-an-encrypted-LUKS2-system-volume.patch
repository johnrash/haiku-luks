+/*!	Wipes the volume keys, the ciphers' key schedules and the key in the
+	loader's boot volume message. Called after the message was copied to
+	the kernel args; nothing can be read from encrypted volumes after it. */
+void luks_cleanup();
+
+
+#endif	// LOADER_LUKS_H
