+/*!	The target of those items: asks for the passphrase, and on success
+	returns the root directory of a bootable volume on it (or NULL). */
+Directory* luks_unlock_menu_item(MenuItem* item);
+
+/*!	Remembers the boot device; if it's a volume unlocked here, its UUID and
+	volume key go into the boot volume message (luks_add_boot_volume_key()),
+	so the kernel opens it without asking again. */
+void luks_register_boot_device(Node* device);
+
+/*!	Adds the boot volume's UUID and key to the boot volume message. Called
+	last, right before the message is copied to the kernel args: a field
+	added after it could make the message grow, which would leave a copy of
+	the key behind in the freed buffer. */
+void luks_add_boot_volume_key();
