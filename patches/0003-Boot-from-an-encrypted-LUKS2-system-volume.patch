+
+/*!	Copies the volume keys the boot loader passed for encrypted boot volumes
+	and wipes them in the boot volume message (kernel args memory, which is
+	freed later without being cleared). */
+static void
+take_boot_volume_keys(KMessage& bootVolume)
+{
+	for (int32 i = 0; i < kMaxBootVolumeKeys; i++) {
+		const void* key;
+		int32 keySize;
+		if (bootVolume.FindData(BOOT_VOLUME_LUKS_KEY, B_RAW_TYPE, i, &key,
+				&keySize) != B_OK) {
+			break;
+		}
+
+		const char* uuid;
