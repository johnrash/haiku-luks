+	struct LUKSVisitor : KPartitionVisitor {
+		LUKSVisitor(luks2_boot_module_info* luks)
+			: fLUKS(luks), fOpened(false) {}
+
+		virtual bool VisitPre(KPartition* partition)
+		{
+			if (partition->CountChildren() > 0
+				|| partition->ContainsFileSystem()) {
+				return false;
+			}
+
+			uint8 header[512];
+			if (read_pos(partition->Device()->FD(), partition->Offset(),
+					header, sizeof(header)) != (ssize_t)sizeof(header)) {
+				return false;
+			}
+			static const uint8 kMagic[] = { 'L', 'U', 'K', 'S', 0xba, 0xbe,
+				0, 2 };
+			if (memcmp(header, kMagic, sizeof(kMagic)) != 0)
+				return false;
+			char uuid[40];
+			memcpy(uuid, header + 168, sizeof(uuid));
+			uuid[sizeof(uuid) - 1] = '\0';
