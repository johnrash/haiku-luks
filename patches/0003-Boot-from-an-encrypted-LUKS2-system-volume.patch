index 0000000000..52602aae3f
--- /dev/null
+++ b/src/tests/system/luks2/README.md
@@ -0,0 +1,55 @@
+# LUKS2 tests
+
+The LUKS2 code (`src/libs/luks2`), the `luks_disk` driver, the boot loader's
+unlocking and the `luks` command. The crypto code is unreviewed: keep backups
+of anything on an encrypted volume.
+
+## On the build host (Linux)
+
+`run_tests.sh <cryptsetup> <work dir>` builds the code with the host
+compiler twice (optimised, and with AddressSanitizer and
+UndefinedBehaviorSanitizer) and runs:
+
+- `crypto_test vectors`: FIPS-197 (AES, portable and AES-NI), IEEE 1619
+  (XTS), FIPS 180-4 (SHA-256/512), RFC 7914 (PBKDF2), RFC 7693 (BLAKE2b),
+  RFC 9106 (Argon2d/i/id);
+- `crypto_crosscheck.py`: random XTS, PBKDF2 and Argon2 inputs against
+  OpenSSL (Python's `cryptography`, `hashlib`, `openssl kdf`);
+- `cryptsetup_test.sh`: 40 interoperability tests with Linux's cryptsetup in
+  both directions (both KDFs and their parameters, several keyslots,
+  priorities, killed slots, damaged headers, LUKS1 and interrupted
+  reencryptions refused, data encrypted by cryptsetup decrypted byte for
+  byte, our data decrypted with cryptsetup's volume key and OpenSSL);
+- `crypto_test benchmark`.
+
+cryptsetup works on image files without root; only `--disable-locks` is
+needed. `build_host.sh` alone builds the host `luks`, which also makes
+encrypted images (`luks format`, then `luks write`).
+
+## In QEMU (x86_64, UEFI)
+
+Both need an anyboot image built with these changes, OVMF (`/usr/share/OVMF`), the
+host `luks`, `bfs_shell` from the build directory and cryptsetup. QEMU runs in
+software emulation (`-cpu max` emulates AES-NI).
+
+- `qemu/run-driver-test.sh`: the driver and the tool on NVMe test disks
+  (`qemu/guest-driver-test.sh` runs in Haiku at boot): a volume cryptsetup
+  encrypted, writes onto a cryptsetup volume (checked on the host with
+  cryptsetup's key), a volume formatted on Haiku with BFS inside, reopened,
+  read-only, keyslots added and removed on Haiku and checked by cryptsetup.
+- `qemu/run-boot-test.sh`: an encrypted system volume: a GPT disk with an ESP
+  holding the new `haiku_loader.efi` and a LUKS2 partition holding the
+  system BFS volume. `qemu/boot_console.py` types the passphrase into the
+  boot loader through OVMF's serial console, saves the guest's RAM after
+  boot, and drives the boot menu. Boot 1 with AES-NI, boot 2 with a wrong
+  passphrase first and without AES-NI, boot 3 through the boot menu's
+  "Unlock encrypted volume" item; the RAM after boots 1 and 2 must hold no
+  copy of the volume key; the host reads back what Haiku wrote.
+
+## arm64
+
+`arm64_compile_check.sh <generated.arm64> <out dir>` compiles every LUKS2
+source for arm64 with the cross compiler of an arm64 build directory and
+the flags of each
+context (kernel add-on, kernel, EFI boot loader, userland), `-Werror`,
+without building anything in the arm64 build directory.
diff --git a/src/tests/system/luks2/arm64_compile_check.sh b/src/tests/system/luks2/arm64_compile_check.sh
new file mode 100755
index 0000000000..3cf56869ad
--- /dev/null
+++ b/src/tests/system/luks2/arm64_compile_check.sh
@@ -0,0 +1,125 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Compiles the LUKS2 sources for arm64 with the cross compiler of an arm64
+# build directory, file by file, with the flags of each context (kernel add-on, kernel, EFI
+# boot loader, userland), without building anything in the arm64 build
+# directory (its cross tools and its generated headers are only read).
+# A portability check for the arm64 milestone; nothing is linked.
+#
+# Usage: arm64_compile_check.sh <generated.arm64 dir> <output dir>
+
+G=$(cd "$1" && pwd)
+O=$2
+R=$(cd "$(dirname "$0")/../../../.." && pwd)
+CC=$G/cross-tools-arm64/bin/aarch64-unknown-haiku-gcc
+SYSLIBS=$(ls -d "$G"/build_packages/gcc_syslibs_devel-*-arm64 | head -1)/develop/headers
+mkdir -p "$O"
+
+common="-Wall -Wno-multichar -Wpointer-arith -Wsign-compare -Werror
+	-Wno-error=unused-but-set-variable -Wno-error=cpp
+	-Wno-error=address-of-packed-member -fno-strict-aliasing
+	-fno-delete-null-pointer-checks -nostdinc
+	-march=armv8-a+crc -mfix-cortex-a53-835769 -mfix-cortex-a53-843419
+	-DARCH_arm64 -D__HAIKU_PRIMARY_PACKAGING_ARCH=\"arm64\"
+	-DHAIKU_DISTRO_COMPATIBILITY_DEFAULT -DHAIKU_TARGET_PLATFORM_HAIKU
+	-DHAIKU_REGULAR_BUILD"
+os=""
+for d in "" add-ons add-ons/file_system add-ons/graphics app device drivers \
+		interface kernel storage support; do
+	os="$os -I$R/headers/os/$d"
+done
+headers="-I$R/headers/private -I$R/headers/private/kernel
+	-I$R/headers/private/libroot -I$R/headers/private/shared
+	-I$R/headers/private/kernel/boot/platform/efi
+	-I$R/headers/private/kernel/arch/arm64
+	-I$G/objects/haiku/arm64/common/system/kernel
+	-I$R/headers/private/system -I$R/headers/private/system/arch/arm64
+	-I$SYSLIBS/c++ -I$SYSLIBS/c++/aarch64-unknown-haiku
+	-I$R/headers/glibc -I$R/headers/posix
+	-I$SYSLIBS/gcc/include -I$SYSLIBS/gcc/include-fixed
+	-I$R/headers $os -I$R/build/config_headers"
+kernel="-O2 -ffreestanding -finline -fno-semantic-interposition
+	-fno-tree-vectorize -fno-exceptions -fno-use-cxa-atexit -fpic
+	-D_KERNEL_MODE"
+boot="-Os -ffreestanding -fno-rtti
+	-include $R/headers/private/kernel/util/kernel_cpp.h
+	-fno-tree-vectorize -fno-exceptions -fno-use-cxa-atexit -fpic
+	-fno-stack-protector -fshort-wchar -D_KERNEL_MODE -D_BOOT_MODE
+	-DBOOT_ARCH=\"arm64\" -DKMESSAGE_CONTAINER_ONLY
+	-DBOOT_SUPPORT_PARTITION_INTEL -DBOOT_SUPPORT_PARTITION_EFI
+	-DBOOT_SUPPORT_FILE_SYSTEM_BFS -DBOOT_SUPPORT_FILE_SYSTEM_TARFS
+	-DBOOT_SUPPORT_FILE_SYSTEM_FAT -D_BOOT_PLATFORM_EFI -DBOOT_SUPPORT_LUKS
+	-DBOOT_SUPPORT_ELF64
+	-I$R/src/system/boot/loader -I$R/headers/private/kernel/disk_device_manager
+	-I$R/headers/private/kernel/util -I$R/headers/private/storage
+	-I$R/src/add-ons/kernel/partitioning_systems/gpt
+	-I$R/src/add-ons/kernel/partitioning_systems/intel"
+user="-O2"
+
+L=$R/src/libs/luks2
+library="$L/json.cpp $L/luks2_read.cpp $L/luks2_util.cpp $L/crypto/aes_ct.c
+	$L/crypto/aes_xts.cpp $L/crypto/argon2.cpp $L/crypto/sha2_hmac.cpp"
+
+passed=0
+failed=0
+# flags C doesn't take
+cplusplus="-Wno-ctor-dtor-privacy -Woverloaded-virtual -fno-rtti
+	-fno-use-cxa-atexit -include $R/headers/private/kernel/util/kernel_cpp.h"
+compile() {
+	# compile <context> <flags> <source>
+	out="$O/$1-$(basename "$3").o"
+	flags="$2"
+	case "$3" in
+		*.c)
+			for flag in $cplusplus; do
+				flags=$(echo "$flags" | tr '\t\n' '  ' | sed "s#$flag##g; s#-include ##g")
+			done
+			;;
+		*)
+			flags="$flags -Wno-ctor-dtor-privacy -Woverloaded-virtual"
+			;;
+	esac
+	if $CC -c $common $headers $flags "$3" -o "$out" 2> "$out.log"; then
+		passed=$((passed + 1))
+		echo "ok   $1: ${3#$R/}"
+	else
+		failed=$((failed + 1))
+		echo "FAIL $1: ${3#$R/}"
+		sed 's/^/     /' "$out.log" | head -20
+	fi
+}
+
+for f in $library; do
+	compile kernel "$kernel" "$f"
+	compile boot "$boot" "$f"
+	compile user "$user" "$f"
+done
+compile user "$user" "$L/luks2_write.cpp"
+compile user "$user" "$R/src/bin/luks/luks.cpp"
+compile kernel "$kernel -I$R/src/system/kernel/device_manager" \
+	"$R/src/add-ons/kernel/drivers/disk/virtual/luks_disk/luks_disk.cpp"
+compile kernel "$kernel -I$R/headers/private/luks2
+	-I$R/headers/private/kernel/disk_device_manager
+	-I$R/headers/private/kernel/fs -I$R/headers/private/kernel/util
+	-I$R/headers/private/net -I$R/headers/private/storage
+	-I$R/headers/private/file_systems -I$R/src/system/kernel/device_manager" \
+	"$R/src/system/kernel/fs/vfs_boot.cpp"
+for f in luks.cpp partitions.cpp main.cpp menu.cpp vfs.cpp; do
+	compile boot "$boot" "$R/src/system/boot/loader/$f"
+done
+compile boot "$boot -I$R/headers/private/kernel/platform
+	-I$R/src/system/boot/platform/efi" "$R/src/system/boot/platform/efi/start.cpp"
+
+# no AES accelerator is compiled in on arm64 yet: the portable AES only
+for o in "$O"/*aes_xts.cpp.o; do
+	if "$G"/cross-tools-arm64/bin/aarch64-unknown-haiku-nm "$o" \
+			| grep -q luks2_aes_accel; then
+		echo "FAIL $(basename "$o") refers to an accelerator"
+		failed=$((failed + 1))
+	fi
+done
+
+echo "$passed compiled, $failed failed"
+[ $failed -eq 0 ]
