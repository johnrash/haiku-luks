new file mode 100755
index 0000000000..c29d83e6d3
--- /dev/null
+++ b/src/tests/system/luks2/qemu/boot_console.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Drives a QEMU guest's serial console for run-boot-test.sh: types the
+# passphrase when the boot loader asks for it (optionally a wrong one
+# first), and when the guest says so, pauses the VM and saves its RAM to a
+# file through the QEMU monitor. Logs everything it reads.
+#
+# Usage: boot_console.py <serial socket> <monitor socket> <log>
+#            <passphrase file> [--wrong-first | --menu]
+#            [--dump <file> <bytes>] [--timeout <seconds>]
+# --menu: Esc at the passphrase prompt, then unlock through the boot menu
+# ("Select boot volume/state", "Unlock encrypted volume ...", the
+# passphrase, "Continue booting").
+
+import os
+import socket
+import sys
+import time
+
+serial_path, monitor_path, log_path, passphrase_path = sys.argv[1:5]
+options = sys.argv[5:]
+wrong_first = "--wrong-first" in options
+menu_steps = None
+if "--menu" in options:
+    # (text to wait for, bytes to send), in order
+    menu_steps = [(b"Passphrase (Esc", b"\x1b"),
+                  (b"Select boot volume/state", b"\r"),
+                  (b"Unlock encrypted volume", b"\r"),
+                  (b"Passphrase (Esc", None),
+                  (b"Continue booting", b"\r")]
+dump = None
+if "--dump" in options:
+    i = options.index("--dump")
+    dump = (options[i + 1], int(options[i + 2], 0))
+timeout = 3600
+if "--timeout" in options:
+    timeout = int(options[options.index("--timeout") + 1])
+
+with open(passphrase_path, "rb") as f:
+    passphrase = f.read()
+
+
+def connect(path):
+    deadline = time.time() + 30
+    while True:
+        try:
+            s = socket.socket(socket.AF_UNIX)
+            s.connect(path)
+            return s
+        except OSError:
+            if time.time() > deadline:
+                raise
+            time.sleep(0.2)
+
+
+def monitor(command):
+    s = connect(monitor_path)
+    s.settimeout(120)
+    s.sendall((command + "\n").encode())
+    data = b""
+    # the reply ends with the next prompt
+    while data.count(b"(qemu)") < 2:
+        chunk = s.recv(65536)
+        if not chunk:
+            break
+        data += chunk
+    s.close()
+    return data.decode("utf-8", "replace")
+
+
+def type_text(s, text):
+    for byte in text:
+        s.sendall(bytes([byte]))
+        time.sleep(0.03)
+
+
+serial = connect(serial_path)
+serial.settimeout(1.0)
+log = open(log_path, "wb")
+seen = b""
+scan_from = 0
+prompts = 0
+sent_wrong = False
+dumped = False
+start = time.time()
+
+while time.time() - start < timeout:
+    try:
+        chunk = serial.recv(65536)
+        if not chunk:
+            break
+    except socket.timeout:
+        chunk = b""
+    if chunk:
+        log.write(chunk)
+        log.flush()
+        seen += chunk
+
+    if menu_steps:
+        text, send = menu_steps[0]
+        found = seen.find(text, scan_from)
+        if found >= 0:
+            scan_from = found + len(text)
+            menu_steps.pop(0)
+            time.sleep(1.5)
+            if send is None:
+                send = passphrase + b"\r"
+                prompts += 1
+            print("console: menu step: found %r, typing %s" % (text,
+                  "the passphrase" if send.startswith(passphrase) else
+                  repr(send)), flush=True)
+            type_text(serial, send)
+        found = -1
+    else:
+        found = seen.find(b"Passphrase (Esc", scan_from)
+    if found >= 0:
+        scan_from = found + 1
+        prompts += 1
+        time.sleep(0.5)
+        if wrong_first and not sent_wrong:
+            print("console: typing a wrong passphrase", flush=True)
+            type_text(serial, b"not the right one\r")
+            sent_wrong = True
+        else:
+            print("console: typing the passphrase (prompt %d)" % prompts,
+                  flush=True)
+            type_text(serial, passphrase + b"\r")
+
+    if dump is not None and not dumped \
+            and b"LUKSTEST memory-dump-now" in seen:
+        dumped = True
+        print("console: saving the guest's RAM", flush=True)
+        for command in ("stop", "pmemsave 0 %d %s" % (dump[1], dump[0]),
+                "cont"):
+            reply = monitor(command)
+            print("console: monitor %s: %s" % (command.split()[0],
+                  " ".join(reply.split()[-12:])), flush=True)
+        print("console: RAM saved", flush=True)
+
+    # keep the search window small
+    if len(seen) > 1 << 20:
+        cut = len(seen) - 65536
+        seen = seen[cut:]
+        scan_from = max(0, scan_from - cut)
+
+log.close()
+print("console: done after %d s, %d passphrase prompt(s)"
+      % (time.time() - start, prompts), flush=True)
diff --git a/src/tests/system/luks2/qemu/guest-boot-test.sh b/src/tests/system/luks2/qemu/guest-boot-test.sh
new file mode 100755
index 0000000000..7d66bb1fd2
--- /dev/null
+++ b/src/tests/system/luks2/qemu/guest-boot-test.sh
@@ -0,0 +1,80 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# The guest half of run-boot-test.sh: runs at boot from the encrypted system
+# volume (a launch job), checks that /boot is the decrypted device the
+# kernel opened with the boot loader's key, writes a marker for the next
+# boot, lets the host save the RAM, and powers off.
+
+T=/boot/system/settings/luks-test
+passed=0
+failed=0
+
+log() { echo "LUKSTEST $*" > /dev/dprintf; }
+ok() { passed=$((passed + 1)); log "ok   $*"; }
+bad() { failed=$((failed + 1)); log "FAIL $*"; }
+run() {
+	out=$("$@" 2>&1)
+	status=$?
+	echo "$out" | while read -r line; do log "   | $line"; done
+	return $status
+}
+
+log "start: $(uname -srvm)"
+sleep 5
+
+boots=$(cat /boot/home/luks-boot-count 2>/dev/null || echo 0)
+boots=$((boots + 1))
+log "boot number $boots of this encrypted volume"
+
+run df /boot
+device=$(df /boot | sed -n 's/^ *Device: *//p')
+case "$device" in
+	/dev/disk/virtual/luks/*)
+		ok "/boot is on the decrypted device $device"
+		;;
+	*)
+		bad "/boot is on $device"
+		;;
+esac
+run luks list
+luks list | grep -q "UUID $(cat $T/uuid)" && ok "luks list shows the boot volume" \
+	|| bad "luks list"
+
+# the kernel opened it with the loader's key: no prompt, no KDF in the kernel
+if grep -q "vfs_boot: encrypted boot volume .* opened as" /var/log/syslog; then
+	ok "the kernel opened the volume with the boot loader's key"
+else
+	bad "no vfs_boot line in the syslog"
+fi
+grep -E "vfs_boot|luks" /var/log/syslog | head -20 \
+	| while read -r line; do log "   | $line"; done
+
+# this volume is in use: closing it must be refused
+if luks close "$device" > /dev/null 2>&1; then
+	bad "the boot volume could be closed"
+else
+	ok "closing the boot volume is refused"
+fi
+
+# writing to the encrypted system volume
+if [ $boots -gt 1 ]; then
+	if [ "$(cat /boot/home/luks-boot-marker)" = "written at boot $((boots - 1))" ]; then
+		ok "the marker written at the previous boot is there"
+	else
+		bad "marker: $(cat /boot/home/luks-boot-marker 2>&1)"
+	fi
+fi
+echo "written at boot $boots" > /boot/home/luks-boot-marker
+echo $boots > /boot/home/luks-boot-count
+head -c $((16 * 1024 * 1024)) /dev/urandom > /boot/home/luks-random.bin
+sha256sum /boot/home/luks-random.bin | cut -d' ' -f1 > /boot/home/luks-random.sha256
+sync
+ok "16 MiB written to /boot/home"
+
+log "done: $passed passed, $failed failed"
+log "memory-dump-now"
+sleep 20
+sync
+shutdown -q
diff --git a/src/tests/system/luks2/qemu/run-boot-test.sh b/src/tests/system/luks2/qemu/run-boot-test.sh
new file mode 100755
index 0000000000..a961daf1ce
--- /dev/null
+++ b/src/tests/system/luks2/qemu/run-boot-test.sh
@@ -0,0 +1,216 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Boots an encrypted Haiku system volume in QEMU (x86_64, UEFI/OVMF, NVMe):
+# a GPT disk with an EFI system partition holding the new boot loader and a
+# LUKS2 partition holding the system BFS volume (taken from an anyboot
+# image). The boot loader must ask for the passphrase, boot from the
+# decrypted volume and hand the key to the kernel, which mounts the same
+# volume without asking again.
+#  - boot 1: the right passphrase, AES-NI; the guest's RAM is saved after
+#    boot and searched for leftover copies of the volume key and the
+#    passphrase;
+#  - boot 2: a wrong passphrase first, then the right one, without AES-NI
+#    (the portable AES in the loader and the kernel); the file written at
+#    boot 1 must be there; RAM searched again;
+#  - boot 3: Esc at the prompt, then "Unlock encrypted volume" in the boot
+#    menu, and "Continue booting";
+#  - boot 4: with the passphrase of a keyslot cryptsetup added (argon2id,
+#    512 MiB, 4 lanes: four 128 MiB allocations in the boot loader).
+# Then the build host decrypts the volume and checks what Haiku wrote.
+#
+# Usage: run-boot-test.sh <anyboot image> <haiku_loader.efi> <work dir>
+#            <host luks> <bfs_shell> <cryptsetup> [timeout seconds]
+
+set -e
+IMAGE=$1
+LOADER=$2
+W=$3
+LUKS=$4
+BFS=$5
+CS=$6
+TIMEOUT=${7:-3600}
+HERE=$(cd "$(dirname "$0")" && pwd)
+mkdir -p "$W"
+cd "$W"
+
+passed=0
+failed=0
+ok() { passed=$((passed + 1)); echo "ok   $*"; }
+bad() { failed=$((failed + 1)); echo "FAIL $*"; }
+
+echo "== the system volume"
+offset=$(sfdisk -d "$IMAGE" | sed -n 's/.*1 : start= *\([0-9]*\),.*/\1/p')
+size=$(sfdisk -d "$IMAGE" | sed -n 's/.*1 : start= *[0-9]*, size= *\([0-9]*\),.*/\1/p')
+dd if="$IMAGE" of=system.bfs bs=512 skip=$offset count=$size 2>/dev/null
+cat > luks-test.job <<'JOB'
+job x-vnd.luks-test {
+	launch /bin/sh /boot/system/settings/luks-test/test.sh
+}
+JOB
+cp "$HERE/guest-boot-test.sh" test.sh
+printf 'correct horse battery staple, encrypted Haiku' > key
+
+echo "== the LUKS2 partition"
+luksSize=$((size * 512 + 16 * 1024 * 1024))
+rm -f luks.img
+truncate -s $luksSize luks.img
+"$LUKS" format -y -k key -L Haiku --pbkdf argon2id --memory 65536 --time 4 \
+	--parallel 4 --digest-iterations 20000 luks.img
+uuid=$("$LUKS" dump luks.img | sed -n 's/^  UUID: *//p')
+echo "$uuid" > uuid
+printf '%s\n' \
+	"mkdir -p /myfs/system/settings/luks-test" \
+	"mkdir -p /myfs/system/settings/launch" \
+	"cp :$W/test.sh /myfs/system/settings/luks-test/test.sh" \
+	"cp :$W/uuid /myfs/system/settings/luks-test/uuid" \
+	"cp :$W/luks-test.job /myfs/system/settings/launch/luks-test" \
+	"sync" "quit" | "$BFS" system.bfs > bfs_shell.log 2>&1
+"$LUKS" write -k key luks.img system.bfs
+"$LUKS" dump luks.img
+
+echo "== the disk: GPT, EFI system partition, LUKS2 partition"
+rm -f disk.img esp.img
+espSectors=$((64 * 2048))
+luksSectors=$((luksSize / 512))
+truncate -s $(( (2048 + espSectors + luksSectors + 2048) * 512 )) disk.img
+sgdisk -n 1:2048:+$espSectors -t 1:ef00 -c 1:"EFI system" \
+	-n 2:$((2048 + espSectors)):+$luksSectors -t 2:8309 \
+	-c 2:"Haiku (encrypted)" disk.img > /dev/null
+truncate -s $((espSectors * 512)) esp.img
+mformat -i esp.img -F -v EFI ::
+mmd -i esp.img ::/EFI ::/EFI/BOOT
+mcopy -i esp.img "$LOADER" ::/EFI/BOOT/BOOTX64.EFI
+dd if=esp.img of=disk.img bs=512 seek=2048 conv=notrunc 2>/dev/null
+dd if=luks.img of=disk.img bs=1M seek=$(( (2048 + espSectors) * 512 / 1048576 )) \
+	conv=notrunc 2>/dev/null
+sgdisk -p disk.img
+
+volumeKey=$("$CS" luksDump -q --disable-locks --dump-volume-key --key-file key \
+	luks.img | sed -n '/MK dump/,$p' | sed 's/MK dump://' | tr -d ' \t\n')
+
+boot() {
+	# boot <name> <cpu> <console options...>
+	name=$1
+	cpu=$2
+	shift 2
+	cp /usr/share/OVMF/OVMF_VARS_4M.fd vars-$name.fd
+	rm -f serial-$name.sock monitor-$name.sock
+	start=$(date +%s)
+	timeout "$TIMEOUT" qemu-system-x86_64 -M q35 -cpu "$cpu" -smp 4 -m 2048 \
+		-accel tcg,thread=multi \
+		-drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd \
+		-drive if=pflash,format=raw,file=vars-$name.fd \
+		-drive if=none,id=disk,file=disk.img,format=raw \
+		-device nvme,drive=disk,serial=encrypted \
+		-nic none -display none -no-reboot \
+		-chardev socket,id=ser0,path=serial-$name.sock,server=on,wait=on \
+		-serial chardev:ser0 \
+		-monitor unix:monitor-$name.sock,server,nowait \
+		> qemu-$name.log 2>&1 &
+	qemu=$!
+	python3 -I "$HERE/boot_console.py" serial-$name.sock monitor-$name.sock \
+		serial-$name.log "$KEYFILE" "$@" --timeout "$TIMEOUT" || true
+	wait $qemu || echo "QEMU exited with $?"
+	echo "boot $name took $(( $(date +%s) - start )) s"
+	grep -a "LUKSTEST" serial-$name.log | sed 's/^.*LUKSTEST /guest: /'
+	grep -a -E "luks: |vfs_boot: |PANIC|panic\(" serial-$name.log | head -20
+	if grep -a -q "LUKSTEST done: [0-9]* passed, 0 failed" serial-$name.log; then
+		ok "boot $name: the guest's checks passed"
+	else
+		bad "boot $name: the guest's checks"
+	fi
+}
+
+KEYFILE=key
+echo "== boot 1: the passphrase, AES-NI, then the RAM is searched"
+rm -f memory.bin
+boot first max --dump memory.bin 0x80000000
+grep -a -c "Passphrase (Esc" serial-first.log > prompts-first || true
+[ "$(cat prompts-first)" -ge 1 ] && ok "the boot loader asked for the passphrase" \
+	|| bad "no passphrase prompt"
+search_memory() {
+	# search_memory <name>: no copy of the whole volume key may be left
+	if [ -s memory.bin ]; then
+		if python3 -I search.py memory.bin "$volumeKey" key; then
+			ok "boot $1: no copy of the whole volume key in the guest's RAM"
+		else
+			bad "boot $1: the volume key is still in the guest's RAM"
+		fi
+		rm -f memory.bin
+	else
+		bad "boot $1: no RAM dump"
+	fi
+}
+cat > search.py <<'PY'
+import mmap, sys
+with open(sys.argv[1], "rb") as f:
+    memory = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
+key = bytes.fromhex(sys.argv[2])
+passphrase = open(sys.argv[3], "rb").read()
+def count(needle):
+    n, i = 0, memory.find(needle)
+    while i >= 0:
+        n += 1
+        i = memory.find(needle, i + 1)
+    return n
+print("RAM: whole volume key %d, data key half %d, tweak key half %d, "
+      "passphrase %d" % (count(key), count(key[:32]), count(key[32:]),
+      count(passphrase)))
+sys.exit(1 if count(key) else 0)
+PY
+search_memory first
+
+echo "== boot 2: a wrong passphrase first, portable AES"
+boot second max,-aes --wrong-first --dump memory.bin 0x80000000
+search_memory second
+grep -a -q "doesn't open this volume" serial-second.log \
+	&& ok "the wrong passphrase was refused, and asked again" \
+	|| bad "no retry after the wrong passphrase"
+grep -a -q "portable constant-time" serial-second.log \
+	&& ok "without AES-NI, the portable AES was used" \
+	|| bad "the portable AES wasn't used"
+
+echo "== boot 3: Esc at the prompt, unlocked through the boot menu"
+boot third max --menu
+grep -a -q "Unlock encrypted volume" serial-third.log \
+	&& ok "the boot menu offered to unlock the volume" \
+	|| bad "no unlock item in the boot menu"
+
+echo "== boot 4: a keyslot cryptsetup added, argon2id with 512 MiB"
+luksStart=$(( (2048 + espSectors) * 512 / 1048576 ))
+dd if=disk.img of=luks-cs.img bs=1M skip=$luksStart count=$((luksSize / 1048576)) \
+	2>/dev/null
+printf "cryptsetup's keyslot, 512 MiB of Argon2" > key-cs
+"$CS" luksAddKey -q --disable-locks --key-file key --new-key-slot 5 \
+	--pbkdf argon2id --pbkdf-memory 524288 --pbkdf-parallel 4 \
+	--pbkdf-force-iterations 4 luks-cs.img key-cs
+dd if=luks-cs.img of=disk.img bs=1M seek=$luksStart count=16 conv=notrunc \
+	2>/dev/null
+rm -f luks-cs.img
+KEYFILE=key-cs
+boot fourth max
+grep -a -q 'opened with keyslot 5' serial-fourth.log \
+	&& ok "the boot loader opened cryptsetup's 512 MiB argon2id keyslot" \
+	|| bad "keyslot 5"
+
+echo "== what Haiku wrote, read back on the build host"
+dd if=disk.img of=luks-back.img bs=1M skip=$(( (2048 + espSectors) * 512 / 1048576 )) \
+	count=$((luksSize / 1048576)) 2>/dev/null
+rm -f system-back.bfs
+"$LUKS" read -k key luks-back.img system-back.bfs
+printf '%s\n' "cp /myfs/home/luks-random.bin :$W/random-back.bin" \
+	"cp /myfs/home/luks-random.sha256 :$W/random-back.sha256" \
+	"cp /myfs/home/luks-boot-marker :$W/marker-back" "quit" \
+	| "$BFS" system-back.bfs > bfs_shell-back.log 2>&1 || true
+if [ "$(sha256sum random-back.bin | cut -d' ' -f1)" = "$(cat random-back.sha256)" ]; then
+	ok "the 16 MiB file written at boot 4 reads back identical"
+else
+	bad "luks-random.bin"
+fi
+[ "$(cat marker-back)" = "written at boot 4" ] && ok "marker of boot 4" \
+	|| bad "marker: $(cat marker-back)"
+
+echo "$passed passed, $failed failed"
+[ $failed -eq 0 ]
