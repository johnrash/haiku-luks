 {
 	KMessage bootVolume;
 	bootVolume.SetTo(args->boot_volume, args->boot_volume_size);
+	take_boot_volume_keys(bootVolume);
 
 	PartitionStack partitions;
 	status_t status = get_boot_partitions(bootVolume, partitions);
@@ -510,6 +662,9 @@ vfs_mount_boot_file_system(kernel_args* args)
 		}
 	}
 
+	// the encrypted boot volume is open: the keys aren't needed any more
+	wipe_boot_volume_keys();
+
 	if (bootDevice < B_OK)
 		panic("could not mount boot device!\n");
 
