+			&& keySize > 0 && keySize <= (int32)sizeof(BootVolumeKey::key)) {
+			BootVolumeKey& entry = sBootVolumeKeys[sBootVolumeKeyCount++];
+			strlcpy(entry.uuid, uuid, sizeof(entry.uuid));
+			memcpy(entry.key, key, keySize);
+			entry.keySize = keySize;
+			entry.opened = false;
+		}
+
+		volatile uint8* bytes = (volatile uint8*)key;
+		for (int32 j = 0; j < keySize; j++)
+			bytes[j] = 0;
+	}
