+bool luks_probe_partition(boot::Partition* partition);
+
+bool luks_has_locked_volumes();
+
+/*!	Asks for the passphrase of each locked volume until one holds a bootable
+	system, which \a bootVolume is set to. Esc skips to the boot menu
+	(returns an error). */
+status_t luks_unlock_boot_volume(BootVolume& bootVolume);
