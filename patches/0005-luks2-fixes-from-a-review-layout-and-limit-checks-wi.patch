diff --git a/src/tests/system/luks2/craft_header.py b/src/tests/system/luks2/craft_header.py
new file mode 100755
index 0000000000..00aa60f056
--- /dev/null
+++ b/src/tests/system/luks2/craft_header.py
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Makes a damaged or hostile LUKS2 header for the negative tests: rewrites
+# the JSON metadata of an image (both header copies) and fixes the
+# checksums, so only the metadata is wrong.
+# Usage: craft_header.py <in image> <out image> <case>
+
+import hashlib
+import json
+import struct
+import sys
+
+source, target, case = sys.argv[1:4]
+image = bytearray(open(source, "rb").read())
+header_size = struct.unpack(">Q", image[8:16])[0]
+text = image[4096:header_size].split(b"\0", 1)[0].decode()
+j = json.loads(text)
+raw = None
+secondary_size = header_size
+slot = j["keyslots"]["0"]
+area = slot["area"]
+
+if case == "area-overlaps-data":
+    # keyslots area reaching into the data segment
+    j["config"]["keyslots_size"] = str(int(j["segments"]["0"]["offset"]))
+elif case == "areas-overlap":
+    other = json.loads(json.dumps(slot))
+    other["area"]["offset"] = str(int(area["offset"]) + 4096)
+    j["keyslots"]["1"] = other
+    j["digests"]["0"]["keyslots"].append("1")
+elif case == "huge-keyslots-size":
+    j["config"]["keyslots_size"] = str(1 << 40)
+elif case == "short-digest":
+    j["digests"]["0"]["digest"] = "AA=="
+elif case == "duplicate-key":
+    segment = j["segments"]["0"]
+    raw = json.dumps(j, separators=(",", ":"))
+    raw = raw.replace('"offset":"%s"' % segment["offset"],
+        '"offset":"%s","offset":"%d"' % (segment["offset"],
+            int(segment["offset"]) * 2), 1)
+elif case == "secondary-size":
+    secondary_size = header_size * 2
+elif case == "argon2-lanes":
+    slot["kdf"] = {"type": "argon2id", "time": 4, "memory": 1 << 30,
+        "cpus": (1 << 24) - 1, "salt": slot["kdf"]["salt"]}
+elif case == "stripes":
+    slot["af"]["stripes"] = 4000000000
+else:
+    sys.exit("unknown case " + case)
+
+data = (raw if raw is not None else json.dumps(j, separators=(",", ":"))) \
+    .encode()
+assert len(data) < header_size - 4096
+
+
+def write_copy(offset, size_field):
+    copy = image[offset:offset + header_size]
+    copy[8:16] = struct.pack(">Q", size_field)
+    copy[4096:header_size] = data + b"\0" * (header_size - 4096 - len(data))
+    copy[448:512] = b"\0" * 64
+    copy[448:480] = hashlib.sha256(bytes(copy)).digest()
+    image[offset:offset + header_size] = copy
+
+
+write_copy(0, header_size)
+write_copy(header_size, secondary_size)
+open(target, "wb").write(image)
