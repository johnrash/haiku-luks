+echo "== hostile headers (checksums right, metadata wrong)"
+
+image cs-base.img 40M
+cs luksFormat --type luks2 --key-file k0 --pbkdf pbkdf2 \
+	--pbkdf-force-iterations 1000 cs-base.img
+for case in area-overlaps-data areas-overlap huge-keyslots-size short-digest \
+		duplicate-key; do
+	python3 -I "$HERE/craft_header.py" cs-base.img hostile.img $case
+	expect_refused "$case" hostile.img k0 "damaged"
+done
+python3 -I "$HERE/craft_header.py" cs-base.img hostile.img secondary-size
+if "$LUKS" dump hostile.img | grep -q "primary ok, SECONDARY DAMAGED"; then
+	ok "a secondary header whose size isn't its offset is ignored"
+else
+	bad "secondary-size"
+fi
+for case in argon2-lanes stripes; do
+	python3 -I "$HERE/craft_header.py" cs-base.img hostile.img $case
+	out=$(timeout 20 "$LUKS" test -k k0 hostile.img 2>&1)
+	if [ $? -eq 2 ] && "$LUKS" dump hostile.img | grep -q "not supported"; then
+		ok "$case: keyslot not supported, nothing allocated"
+	else
+		bad "$case: $out"
+	fi
+done
+
 echo "== data encrypted by cryptsetup, decrypted by luks"
 
