+/*!	Fills \a volume from one header copy and parses its metadata. */
+static int
+volume_from_copy(const luks2_device_io* io, const HeaderCopy& copy,
+	luks2_volume* volume)
+{
+	const uint8_t* data = copy.data;
+	copy_header_string(volume->uuid, data + LUKS2_OFFSET_UUID,
+		LUKS2_UUID_SIZE);
+	copy_header_string(volume->label, data + LUKS2_OFFSET_LABEL,
+		LUKS2_LABEL_SIZE);
+	copy_header_string(volume->subsystem, data + LUKS2_OFFSET_SUBSYSTEM,
+		LUKS2_LABEL_SIZE);
+	volume->header_size = copy.size;
+	volume->sequence_id = copy.sequenceID;
+	volume->header_hash = copy.hash;
+
+	// the JSON text ends at the first NUL of the JSON area
+	const char* json = (const char*)data + LUKS2_BINARY_HEADER_SIZE;
+	size_t jsonAreaSize = copy.size - LUKS2_BINARY_HEADER_SIZE;
+	size_t jsonLength = strnlen(json, jsonAreaSize);
+	if (jsonLength == jsonAreaSize)
+		return LUKS2_ERROR_CORRUPT;
+	volume->json = luks2_json_parse(json, jsonLength);
+	if (volume->json == NULL)
+		return LUKS2_ERROR_CORRUPT;
+	return luks2_parse_metadata(volume, io->size);
+}
