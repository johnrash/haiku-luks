diff --git a/src/apps/encryptedvolume/EncryptedVolume.cpp b/src/apps/encryptedvolume/EncryptedVolume.cpp
index e14840752b..16d27a82e3 100644
--- a/src/apps/encryptedvolume/EncryptedVolume.cpp
+++ b/src/apps/encryptedvolume/EncryptedVolume.cpp
@@ -382,6 +382,46 @@ unlock(Job& job, BMessage& result)
 }
 
 
+/*!	Gives the partition at \a path the "Linux LUKS" type, when its
+	partitioning system has one (GPT, MBR): other systems then see what it
+	is, and boot loaders don't take it for a file system of the type it had
+	("Be File System" is DriveSetup's default). Nothing else depends on it,
+	so a failure is only logged. */
+static void
+set_luks_partition_type(const char* path)
+{
+	BDiskDevice disk;
+	BPartition* partition;
+	status_t status = find_partition(path, &disk, &partition);
+	if (status != B_OK || partition->IsDevice())
+		return;
+	if (partition->Type() != NULL
+		&& strcmp(partition->Type(), LUKS2_PARTITION_TYPE) == 0)
+		return;
+	// (CanSetType() and ValidateSetType() need prepared modifications)
+	status = disk.PrepareModifications();
+	if (status != B_OK) {
+		fprintf(stderr, "EncryptedVolume: %s keeps its partition type: %s\n",
+			path, strerror(status));
+		return;
+	}
+	if (!partition->CanSetType())
+		status = B_NOT_SUPPORTED;
+	else
+		status = partition->ValidateSetType(LUKS2_PARTITION_TYPE);
+	if (status == B_OK)
+		status = partition->SetType(LUKS2_PARTITION_TYPE);
+	if (status == B_OK)
+		status = disk.CommitModifications();
+	else
+		disk.CancelModifications();
+	if (status != B_OK) {
+		fprintf(stderr, "EncryptedVolume: %s keeps its partition type: %s\n",
+			path, strerror(status));
+	}
+}
+
+
 static status_t
 encrypt(Job& job, BMessage& result)
 {
@@ -427,6 +467,8 @@ encrypt(Job& job, BMessage& result)
 		return B_ERROR;
 	}
 
+	set_luks_partition_type(job.path.String());
+
 	char device[B_PATH_NAME_LENGTH];
 	status_t status = luks2_open_device(job.path.String(), key, keySize, false,
 		device, sizeof(device), NULL);
