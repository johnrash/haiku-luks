@@ -0,0 +1,73 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+#
+# Destructive-command guards, on disposable host image files only.
+# Usage: safety_test.sh <cryptsetup> <luks> <work directory>
+set -eu
+CS=$1
+LUKS=$2
+mkdir -p "$3"
+W=$(mktemp -d "$3/safety.XXXXXX")
+cd "$W"
+printf 'first review passphrase' > k0
+printf 'second review passphrase' > k1
+passed=0
+ok() { passed=$((passed + 1)); echo "ok   $*"; }
+fail() { echo "FAIL $*"; exit 1; }
+cs() { "$CS" -q --disable-locks "$@"; }
+format() {
+	truncate -s 32M "$1"
+	"$LUKS" format -y -k k0 --pbkdf pbkdf2 --iterations 1000 "$1" > /dev/null
+}
+refuse_unchanged() {
+	image=$1
+	shift
+	before=$(sha256sum < "$image")
+	if "$@" > command.log 2>&1; then
+		cat command.log
+		fail "unexpected success: $*"
+	fi
+	[ "$(sha256sum < "$image")" = "$before" ] || fail "changed $image: $*"
+}
+
+format unsupported.img
+cs luksAddKey --key-file k0 --pbkdf pbkdf2 --hash sha1 \
+	--pbkdf-force-iterations 1000 unsupported.img k1
+refuse_unchanged unsupported.img "$LUKS" removekey -k k0 unsupported.img 0
+"$LUKS" test -k k0 unsupported.img > /dev/null
+ok "an unsupported remaining slot cannot replace the last usable slot"
+"$LUKS" removekey --force -k k0 unsupported.img 0 > /dev/null
+cs open --test-passphrase --key-file k1 unsupported.img
+ok "force still permits deliberate removal; cryptsetup opens the remaining slot"
+
+format ignored.img
+cs luksAddKey --key-file k0 --pbkdf pbkdf2 --hash sha256 \
+	--pbkdf-force-iterations 1000 ignored.img k1
+cs config --priority ignore --key-slot 1 ignored.img
+refuse_unchanged ignored.img "$LUKS" removekey -k k0 ignored.img 0
+"$LUKS" test -k k0 ignored.img > /dev/null
+ok "an ignored remaining slot cannot replace the last automatically tried slot"
+cs config --priority normal --key-slot 1 ignored.img
+"$LUKS" removekey -k k0 ignored.img 0 > /dev/null
+"$LUKS" test -k k1 ignored.img > /dev/null
+ok "removing a slot with a usable replacement still works"
+
+format source.img
+ln source.img hardlink.img
+ln -s source.img symlink.img
+for output in source.img hardlink.img symlink.img; do
+	refuse_unchanged source.img "$LUKS" read -k k0 source.img "$output"
+	"$LUKS" test -k k0 source.img > /dev/null
+	ok "read refuses $output without truncating the encrypted source"
+done
+
+dd if=/dev/urandom of=pattern.bin bs=512 count=1 2>/dev/null
+"$LUKS" write -k k0 source.img pattern.bin
+truncate -s 40M output.bin
+"$LUKS" read -k k0 source.img output.bin
+[ "$(wc -c < output.bin)" -eq 16777216 ] || fail "output wasn't truncated"
+head -c 512 output.bin > first-sector.bin
+cmp pattern.bin first-sector.bin || fail "decrypted output differs"
+ok "read still replaces an unrelated output file and decrypts correctly"
+echo "$passed passed, 0 failed"
