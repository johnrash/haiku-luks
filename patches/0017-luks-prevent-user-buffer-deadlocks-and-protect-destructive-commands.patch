+#!/usr/bin/env python3
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+"""Run the driver page-fault regression in an isolated, disposable VM."""
+
+import argparse
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("image", type=Path)
+    parser.add_argument("work", type=Path, help="a new work directory")
+    parser.add_argument("bfs_shell", type=Path)
+    parser.add_argument("helper", type=Path, help="Haiku luks2_driver_memory_test")
+    parser.add_argument("--timeout", type=int, default=180)
+    args = parser.parse_args()
+    image = args.image.resolve(strict=True)
+    bfs = args.bfs_shell.resolve(strict=True)
+    helper = args.helper.resolve(strict=True)
+    work = args.work.resolve()
+    # Refuse reuse: never truncate an existing user's disk image.
+    work.mkdir(parents=True, exist_ok=False)
+    here = Path(__file__).resolve().parent
+    shutil.copyfile(image, work / "boot.img")
+    with (work / "data.img").open("xb") as disk:
+        disk.truncate(128 * 1024 * 1024)
+        disk.write(b"LUKSMEM-BLANK\n")
+    (work / "key").write_text("disposable memory test passphrase")
+    (work / "test.job").write_text(
+        "job x-vnd.luks-memory-test {\n"
+        " launch /bin/sh /boot/system/settings/luks-memory-test/test.sh\n}\n")
+    with image.open("rb") as source:
+        mbr = source.read(512)
+    entries = [mbr[446 + 16 * i:462 + 16 * i] for i in range(4)]
+    offsets = [struct.unpack_from("<I", e, 8)[0] * 512
+               for e in entries if e[4] == 0xeb]
+    if mbr[510:] != b"\x55\xaa" or not offsets:
+        raise RuntimeError("image has no BFS MBR partition")
+    guest = "/myfs/system/settings/luks-memory-test"
+    commands = [f"mkdir -p {guest}", "mkdir -p /myfs/system/settings/launch"]
+    for source, destination in [
+        (here / "guest-memory-test.sh", guest + "/test.sh"),
+        (helper, guest + "/driver_memory_test"),
+        (work / "key", guest + "/key"),
+        (work / "test.job", "/myfs/system/settings/launch/luks-memory-test"),
+    ]:
+        # bfs_shell's command language accepts quoted paths.
+        if any(c in str(source) for c in '\n\r"\\'):
+            raise ValueError("unsupported character in fixture path")
+        commands.append(f'cp ":{source}" "{destination}"')
+    commands += ["sync", "quit"]
+    prepared = subprocess.run(
+        [str(bfs), "--start-offset", str(offsets[0]), str(work / "boot.img")],
+        input="\n".join(commands) + "\n", text=True,
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    (work / "bfs_shell.log").write_text(prepared.stdout)
+    if prepared.returncode or "Error" in prepared.stdout:
+        raise RuntimeError(f"fixture preparation failed; see {work}/bfs_shell.log")
+    shutil.copyfile("/usr/share/OVMF/OVMF_VARS_4M.fd", work / "vars.fd")
+    command = [
+        "qemu-system-x86_64", "-M", "q35", "-cpu", "max", "-smp", "4",
+        "-m", "2048", "-accel", "tcg,thread=multi",
+        "-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd",
+        "-drive", "if=pflash,format=raw,file=vars.fd",
+        "-drive", "if=none,id=boot,format=raw,file=boot.img",
+        "-device", "nvme,drive=boot,serial=boot",
+        "-drive", "if=none,id=data,format=raw,file=data.img",
+        "-device", "nvme,drive=data,serial=memory-test",
+        # Avoid the stock module-unload deadlock triggered with no NIC.
+        "-netdev", "user,id=net0,restrict=on", "-device", "e1000,netdev=net0",
+        "-display", "none", "-serial", "file:serial.log", "-no-reboot",
+    ]
+    passed = False
+    with (work / "qemu.log").open("w") as log:
+        vm = subprocess.Popen(command, cwd=work, stdout=log, stderr=log)
+        try:
+            deadline = time.monotonic() + args.timeout
+            while time.monotonic() < deadline:
+                serial = work / "serial.log"
+                output = serial.read_text(errors="replace") if serial.exists() else ""
+                if "LUKSMEM PASS" in output:
+                    passed = True
+                    break
+                if "LUKSMEM FAIL" in output or vm.poll() is not None:
+                    break
+                time.sleep(1)
+        finally:
+            if vm.poll() is None:
+                vm.terminate()
+                try:
+                    vm.wait(timeout=10)
+                except subprocess.TimeoutExpired:
+                    vm.kill()
+                    vm.wait()
+    print(f"{'ok' if passed else 'FAIL'} driver memory test; logs: {work}")
+    return 0 if passed else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
