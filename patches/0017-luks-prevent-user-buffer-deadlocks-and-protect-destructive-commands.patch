diff --git a/src/tests/system/luks2/driver_memory_test.c b/src/tests/system/luks2/driver_memory_test.c
new file mode 100644
index 0000000..fde5d3a
--- /dev/null
+++ b/src/tests/system/luks2/driver_memory_test.c
@@ -0,0 +1,90 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * Read into cold private mappings of a file on the SAME encrypted volume.
+ * With more workers than bounce buffers, faulting while holding a buffer
+ * can exhaust the pool and deadlock. Neither input is modified.
+ */
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <OS.h>
+
+#define WORKERS 16
+#define LENGTH 65536
+
+static sem_id sStart;
+static int sRaw;
+static int32 sFinished;
+static int32 sErrors;
+
+
+static void*
+read_worker(void* data)
+{
+	if (acquire_sem(sStart) != B_OK
+		|| pread(sRaw, data, LENGTH, 1048576) != LENGTH) {
+		atomic_add(&sErrors, 1);
+	}
+	atomic_add(&sFinished, 1);
+	return NULL;
+}
+
+
+int
+main(int argc, char** argv)
+{
+	if (argc != 3) {
+		fprintf(stderr, "usage: %s <cold file on volume> <unlocked device>\n",
+			argv[0]);
+		return 1;
+	}
+	int file = open(argv[1], O_RDONLY);
+	sRaw = open(argv[2], O_RDONLY);
+	struct stat st;
+	if (file < 0 || sRaw < 0 || fstat(file, &st) != 0
+		|| st.st_size < WORKERS * LENGTH) {
+		fprintf(stderr, "can't open inputs or source file is too small\n");
+		return 1;
+	}
+	sStart = create_sem(0, "luks2 memory test start");
+	if (sStart < B_OK)
+		return 1;
+	pthread_t threads[WORKERS];
+	void* mappings[WORKERS];
+	for (int i = 0; i < WORKERS; i++) {
+		mappings[i] = mmap(NULL, LENGTH, PROT_READ | PROT_WRITE, MAP_PRIVATE,
+			file, (off_t)i * LENGTH);
+		if (mappings[i] == MAP_FAILED
+			|| pthread_create(&threads[i], NULL, read_worker, mappings[i]) != 0) {
+			fprintf(stderr, "can't create mapping or worker %d\n", i);
+			return 1;
+		}
+	}
+	puts("LUKSMEM releasing concurrent reads into file mappings");
+	fflush(stdout);
+	if (release_sem_etc(sStart, WORKERS, 0) != B_OK)
+		return 1;
+	for (int i = 0; i < 200 && atomic_get(&sFinished) != WORKERS; i++)
+		snooze(100000);
+	printf("LUKSMEM finished %ld of %d, errors %ld\n",
+		(long)atomic_get(&sFinished), WORKERS, (long)atomic_get(&sErrors));
+	fflush(stdout);
+	// Exiting a process with blocked kernel I/O may itself hang. The QEMU
+	// runner also has a timeout and retains the serial log in that case.
+	if (atomic_get(&sFinished) != WORKERS)
+		return 2;
+	for (int i = 0; i < WORKERS; i++) {
+		pthread_join(threads[i], NULL);
+		munmap(mappings[i], LENGTH);
+	}
+	delete_sem(sStart);
+	close(sRaw);
+	close(file);
+	return atomic_get(&sErrors) == 0 ? 0 : 1;
+}
