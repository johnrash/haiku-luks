index 0000000..e01886c
--- /dev/null
+++ b/src/tests/system/luks2/qemu/guest-memory-test.sh
@@ -0,0 +1,32 @@
+#!/bin/sh
+# Copyright 2026, haiku-odroid-c2 port authors.
+# Distributed under the terms of the MIT License.
+# Only the isolated disk carrying our marker is formatted.
+set -eu
+T=/boot/system/settings/luks-memory-test
+exec > /dev/dprintf 2>&1
+trap 'echo "LUKSMEM FAIL"' EXIT
+sleep 10
+target=
+for raw in /dev/disk/nvme/*/raw; do
+	if [ "$(head -c 13 "$raw")" = LUKSMEM-BLANK ]; then
+		target=$raw
+	fi
+done
+[ -n "$target" ]
+luks format -y -k "$T/key" --pbkdf pbkdf2 --iterations 1000 "$target"
+dev=$(luks open -k "$T/key" "$target")
+mkfs -t bfs -q "$dev" LuksMemoryTest
+mkdir -p /LuksMemoryTest
+mount -t bfs "$dev" /LuksMemoryTest
+dd if=/dev/zero of=/LuksMemoryTest/payload bs=1048576 count=4
+sync
+# Dropping the filesystem and its cache is essential to cause page faults.
+unmount /LuksMemoryTest
+mount -t bfs "$dev" /LuksMemoryTest
+"$T/driver_memory_test" /LuksMemoryTest/payload "$dev"
+unmount /LuksMemoryTest
+luks close "$dev"
+trap - EXIT
+echo "LUKSMEM PASS"
+shutdown
