+/*!	Fault in and wire user buffers before taking the volume lock or a
+	bounce buffer. A fault can read this same volume (including its swap
+	file), and must not wait on resources held by the faulting operation.
+	Kernel I/O buffers are already resident; the page writer needs no new
+	allocation here. */
+class UserBufferLocker {
+public:
+	UserBufferLocker(void* buffer, size_t length, uint32 flags)
+		:
+		fBuffer(IS_USER_ADDRESS(buffer) ? buffer : NULL),
+		fLength(length),
+		fFlags(flags),
+		fStatus(fBuffer != NULL ? lock_memory(fBuffer, fLength, fFlags) : B_OK)
+	{
+	}
+
+	~UserBufferLocker()
+	{
+		if (fBuffer != NULL && fStatus == B_OK)
+			unlock_memory(fBuffer, fLength, fFlags);
+	}
+
+	status_t Status() const { return fStatus; }
+
+private:
+	void*		fBuffer;
+	size_t		fLength;
+	uint32		fFlags;
+	status_t	fStatus;
+};
