+qemu_pid = int(sys.argv[1])
+log_path, input_path, monitor_path, passphrase_path = sys.argv[2:6]
+options = sys.argv[6:]
 wrong_first = "--wrong-first" in options
 menu_steps = None
 if "--menu" in options:
@@ -55,6 +62,43 @@ def connect(path):
             time.sleep(0.2)
 
 
+class SerialFile:
+    """The serial port as QEMU's output file and input FIFO."""
+
+    def __init__(self, log_path, input_path, pid):
+        self.pid = pid
+        deadline = time.time() + 30
+        while not os.path.exists(log_path):
+            if time.time() > deadline or not self.qemu_running():
+                raise OSError("QEMU didn't create %s" % log_path)
+            time.sleep(0.1)
+        self.fd = os.open(log_path, os.O_RDONLY)
+        # the run script holds the FIFO open for reading, so this doesn't
+        # wait for QEMU
+        self.input = os.open(input_path, os.O_WRONLY)
+
+    def qemu_running(self):
+        try:
+            with open("/proc/%d/stat" % self.pid) as f:
+                return f.read().rsplit(")", 1)[1].split()[0] != "Z"
+        except (OSError, IndexError):
+            return False
+
+    def recv(self, wait):
+        """New output, b"" if none came within <wait> s, None once QEMU
+        has ended and everything is read."""
+        data = os.read(self.fd, 65536)
+        if data:
+            return data
+        if not self.qemu_running():
+            return os.read(self.fd, 65536) or None
+        time.sleep(wait)
+        return b""
+
+    def sendall(self, data):
+        os.write(self.input, data)
+
+
